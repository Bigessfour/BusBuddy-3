# Copy to ~/.config/utm-dev-bridge.env  (not required — defaults match this machine)
#   mkdir -p ~/.config
#   cp Scripts/utm-dev-bridge.env.example ~/.config/utm-dev-bridge.env

# VM_IP=192.168.64.2          # pin if utmctl is unavailable; leave empty to auto-detect
SSH_USER=Macbook
# Tilde is expanded by the bridge (quoted or not).
SSH_KEY=~/.ssh/busbuddy-utm
UTM_VM_NAME=Windows
# LOCAL_DIR is the BusBuddy-3 repo when you run Scripts/utm-dev-bridge.sh
REMOTE_DIR=/c/dev/BusBuddy-3
# No LocalForward by default (BusBuddy is WPF + Mac Docker Postgres, not a web stack).
# Opt-in example: FORWARD_PORTS=9222
FORWARD_PORTS=
# POLL_SECONDS=1.5
