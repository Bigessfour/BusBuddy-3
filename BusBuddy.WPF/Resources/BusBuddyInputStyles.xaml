<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:syncfusion="http://schemas.syncfusion.com/wpf">
    <!--
      BusBuddy form input alignment — merged app-wide after SyncfusionStyles.
      Keeps text vertically centered and typography consistent across SfTextBoxExt,
      ComboBoxAdv, SfMaskedEdit, and SfDatePicker.
    -->

    <Style TargetType="syncfusion:SfTextBoxExt" BasedOn="{StaticResource {x:Type syncfusion:SfTextBoxExt}}">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Height" Value="42"/>
        <Setter Property="MinHeight" Value="42"/>
        <Setter Property="Padding" Value="12,0,10,0"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="TextAlignment" Value="Left"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="Foreground" Value="{DynamicResource FormInputForegroundBrush}"/>
        <Setter Property="Background" Value="{DynamicResource FormInputBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource FormInputBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CaretBrush" Value="{DynamicResource BusBuddy.Brush.Text.Accent}"/>
    </Style>

    <Style TargetType="syncfusion:ComboBoxAdv" BasedOn="{StaticResource {x:Type syncfusion:ComboBoxAdv}}">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Height" Value="42"/>
        <Setter Property="MinHeight" Value="42"/>
        <Setter Property="Padding" Value="12,0,10,0"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="Foreground" Value="{DynamicResource FormInputForegroundBrush}"/>
        <Setter Property="Background" Value="{DynamicResource FormInputBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource FormInputBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="MaxDropDownHeight" Value="280"/>
        <Setter Property="AllowSelectAll" Value="False"/>
    </Style>

    <Style TargetType="syncfusion:SfMaskedEdit" BasedOn="{StaticResource {x:Type syncfusion:SfMaskedEdit}}">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Height" Value="42"/>
        <Setter Property="MinHeight" Value="42"/>
        <Setter Property="Padding" Value="12,0,10,0"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="TextAlignment" Value="Left"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="Foreground" Value="{DynamicResource FormInputForegroundBrush}"/>
        <Setter Property="Background" Value="{DynamicResource FormInputBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource FormInputBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CaretBrush" Value="{DynamicResource BusBuddy.Brush.Text.Accent}"/>
    </Style>

    <Style TargetType="syncfusion:SfDatePicker" BasedOn="{StaticResource {x:Type syncfusion:SfDatePicker}}">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Height" Value="42"/>
        <Setter Property="MinHeight" Value="42"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{DynamicResource FormInputForegroundBrush}"/>
        <Setter Property="Background" Value="{DynamicResource FormInputBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource FormInputBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FormatString" Value="MMM dd, yyyy"/>
        <Setter Property="SelectorFormatString" Value="M/d/yyyy"/>
        <Setter Property="DropDownHeight" Value="200"/>
        <Setter Property="AccentBrush" Value="{DynamicResource BusBuddy.Brush.Primary}"/>
    </Style>

    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="MinHeight" Value="42"/>
        <Setter Property="Padding" Value="12,0,10,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="TextAlignment" Value="Left"/>
        <Setter Property="CaretBrush" Value="{DynamicResource BusBuddy.Brush.Text.Accent}"/>
    </Style>
</ResourceDictionary>
