<UserControl x:Class="BusBuddy.WPF.Views.Route.RouteManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:models="clr-namespace:BusBuddy.Core.Models;assembly=BusBuddy.Core"
             xmlns:converters="clr-namespace:BusBuddy.WPF.Converters"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="1000">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BusBuddy.WPF;component/Resources/SyncfusionV30_Validated_ResourceDictionary.xaml"/>
                <ResourceDictionary Source="/BusBuddy.WPF;component/Resources/ButtonAdvTextOnly.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
            <converters:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
            <ObjectDataProvider x:Key="RouteSessionValues"
                                ObjectType="{x:Type models:RouteSession}"
                                MethodName="GetAll"/>
            <ObjectDataProvider x:Key="RouteTimeSlotValues"
                                MethodName="GetValues"
                                ObjectType="{x:Type sys:Enum}">
                <ObjectDataProvider.MethodParameters>
                    <x:Type TypeName="models:RouteTimeSlot" />
                </ObjectDataProvider.MethodParameters>
            </ObjectDataProvider>
            <Style x:Key="RouteToolbarButton" TargetType="syncfusion:ButtonAdv">
                <Setter Property="SizeMode" Value="Normal"/>
                <Setter Property="IconWidth" Value="0"/>
                <Setter Property="IconHeight" Value="0"/>
                <Setter Property="SmallIcon" Value="{x:Null}"/>
                <Setter Property="Padding" Value="12,8"/>
                <Setter Property="Margin" Value="0,0,8,6"/>
            </Style>

        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{DynamicResource PrimaryBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
    <Border Grid.Row="0" Background="{DynamicResource BusBuddy.Brush.Primary}"
                CornerRadius="5" Padding="15" Margin="10,10,10,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE1C4;" FontFamily="Segoe MDL2 Assets"
              FontSize="24" Foreground="{DynamicResource BusBuddy.Brush.Text.OnPrimary}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Text="Route Management &amp; Planning" FontSize="20" FontWeight="Bold"
              Foreground="{DynamicResource BusBuddy.Brush.Text.OnPrimary}" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Enhanced Toolbar -->
    <Border Grid.Row="1" Background="{DynamicResource BusBuddy.Brush.Panel.Header}"
                CornerRadius="3" Padding="10" Margin="10,10,10,0" MinHeight="88">
            <WrapPanel Orientation="Horizontal">
            <syncfusion:ButtonAdv Name="AddRouteButton" Label="Add Route"
                Style="{StaticResource RouteToolbarButton}"
                Command="{Binding AddRouteCommand}"
                SizeMode="Normal"
                CornerRadius="4"
                Background="{DynamicResource BusBuddy.Brush.Primary}"
                Foreground="{DynamicResource BusBuddy.Brush.Text.OnPrimary}"
                AutomationProperties.Name="Add Route"
                AutomationProperties.HelpText="Create a new bus route"/>
            <syncfusion:ButtonAdv Name="SaveRouteButton" Label="Save Grid Changes"
                Style="{StaticResource RouteToolbarButton}"
                Command="{Binding EditRouteCommand}"
                SizeMode="Normal"
                CornerRadius="4"
                Background="{DynamicResource AccentBackgroundBrush}"
                Foreground="{DynamicResource BusBuddy.Brush.Text.OnPrimary}"
                AutomationProperties.Name="Save grid changes"
                AutomationProperties.HelpText="Persist inline grid edits for the selected route. A session change republishes stop clocks."/>
            <syncfusion:ButtonAdv Name="CopyRouteButton" Label="Copy Route"
                Style="{StaticResource RouteToolbarButton}"
                Command="{Binding CopyRouteCommand}"
                SizeMode="Normal"
                CornerRadius="4"
                Background="{DynamicResource AccentBackgroundBrush}"
                Foreground="{DynamicResource BusBuddy.Brush.Text.OnPrimary}"
                AutomationProperties.Name="Copy Route"
                AutomationProperties.HelpText="Clone the selected route as an inactive draft and show it with retired routes"/>
            <syncfusion:ButtonAdv Name="DeleteRouteButton" Label="Retire Route"
                Style="{StaticResource RouteToolbarButton}"
                Command="{Binding DeleteRouteCommand}"
                SizeMode="Normal"
                CornerRadius="4"
                Background="{DynamicResource BusBuddy.Brush.Semantic.Error}"
                Foreground="{DynamicResource BusBuddy.Brush.Text.OnPrimary}"
                AutomationProperties.Name="Retire Route"
                AutomationProperties.HelpText="Retire the selected route. An empty unpublished draft is permanently deleted."/>
            <syncfusion:ButtonAdv Name="ManageRouteButton" Label="Manage Route"
                Style="{StaticResource RouteToolbarButton}"
                Command="{Binding OpenRouteAssignmentCommand}"
                SizeMode="Normal"
                CornerRadius="4"
                Background="{DynamicResource BusBuddy.Brush.Primary}"
                Foreground="{DynamicResource BusBuddy.Brush.Text.OnPrimary}"
                AutomationProperties.Name="Manage Route"
                AutomationProperties.HelpText="Open the full route assignment and stops editor"/>
            <syncfusion:ButtonAdv Name="GenerateScheduleButton" Label="Generate Schedule"
                            Style="{StaticResource RouteToolbarButton}"
                            Command="{Binding GenerateScheduleCommand}"
                SizeMode="Normal"
                CornerRadius="4"
                Background="{DynamicResource BusBuddy.Brush.FleetGreen}"
                Foreground="{DynamicResource BusBuddy.Brush.Text.OnPrimary}"
                AutomationProperties.Name="Generate Schedule"
                AutomationProperties.HelpText="Open the published stop schedule. Saves today's calendar row when a bus and driver are assigned."/>
            <syncfusion:ButtonAdv Name="GenerateRoutesButton" Label="Generate Routes"
                            Style="{StaticResource RouteToolbarButton}"
                            Command="{Binding GenerateRoutesCommand}"
                SizeMode="Normal"
                CornerRadius="4"
                Background="{DynamicResource BusBuddy.Brush.FleetGreen}"
                Foreground="{DynamicResource BusBuddy.Brush.Text.OnPrimary}"
                AutomationProperties.Name="Generate Routes"
                AutomationProperties.HelpText="Year-start routes for one school. A special-needs row does not choose that school. The status names the school."/>
            <syncfusion:ButtonAdv Name="GenerateTransferRoutesButton" Label="Transfer Routes"
                            Style="{StaticResource RouteToolbarButton}"
                            Command="{Binding GenerateTransferRoutesCommand}"
                SizeMode="Normal"
                CornerRadius="4"
                MinWidth="132"
                Background="{DynamicResource BusBuddy.Brush.SafetyOrange}"
                Foreground="{DynamicResource BusBuddy.Brush.Text.OnPrimary}"
                AutomationProperties.Name="Generate Transfer Routes"
                AutomationProperties.HelpText="Transfer drafts for one school. A special-needs row does not choose that school. The status names the school."/>
            <syncfusion:ButtonAdv Name="RefreshDrivePathButton" Label="Drive Path"
                            Style="{StaticResource RouteToolbarButton}"
                            Command="{Binding RefreshDrivePathCommand}"
                SizeMode="Normal"
                CornerRadius="4"
                Background="{DynamicResource BusBuddy.Brush.Semantic.Info}"
                Foreground="{DynamicResource BusBuddy.Brush.Text.OnPrimary}"
                AutomationProperties.Name="Refresh Drive Path"
                AutomationProperties.HelpText="Save the Google road path, then republish stop clocks. A missed morning bell keeps the stored times."/>
            <syncfusion:ButtonAdv Name="OptimizeStopOrderButton" Label="Optimize Order"
                            Style="{StaticResource RouteToolbarButton}"
                            Command="{Binding OptimizeStopOrderCommand}"
                SizeMode="Normal"
                CornerRadius="4"
                Background="{DynamicResource BusBuddy.Brush.Semantic.Info}"
                Foreground="{DynamicResource BusBuddy.Brush.Text.OnPrimary}"
                AutomationProperties.Name="Optimize stop order"
                AutomationProperties.HelpText="Reorder pickups with Google Route Optimization, then republish stop clocks. Start and end stay pinned."/>
            <syncfusion:ButtonAdv Name="ExportCsvButton" Label="Export CSV"
                            Style="{StaticResource RouteToolbarButton}"
                            Command="{Binding ExportCsvCommand}"
                            SizeMode="Normal"
                            CornerRadius="4"
                            Background="{DynamicResource BusBuddy.Brush.Semantic.Success}"
                            Foreground="{DynamicResource BusBuddy.Brush.Text.OnPrimary}"
                            AutomationProperties.Name="Export to CSV"
                            AutomationProperties.HelpText="Export the routes currently shown in the grid"/>
            <syncfusion:ButtonAdv Name="ExportReportButton" Label="Export Report"
                            Style="{StaticResource RouteToolbarButton}"
                            Command="{Binding ExportReportCommand}"
                            SizeMode="Normal"
                            CornerRadius="4"
                            Background="{DynamicResource BusBuddy.Brush.Semantic.Info}"
                            Foreground="{DynamicResource BusBuddy.Brush.Text.OnPrimary}"
                            AutomationProperties.Name="Export Report"
                            AutomationProperties.HelpText="Export the visible routes with riders, stops, and published clocks"/>
            <syncfusion:ButtonAdv Name="PrintScheduleButton" Label="Print Schedule"
                            Style="{StaticResource RouteToolbarButton}"
                            Command="{Binding PrintScheduleCommand}"
                            SizeMode="Normal"
                            CornerRadius="4"
                            Background="{DynamicResource BusBuddy.Brush.Primary}"
                            Foreground="{DynamicResource BusBuddy.Brush.Text.OnPrimary}"
                            AutomationProperties.Name="Print Schedule"
                            AutomationProperties.HelpText="Preview the published stop schedule for the selected route"/>
                    <syncfusion:ButtonAdv Name="RefreshButton" Label="Refresh"
                            Style="{StaticResource RouteToolbarButton}"
                            Command="{Binding RefreshCommand}"
                            IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBooleanConverter}}"
                            AutomationProperties.Name="Refresh Routes"
                            AutomationProperties.HelpText="Reload route data from database (status bar shows refresh time)"/>
                    <syncfusion:SfTextBoxExt Name="QuickSearchBox" Width="150" Margin="0,0,8,6"
                                              VerticalAlignment="Center"
                                              Text="{Binding QuickSearchText, UpdateSourceTrigger=PropertyChanged}"
                                              Watermark="Search routes..."
                                              AutomationProperties.Name="Quick Search Routes"
                                              AutomationProperties.HelpText="Type to search the grid by name, school, session, or description"/>
                    <CheckBox Content="Show retired routes"
                              Margin="0,0,8,6"
                              VerticalAlignment="Center"
                              IsChecked="{Binding ShowRetiredRoutes, Mode=TwoWay}"
                              AutomationProperties.Name="Show retired routes"
                              AutomationProperties.HelpText="Include inactive routes, including copied drafts"/>
            </WrapPanel>
        </Border>

        <!-- Routes Data Grid and Stops Panel -->
        <Grid Grid.Row="2" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

    <syncfusion:SfDataGrid Grid.Row="0"
                  Name="RoutesDataGrid"
                  ItemsSource="{Binding RoutesView}"
                              SelectedItem="{Binding SelectedRoute, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              AllowSorting="True"
                              AllowFiltering="True"
                              AllowGrouping="True"
                              AllowEditing="True"
                              EditTrigger="OnTap"
                              ShowGroupDropArea="True"
                              ShowRowHeader="True"
                              SelectionMode="Single"
                              GridLinesVisibility="Both"
                              HeaderLinesVisibility="Both"
                              ColumnSizer="Star"
                              Margin="0,0,0,10"
                              Background="{DynamicResource BusBuddy.Brush.DataGrid.Background}"
                              AutomationProperties.Name="Routes Data Grid"
                              AutomationProperties.HelpText="Grid displaying all routes with their assignments and schedule information">
            <syncfusion:SfDataGrid.Columns>
        <syncfusion:GridTextColumn MappingName="RouteName" HeaderText="Route Name" Width="150"/>
        <syncfusion:GridComboBoxColumn MappingName="Session"
                                             HeaderText="Session"
                                             Width="110"
                                             ItemsSource="{Binding Source={StaticResource RouteSessionValues}}"
                                             AllowEditing="True"/>
        <syncfusion:GridTextColumn MappingName="Description" HeaderText="Description" Width="200"/>
                <syncfusion:GridCheckBoxColumn MappingName="IsSpecialNeedsRoute" HeaderText="Special Needs" Width="110"/>
                <syncfusion:GridComboBoxColumn MappingName="School"
                                             HeaderText="School"
                                             Width="160"
                                             DisplayMemberPath="Name"
                                             SelectedValuePath="Name"
                                             ItemsSource="{Binding DataContext.AvailableSchools, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                             AllowEditing="True"/>
                <syncfusion:GridTextColumn MappingName="Path" HeaderText="Path" Width="200" AllowEditing="False"/>
                <syncfusion:GridComboBoxColumn MappingName="AMVehicleId"
                                             HeaderText="AM Bus"
                                             Width="120"
                                             DisplayMemberPath="BusNumber"
                                             SelectedValuePath="BusId"
                                             ItemsSource="{Binding DataContext.AvailableBuses, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                             AllowEditing="True"/>
                <syncfusion:GridComboBoxColumn MappingName="PMVehicleId"
                                             HeaderText="PM Bus"
                                             Width="120"
                                             DisplayMemberPath="BusNumber"
                                             SelectedValuePath="BusId"
                                             ItemsSource="{Binding DataContext.AvailableBuses, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                             AllowEditing="True"/>
                <syncfusion:GridComboBoxColumn MappingName="AMDriverId"
                                             HeaderText="AM Driver"
                                             Width="140"
                                             DisplayMemberPath="DriverName"
                                             SelectedValuePath="DriverId"
                                             ItemsSource="{Binding DataContext.AvailableDrivers, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                             AllowEditing="True"/>
                <syncfusion:GridComboBoxColumn MappingName="PMDriverId"
                                             HeaderText="PM Driver"
                                             Width="140"
                                             DisplayMemberPath="DriverName"
                                             SelectedValuePath="DriverId"
                                             ItemsSource="{Binding DataContext.AvailableDrivers, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                             AllowEditing="True"/>
        <syncfusion:GridDateTimeColumn MappingName="Date" HeaderText="Date" Width="120" AllowEditing="False" Pattern="ShortDate"/>
        <syncfusion:GridTextColumn MappingName="StudentCount" HeaderText="Students" Width="90" AllowEditing="False"/>
        <syncfusion:GridTextColumn MappingName="StopCount" HeaderText="Stops" Width="80" AllowEditing="False"/>
        <syncfusion:GridCheckBoxColumn MappingName="IsActive" HeaderText="Active" Width="80"/>
            </syncfusion:SfDataGrid.Columns>
        </syncfusion:SfDataGrid>

            <!-- Vehicle / driver assignment panel (hop 4 defaults) -->
            <Border Grid.Row="1" Background="{DynamicResource BusBuddy.Brush.Surface.Medium}" CornerRadius="3" Padding="10,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Bus:" VerticalAlignment="Center" Margin="0,0,8,0"
                               Foreground="{DynamicResource BusBuddy.Brush.Text.Secondary}"/>
                    <syncfusion:ComboBoxAdv Grid.Column="1"
                                            Name="AssignBusCombo"
                                            ItemsSource="{Binding AvailableBuses}"
                                            DisplayMemberPath="BusNumber"
                                            SelectedValuePath="BusId"
                                            SelectedValue="{Binding SelectedBusId, Mode=TwoWay}"
                                            IsEditable="False"
                                            MaxDropDownHeight="240"
                                            AutomationProperties.Name="Assign Bus Selector"
                                            AutomationProperties.HelpText="Select an active bus to assign to the selected route"/>
                    <TextBlock Grid.Column="2" Text="Driver:" VerticalAlignment="Center" Margin="12,0,8,0"
                               Foreground="{DynamicResource BusBuddy.Brush.Text.Secondary}"/>
                    <syncfusion:ComboBoxAdv Grid.Column="3"
                                            Name="AssignDriverCombo"
                                            ItemsSource="{Binding AvailableDrivers}"
                                            DisplayMemberPath="DriverName"
                                            SelectedValuePath="DriverId"
                                            SelectedValue="{Binding SelectedDriverId, Mode=TwoWay}"
                                            IsEditable="False"
                                            MaxDropDownHeight="240"
                                            AutomationProperties.Name="Assign Driver Selector"
                                            AutomationProperties.HelpText="Select a driver to assign to the selected route"/>
                    <TextBlock Grid.Column="4" Text="Slot:" VerticalAlignment="Center" Margin="12,0,8,0"
                               Foreground="{DynamicResource BusBuddy.Brush.Text.Secondary}"/>
                    <syncfusion:ComboBoxAdv Grid.Column="5"
                                            Name="AssignTimeSlotCombo"
                                            SelectedItem="{Binding SelectedTimeSlot, Mode=TwoWay}"
                                            ItemsSource="{Binding Source={StaticResource RouteTimeSlotValues}}"
                                            IsEditable="False"
                                            AutomationProperties.Name="Assign Time Slot"
                                            AutomationProperties.HelpText="AM, PM, or both. Both writes the morning and afternoon columns."/>
                    <syncfusion:ButtonAdv Grid.Column="6"
                                          Name="ApplyVehicleAssignmentButton"
                                          Label="Assign Bus"
                                          Style="{StaticResource RouteToolbarButton}"
                                          Command="{Binding AssignVehicleCommand}"
                                          Margin="12,0,0,0"
                                          Background="{DynamicResource BusBuddy.Brush.Semantic.Warning}"
                                          Foreground="{DynamicResource BusBuddy.Brush.Text.OnPrimary}"
                                          AutomationProperties.Name="Apply Vehicle Assignment"
                                          AutomationProperties.HelpText="Assign the selected bus for the chosen time slot"/>
                    <syncfusion:ButtonAdv Grid.Column="7"
                                          Name="ApplyDriverAssignmentButton"
                                          Label="Assign Driver"
                                          Style="{StaticResource RouteToolbarButton}"
                                          Command="{Binding AssignDriverCommand}"
                                          Margin="8,0,0,0"
                                          Background="{DynamicResource BusBuddy.Brush.Semantic.Warning}"
                                          Foreground="{DynamicResource BusBuddy.Brush.Text.OnPrimary}"
                                          AutomationProperties.Name="Apply Driver Assignment"
                                          AutomationProperties.HelpText="Assign the selected driver for the chosen time slot"/>
                    <TextBlock Grid.Column="8" VerticalAlignment="Center" Margin="12,0,0,0"
                               Foreground="{DynamicResource BusBuddy.Brush.Text.Secondary}"
                               TextWrapping="Wrap"
                               Text="Save Grid Changes writes the selected route. Assign Bus and Assign Driver use the slot you picked."/>
                </Grid>
            </Border>
        </Grid>

        <!-- Status Bar -->
    <Border Grid.Row="3" Background="{DynamicResource BusBuddy.Brush.Surface.Medium}" CornerRadius="3" Padding="10" Margin="10,0,10,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusMessage}"
                              VerticalAlignment="Center" Foreground="{DynamicResource BusBuddy.Brush.Text.Secondary}"/>
                    <TextBlock Text="Loading..."
                              Margin="12,0,0,0"
                              FontStyle="Italic"
                              Foreground="{DynamicResource BusBuddy.Brush.Primary}"
                              Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Total Routes: " Foreground="{DynamicResource BusBuddy.Brush.Text.Secondary}"/>
                    <TextBlock Text="{Binding TotalRoutes}" FontWeight="Bold" Foreground="{DynamicResource BusBuddy.Brush.Primary}" Margin="0,0,15,0"/>
                    <TextBlock Text="Shown: " Foreground="{DynamicResource BusBuddy.Brush.Text.Secondary}"/>
                    <TextBlock Text="{Binding VisibleRouteCount}" FontWeight="Bold" Foreground="{DynamicResource BusBuddy.Brush.Primary}" Margin="0,0,15,0"/>
                    <TextBlock Text="Active: " Foreground="{DynamicResource BusBuddy.Brush.Text.Secondary}"/>
                    <TextBlock Text="{Binding ActiveRoutes}" FontWeight="Bold" Foreground="{DynamicResource BusBuddy.Brush.Semantic.Success}" Margin="0,0,15,0"/>
                    <TextBlock Text="Students Assigned: " Foreground="{DynamicResource BusBuddy.Brush.Text.Secondary}"/>
                    <TextBlock Text="{Binding TotalAssignedStudents}" FontWeight="Bold" Foreground="{DynamicResource BusBuddy.Brush.Semantic.Info}"/>
                    <Separator Margin="10,0"/>
                    <TextBlock Text="Selected: " Foreground="{DynamicResource BusBuddy.Brush.Text.Secondary}"/>
                    <TextBlock Text="{Binding SelectedRoute.RouteName}" FontWeight="Bold" Foreground="{DynamicResource BusBuddy.Brush.Text.Primary}" Margin="0,0,10,0"/>
                    <TextBlock Text="Students: " Foreground="{DynamicResource BusBuddy.Brush.Text.Secondary}"/>
                    <TextBlock Text="{Binding SelectedRoute.StudentCount}" FontWeight="Bold" Foreground="{DynamicResource BusBuddy.Brush.Semantic.Info}" Margin="0,0,10,0"/>
                    <TextBlock Text="Stops: " Foreground="{DynamicResource BusBuddy.Brush.Text.Secondary}"/>
                    <TextBlock Text="{Binding SelectedRoute.StopCount}" FontWeight="Bold" Foreground="{DynamicResource BusBuddy.Brush.Primary}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
