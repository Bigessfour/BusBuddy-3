<UserControl x:Class="BusBuddy.WPF.Views.Route.RouteManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:models="clr-namespace:BusBuddy.Core.Models;assembly=BusBuddy.Core"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="1000">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BusBuddy.WPF;component/Resources/SyncfusionV30_Validated_ResourceDictionary.xaml"/>
                <ResourceDictionary Source="/BusBuddy.WPF;component/Resources/ButtonAdvTextOnly.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
            <ObjectDataProvider x:Key="RouteTimeSlotValues"
                                MethodName="GetValues"
                                ObjectType="{x:Type sys:Enum}">
                <ObjectDataProvider.MethodParameters>
                    <x:Type TypeName="models:RouteTimeSlot" />
                </ObjectDataProvider.MethodParameters>
            </ObjectDataProvider>
            <Style x:Key="RouteToolbarButton" TargetType="syncfusion:ButtonAdv">
                <Setter Property="SizeMode" Value="Normal"/>
                <Setter Property="IconWidth" Value="0"/>
                <Setter Property="IconHeight" Value="0"/>
                <Setter Property="SmallIcon" Value="{x:Null}"/>
                <Setter Property="Padding" Value="12,8"/>
                <Setter Property="Margin" Value="0,0,8,6"/>
            </Style>

        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{DynamicResource PrimaryBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
    <Border Grid.Row="0" Background="{DynamicResource BusBuddy.Brush.Primary}"
                CornerRadius="5" Padding="15" Margin="10,10,10,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE1C4;" FontFamily="Segoe MDL2 Assets"
              FontSize="24" Foreground="{DynamicResource BusBuddy.Brush.Text.OnPrimary}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Text="Route Management &amp; Planning" FontSize="20" FontWeight="Bold"
              Foreground="{DynamicResource BusBuddy.Brush.Text.OnPrimary}" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Enhanced Toolbar -->
    <Border Grid.Row="1" Background="{DynamicResource BusBuddy.Brush.Panel.Header}"
                CornerRadius="3" Padding="10" Margin="10,10,10,0" MinHeight="88">
            <WrapPanel Orientation="Horizontal">
            <syncfusion:ButtonAdv Name="AddRouteButton" Label="Add Route"
                Style="{StaticResource RouteToolbarButton}"
                Command="{Binding AddRouteCommand}"
                SizeMode="Normal"
                CornerRadius="4"
                Background="{DynamicResource BusBuddy.Brush.Primary}"
                Foreground="{DynamicResource BusBuddy.Brush.Text.OnPrimary}"
                AutomationProperties.Name="Add Route"
                AutomationProperties.HelpText="Create a new bus route"/>
            <syncfusion:ButtonAdv Name="EditRouteButton" Label="Edit Route"
                Style="{StaticResource RouteToolbarButton}"
                Command="{Binding EditRouteCommand}"
                SizeMode="Normal"
                CornerRadius="4"
                Background="{DynamicResource AccentBackgroundBrush}"
                Foreground="{DynamicResource BusBuddy.Brush.Text.OnPrimary}"
                AutomationProperties.Name="Edit Route"
                AutomationProperties.HelpText="Save name, school, special-needs flag, and bus number for the selected route"/>
            <syncfusion:ButtonAdv Name="CopyRouteButton" Label="Copy Route"
                Style="{StaticResource RouteToolbarButton}"
                Command="{Binding CopyRouteCommand}"
                SizeMode="Normal"
                CornerRadius="4"
                Background="{DynamicResource AccentBackgroundBrush}"
                Foreground="{DynamicResource BusBuddy.Brush.Text.OnPrimary}"
                AutomationProperties.Name="Copy Route"
                AutomationProperties.HelpText="Clone the selected route"/>
            <syncfusion:ButtonAdv Name="DeleteRouteButton" Label="Delete Route"
                Style="{StaticResource RouteToolbarButton}"
                Command="{Binding DeleteRouteCommand}"
                SizeMode="Normal"
                CornerRadius="4"
                Background="{DynamicResource BusBuddy.Brush.Semantic.Error}"
                Foreground="{DynamicResource BusBuddy.Brush.Text.OnPrimary}"
                AutomationProperties.Name="Delete Route"
                AutomationProperties.HelpText="Delete the selected route"/>
            <syncfusion:ButtonAdv Name="ManageRouteButton" Label="Manage Route"
                Style="{StaticResource RouteToolbarButton}"
                Command="{Binding OpenRouteAssignmentCommand}"
                SizeMode="Normal"
                CornerRadius="4"
                Background="{DynamicResource BusBuddy.Brush.Primary}"
                Foreground="{DynamicResource BusBuddy.Brush.Text.OnPrimary}"
                AutomationProperties.Name="Manage Route"
                AutomationProperties.HelpText="Open the full route assignment and stops editor"/>
            <syncfusion:ButtonAdv Name="GenerateScheduleButton" Label="Generate Schedule"
                            Style="{StaticResource RouteToolbarButton}"
                            Command="{Binding GenerateScheduleCommand}"
                SizeMode="Normal"
                CornerRadius="4"
                Background="{DynamicResource BusBuddy.Brush.FleetGreen}"
                Foreground="{DynamicResource BusBuddy.Brush.Text.OnPrimary}"
                AutomationProperties.Name="Generate Schedule"
                AutomationProperties.HelpText="Create a calendar schedule and printable PDF for the selected route"/>
            <syncfusion:ButtonAdv Name="GenerateRoutesButton" Label="Generate Routes"
                            Style="{StaticResource RouteToolbarButton}"
                            Command="{Binding GenerateRoutesCommand}"
                SizeMode="Normal"
                CornerRadius="4"
                Background="{DynamicResource BusBuddy.Brush.FleetGreen}"
                Foreground="{DynamicResource BusBuddy.Brush.Text.OnPrimary}"
                AutomationProperties.Name="Generate Routes"
                AutomationProperties.HelpText="Year-start auto route build for school destinations"/>
            <syncfusion:ButtonAdv Name="GenerateTransferRoutesButton" Label="Transfer Routes"
                            Style="{StaticResource RouteToolbarButton}"
                            Command="{Binding GenerateTransferRoutesCommand}"
                SizeMode="Normal"
                CornerRadius="4"
                MinWidth="132"
                Background="{DynamicResource BusBuddy.Brush.SafetyOrange}"
                Foreground="{DynamicResource BusBuddy.Brush.Text.OnPrimary}"
                AutomationProperties.Name="Generate Transfer Routes"
                AutomationProperties.HelpText="Generate separate transfer fleet drafts"/>
            <syncfusion:ButtonAdv Name="RefreshDrivePathButton" Label="Drive Path"
                            Style="{StaticResource RouteToolbarButton}"
                            Command="{Binding RefreshDrivePathCommand}"
                SizeMode="Normal"
                CornerRadius="4"
                Background="{DynamicResource BusBuddy.Brush.Semantic.Info}"
                Foreground="{DynamicResource BusBuddy.Brush.Text.OnPrimary}"
                AutomationProperties.Name="Refresh Drive Path"
                AutomationProperties.HelpText="Compute road polyline via Google Routes API for the selected route"/>
            <syncfusion:ButtonAdv Name="ExportCsvButton" Label="Export CSV"
                            Style="{StaticResource RouteToolbarButton}"
                            Command="{Binding ExportCsvCommand}"
                            SizeMode="Normal"
                            CornerRadius="4"
                            Background="{DynamicResource BusBuddy.Brush.Semantic.Success}"
                            Foreground="{DynamicResource BusBuddy.Brush.Text.OnPrimary}"
                            AutomationProperties.Name="Export to CSV"
                            AutomationProperties.HelpText="Export route data to CSV file"/>
            <syncfusion:ButtonAdv Name="ExportReportButton" Label="Export Report"
                            Style="{StaticResource RouteToolbarButton}"
                            Command="{Binding ExportReportCommand}"
                            SizeMode="Normal"
                            CornerRadius="4"
                            Background="{DynamicResource BusBuddy.Brush.Semantic.Info}"
                            Foreground="{DynamicResource BusBuddy.Brush.Text.OnPrimary}"
                            AutomationProperties.Name="Export Report"
                            AutomationProperties.HelpText="Export detailed route report"/>
            <syncfusion:ButtonAdv Name="PrintScheduleButton" Label="Print Schedule"
                            Style="{StaticResource RouteToolbarButton}"
                            Command="{Binding PrintScheduleCommand}"
                            SizeMode="Normal"
                            CornerRadius="4"
                            Background="{DynamicResource BusBuddy.Brush.Primary}"
                            Foreground="{DynamicResource BusBuddy.Brush.Text.OnPrimary}"
                            AutomationProperties.Name="Print Schedule"
                            AutomationProperties.HelpText="Print route schedules"/>
                    <syncfusion:ButtonAdv Name="RefreshButton" Label="Refresh"
                            Style="{StaticResource RouteToolbarButton}"
                            Command="{Binding RefreshCommand}"
                            AutomationProperties.Name="Refresh Routes"
                            AutomationProperties.HelpText="Reload route data from database"/>
                    <syncfusion:SfTextBoxExt Name="QuickSearchBox" Width="150" Margin="0,0,8,6"
                                              VerticalAlignment="Center"
                                              Text="{Binding QuickSearchText, UpdateSourceTrigger=PropertyChanged}"
                                              Watermark="Search routes..."
                                              AutomationProperties.Name="Quick Search Routes"
                                              AutomationProperties.HelpText="Type to search routes by name or description"/>
            </WrapPanel>
        </Border>

        <!-- Routes Data Grid and Stops Panel -->
        <Grid Grid.Row="2" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

    <syncfusion:SfDataGrid Grid.Row="0"
                  Name="RoutesDataGrid"
                  ItemsSource="{Binding RoutesView}"
                              SelectedItem="{Binding SelectedRoute, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              AllowSorting="True"
                              AllowFiltering="True"
                              AllowGrouping="True"
                              AllowEditing="True"
                              EditTrigger="OnTap"
                              ShowGroupDropArea="True"
                              ShowRowHeader="True"
                              SelectionMode="Single"
                              GridLinesVisibility="Both"
                              HeaderLinesVisibility="Both"
                              ColumnSizer="Star"
                              Margin="0,0,0,10"
                              Background="{DynamicResource BusBuddy.Brush.DataGrid.Background}"
                              MouseDoubleClick="RoutesDataGrid_MouseDoubleClick"
                              CurrentCellEndEdit="RoutesDataGrid_CurrentCellEndEdit"
                              AutomationProperties.Name="Routes Data Grid"
                              AutomationProperties.HelpText="Grid displaying all routes with their assignments and schedule information">
            <syncfusion:SfDataGrid.Columns>
        <syncfusion:GridTextColumn MappingName="RouteName" HeaderText="Route Name" Width="150"/>
        <syncfusion:GridTextColumn MappingName="Description" HeaderText="Description" Width="200"/>
                <syncfusion:GridCheckBoxColumn MappingName="IsSpecialNeedsRoute" HeaderText="Special Needs" Width="110"/>
                <syncfusion:GridComboBoxColumn MappingName="School"
                                             HeaderText="School"
                                             Width="160"
                                             DisplayMemberPath="Name"
                                             SelectedValuePath="Name"
                                             ItemsSource="{Binding AvailableSchools}"
                                             AllowEditing="True"/>
                <syncfusion:GridTextColumn MappingName="Path" HeaderText="Path" Width="200" AllowEditing="False"/>
                <syncfusion:GridComboBoxColumn MappingName="BusNumber"
                                             HeaderText="Bus Number"
                                             Width="120"
                                             DisplayMemberPath="BusNumber"
                                             SelectedValuePath="BusNumber"
                                             ItemsSource="{Binding AvailableBuses}"
                                             AllowEditing="True"/>
        <syncfusion:GridDateTimeColumn MappingName="Date" HeaderText="Date" Width="120" AllowEditing="False" DisplayBinding="{Binding Date, StringFormat=MM/dd/yyyy}"/>
        <syncfusion:GridTextColumn MappingName="StudentCount" HeaderText="Students" Width="90" AllowEditing="False"/>
        <syncfusion:GridTextColumn MappingName="StopCount" HeaderText="Stops" Width="80" AllowEditing="False"/>
        <syncfusion:GridCheckBoxColumn MappingName="IsActive" HeaderText="Active" Width="80"/>
            </syncfusion:SfDataGrid.Columns>
        </syncfusion:SfDataGrid>

            <!-- Vehicle assignment panel -->
            <Border Grid.Row="1" Background="{DynamicResource BusBuddy.Brush.Surface.Medium}" CornerRadius="3" Padding="10,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Assign bus:" VerticalAlignment="Center" Margin="0,0,8,0"
                               Foreground="{DynamicResource BusBuddy.Brush.Text.Secondary}"/>
                    <syncfusion:ComboBoxAdv Grid.Column="1"
                                            Name="AssignBusCombo"
                                            ItemsSource="{Binding AvailableBuses}"
                                            DisplayMemberPath="BusNumber"
                                            SelectedValuePath="BusId"
                                            SelectedValue="{Binding SelectedBusId, Mode=TwoWay}"
                                            IsEditable="False"
                                            MaxDropDownHeight="240"
                                            AutomationProperties.Name="Assign Bus Selector"
                                            AutomationProperties.HelpText="Select an active bus to assign to the selected route"/>
                    <TextBlock Grid.Column="2" Text="Time slot:" VerticalAlignment="Center" Margin="16,0,8,0"
                               Foreground="{DynamicResource BusBuddy.Brush.Text.Secondary}"/>
                    <syncfusion:ComboBoxAdv Grid.Column="3"
                                            Name="AssignTimeSlotCombo"
                                            SelectedItem="{Binding SelectedTimeSlot, Mode=TwoWay}"
                                            ItemsSource="{Binding Source={StaticResource RouteTimeSlotValues}}"
                                            AutomationProperties.Name="Assign Time Slot"
                                            AutomationProperties.HelpText="AM, PM, or both for vehicle assignment"/>
                    <syncfusion:ButtonAdv Grid.Column="4"
                                          Name="ApplyVehicleAssignmentButton"
                                          Label="Apply Assignment"
                                          Style="{StaticResource RouteToolbarButton}"
                                          Command="{Binding AssignVehicleCommand}"
                                          Margin="12,0,0,0"
                                          Background="{DynamicResource BusBuddy.Brush.Semantic.Warning}"
                                          Foreground="{DynamicResource BusBuddy.Brush.Text.OnPrimary}"
                                          AutomationProperties.Name="Apply Vehicle Assignment"
                                          AutomationProperties.HelpText="Assign the selected bus to the selected route for the chosen time slot"/>
                    <TextBlock Grid.Column="5" VerticalAlignment="Center" Margin="16,0,0,0"
                               Foreground="{DynamicResource BusBuddy.Brush.Text.Secondary}"
                               TextWrapping="Wrap"
                               Text="Select a route in the grid, pick a bus and time slot, then click Apply Assignment or use the toolbar button."/>
                </Grid>
            </Border>
        </Grid>

        <!-- Status Bar -->
    <Border Grid.Row="3" Background="{DynamicResource BusBuddy.Brush.Surface.Medium}" CornerRadius="3" Padding="10" Margin="10,0,10,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusMessage}"
                              VerticalAlignment="Center" Foreground="{DynamicResource BusBuddy.Brush.Text.Secondary}"/>
                    <TextBlock Text="Loading..."
                              Margin="12,0,0,0"
                              FontStyle="Italic"
                              Foreground="{DynamicResource BusBuddy.Brush.Primary}"
                              Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Total Routes: " Foreground="{DynamicResource BusBuddy.Brush.Text.Secondary}"/>
                    <TextBlock Text="{Binding TotalRoutes}" FontWeight="Bold" Foreground="{DynamicResource BusBuddy.Brush.Primary}" Margin="0,0,15,0"/>
                    <TextBlock Text="Active: " Foreground="{DynamicResource BusBuddy.Brush.Text.Secondary}"/>
                    <TextBlock Text="{Binding ActiveRoutes}" FontWeight="Bold" Foreground="{DynamicResource BusBuddy.Brush.Semantic.Success}" Margin="0,0,15,0"/>
                    <TextBlock Text="Students Assigned: " Foreground="{DynamicResource BusBuddy.Brush.Text.Secondary}"/>
                    <TextBlock Text="{Binding TotalAssignedStudents}" FontWeight="Bold" Foreground="{DynamicResource BusBuddy.Brush.Semantic.Info}"/>
                    <Separator Margin="10,0"/>
                    <TextBlock Text="Selected: " Foreground="{DynamicResource BusBuddy.Brush.Text.Secondary}"/>
                    <TextBlock Text="{Binding SelectedRoute.RouteName}" FontWeight="Bold" Foreground="{DynamicResource BusBuddy.Brush.Text.Primary}" Margin="0,0,10,0"/>
                    <TextBlock Text="Students: " Foreground="{DynamicResource BusBuddy.Brush.Text.Secondary}"/>
                    <TextBlock Text="{Binding SelectedRoute.StudentCount}" FontWeight="Bold" Foreground="{DynamicResource BusBuddy.Brush.Semantic.Info}" Margin="0,0,10,0"/>
                    <TextBlock Text="Stops: " Foreground="{DynamicResource BusBuddy.Brush.Text.Secondary}"/>
                    <TextBlock Text="{Binding SelectedRoute.StopCount}" FontWeight="Bold" Foreground="{DynamicResource BusBuddy.Brush.Primary}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
