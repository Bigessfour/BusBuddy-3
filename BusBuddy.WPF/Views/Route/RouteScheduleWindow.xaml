<syncfusion:ChromelessWindow x:Class="BusBuddy.WPF.Views.Route.RouteScheduleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
        Title="Route Schedule"
        Height="720"
        Width="980"
        MinHeight="520"
        MinWidth="760"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        AutomationProperties.Name="Route Schedule">
    <syncfusion:ChromelessWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BusBuddy.WPF;component/Resources/SyncfusionV30_Validated_ResourceDictionary.xaml"/>
                <ResourceDictionary Source="/BusBuddy.WPF;component/Resources/ButtonAdvTextOnly.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        </ResourceDictionary>
    </syncfusion:ChromelessWindow.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource BusBuddy.Brush.Primary}"
                CornerRadius="5"
                Padding="14"
                Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="{Binding Sheet.DisplayName}"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="{DynamicResource BusBuddy.Brush.Text.OnPrimary}"/>
                <TextBlock Text="{Binding Sheet.Title}"
                           Margin="0,4,0,0"
                           Foreground="{DynamicResource BusBuddy.Brush.Text.OnPrimary}"
                           Opacity="0.9"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,8,8"
                       Text="{Binding Sheet.SessionLabel, StringFormat=Session: {0}}"/>
            <TextBlock Grid.Row="0" Grid.Column="1" Margin="0,0,8,8"
                       Text="{Binding Sheet.ServiceDate, StringFormat=Date: {0}}"/>
            <TextBlock Grid.Row="0" Grid.Column="2" Margin="0,0,8,8"
                       Text="{Binding Sheet.School, StringFormat=School: {0}}"/>
            <TextBlock Grid.Row="0" Grid.Column="3" Margin="0,0,0,8"
                       Text="{Binding Sheet.RosterCount, StringFormat=Roster: {0}}"/>
            <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,8,8"
                       Text="{Binding Sheet.BusLabel}"/>
            <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,0,8,8"
                       Text="{Binding Sheet.DriverLabel, StringFormat=Driver: {0}}"/>
            <TextBlock Grid.Row="1" Grid.Column="2" Margin="0,0,8,8"
                       Text="{Binding FirstLastClockText}"/>
            <TextBlock Grid.Row="1" Grid.Column="3"
                       Text="{Binding Sheet.TotalMilesText, StringFormat=Miles: {0}}"/>
        </Grid>

        <TextBlock Grid.Row="2"
                   Margin="0,0,0,8"
                   Text="{Binding Sheet.GenerateStopsOnlyNote}"
                   TextWrapping="Wrap"
                   Visibility="{Binding HasGenerateStopsOnlyNote, Converter={StaticResource BooleanToVisibilityConverter}}"/>

        <DockPanel Grid.Row="3" LastChildFill="True" Margin="0,0,0,12">
            <TextBlock DockPanel.Dock="Top" FontWeight="Bold" Margin="0,0,0,6" Text="Stops"/>
            <syncfusion:SfDataGrid ItemsSource="{Binding Sheet.Stops}"
                                   AutoGenerateColumns="False"
                                   AllowEditing="False"
                                   AllowFiltering="False"
                                   AllowSorting="False"
                                   SelectionMode="Single"
                                   GridLinesVisibility="Both"
                                   AutomationProperties.Name="Route schedule stops">
                <syncfusion:SfDataGrid.Columns>
                    <syncfusion:GridTextColumn HeaderText="#" MappingName="Sequence" Width="40"/>
                    <syncfusion:GridTextColumn HeaderText="Student / stop" MappingName="Name" Width="200"/>
                    <syncfusion:GridTextColumn HeaderText="Address" MappingName="Address" Width="200"/>
                    <syncfusion:GridTextColumn HeaderText="Arrive" MappingName="Arrival" Width="70"/>
                    <syncfusion:GridTextColumn HeaderText="Depart" MappingName="Departure" Width="70"/>
                    <syncfusion:GridTextColumn HeaderText="Leg mi" MappingName="Miles" Width="70"/>
                    <syncfusion:GridTextColumn HeaderText="Cum mi" MappingName="Cumulative" Width="70"/>
                    <syncfusion:GridTextColumn HeaderText="Riders" MappingName="Riders" Width="70"/>
                </syncfusion:SfDataGrid.Columns>
            </syncfusion:SfDataGrid>
        </DockPanel>

        <DockPanel Grid.Row="4" LastChildFill="True" Margin="0,0,0,12">
            <TextBlock DockPanel.Dock="Top" FontWeight="Bold" Margin="0,0,0,6" Text="Roster"/>
            <syncfusion:SfDataGrid ItemsSource="{Binding Sheet.Students}"
                                   AutoGenerateColumns="False"
                                   AllowEditing="False"
                                   AllowFiltering="False"
                                   AllowSorting="False"
                                   SelectionMode="Single"
                                   GridLinesVisibility="Both"
                                   AutomationProperties.Name="Route schedule roster">
                <syncfusion:SfDataGrid.Columns>
                    <syncfusion:GridTextColumn HeaderText="Student" MappingName="Name" Width="220"/>
                    <syncfusion:GridTextColumn HeaderText="Grade" MappingName="Grade" Width="70"/>
                    <syncfusion:GridTextColumn HeaderText="Matched stop" MappingName="Stop" Width="220"/>
                    <syncfusion:GridTextColumn HeaderText="Today" MappingName="Status" Width="140"/>
                </syncfusion:SfDataGrid.Columns>
            </syncfusion:SfDataGrid>
        </DockPanel>

        <DockPanel Grid.Row="5" LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <syncfusion:ButtonAdv Label="Re-time"
                                      MinWidth="90"
                                      Height="40"
                                      Margin="0,0,8,0"
                                      Command="{Binding ReTimeCommand}"
                                      AutomationProperties.Name="Re-time route schedule"/>
                <syncfusion:ButtonAdv Label="Print"
                                      MinWidth="90"
                                      Height="40"
                                      Margin="0,0,8,0"
                                      Command="{Binding PrintCommand}"
                                      AutomationProperties.Name="Print route schedule"/>
                <syncfusion:ButtonAdv Label="Close"
                                      MinWidth="90"
                                      Height="40"
                                      Command="{Binding CloseCommand}"
                                      AutomationProperties.Name="Close route schedule"/>
            </StackPanel>
            <TextBlock Text="{Binding StatusMessage}"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"/>
        </DockPanel>
    </Grid>
</syncfusion:ChromelessWindow>
