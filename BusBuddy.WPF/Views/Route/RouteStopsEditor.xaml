<!-- RouteStopsEditor.xaml - Reusable route stops editor
     Syncfusion WPF 34.x (SfDataGrid, ButtonAdv, SfMaskedEdit)
     ButtonAdv uses Label with plain text — emoji often renders blank under Fluent themes. -->
<UserControl x:Class="BusBuddy.WPF.Views.Route.RouteStopsEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
             mc:Ignorable="d"
             d:DesignHeight="400" d:DesignWidth="600"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BusBuddy.WPF;component/Resources/SyncfusionV30_Validated_ResourceDictionary.xaml" />
                <ResourceDictionary Source="/BusBuddy.WPF;component/Resources/ButtonAdvTextOnly.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <WrapPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
            <syncfusion:ButtonAdv Label="Add Stop"
                                   Command="{Binding AddStopCommand}"
                                   SizeMode="Normal"
                                   CornerRadius="3"
                                   Padding="10,5" Margin="0,0,8,4"
                                   AutomationProperties.Name="Add Stop" ToolTip="Add a new stop" />
            <syncfusion:ButtonAdv Label="Remove"
                                   Command="{Binding RemoveStopCommand}"
                                   SizeMode="Normal"
                                   CornerRadius="3"
                                   Background="{DynamicResource BusBuddy.Brush.Semantic.Error}"
                                   Foreground="{DynamicResource BusBuddy.Brush.Text.OnPrimary}"
                                   Padding="10,5" Margin="0,0,8,4"
                                   AutomationProperties.Name="Remove Stop" ToolTip="Remove selected stop" />
            <syncfusion:ButtonAdv Label="Up"
                                   Command="{Binding MoveStopUpCommand}"
                                   SizeMode="Normal"
                                   CornerRadius="3"
                                   Padding="10,5" Margin="0,0,8,4"
                                   AutomationProperties.Name="Move Stop Up" ToolTip="Move selected stop up" />
            <syncfusion:ButtonAdv Label="Down"
                                   Command="{Binding MoveStopDownCommand}"
                                   SizeMode="Normal"
                                   CornerRadius="3"
                                   Padding="10,5" Margin="0,0,8,4"
                                   AutomationProperties.Name="Move Stop Down" ToolTip="Move selected stop down" />
            <syncfusion:ButtonAdv Label="Time Route"
                                   Command="{Binding TimeRouteCommand}"
                                   SizeMode="Normal"
                                   CornerRadius="3"
                                   Padding="10,5" Margin="0,0,0,4"
                                   AutomationProperties.Name="Time Route Stops" ToolTip="Recalculate arrival and departure times" />
        </WrapPanel>
    <syncfusion:SfDataGrid Grid.Row="1"
                   ItemsSource="{Binding RouteStops}"
                   SelectedItem="{Binding SelectedRouteStop, Mode=TwoWay}"
                   AutoGenerateColumns="False"
                   AllowSorting="True"
                   AllowFiltering="True"
                   AllowGrouping="False"
                   ShowGroupDropArea="False"
                   AllowResizingColumns="True"
                   SelectionMode="Single"
                   GridLinesVisibility="Both"
                   HeaderLinesVisibility="Both"
                   ColumnSizer="Star"
                   HorizontalAlignment="Stretch"
                   VerticalAlignment="Stretch"
                   Background="{DynamicResource BusBuddy.Brush.DataGrid.Background}"
                   AutomationProperties.Name="Route Stops Grid"
                   AutomationProperties.HelpText="Grid listing route stops with timing information">
            <syncfusion:SfDataGrid.Columns>
                <syncfusion:GridNumericColumn HeaderText="#" MappingName="StopOrder" MinimumWidth="48" MaximumWidth="64" />
                <syncfusion:GridTextColumn HeaderText="Stop Name" MappingName="StopName" MinimumWidth="140" />
                <syncfusion:GridTextColumn HeaderText="Arrive" MappingName="PublishedArrivalText" MinimumWidth="72" />
                <syncfusion:GridTextColumn HeaderText="Depart" MappingName="PublishedDepartureText" MinimumWidth="72" />
                <syncfusion:GridNumericColumn HeaderText="Dwell (min)" MappingName="StopDuration" MinimumWidth="88" />
            </syncfusion:SfDataGrid.Columns>
        </syncfusion:SfDataGrid>
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,6,0,0">
            <TextBlock Text="Stops:" FontWeight="SemiBold" Foreground="{DynamicResource BusBuddy.Brush.Text.Primary}" />
            <TextBlock Text="{Binding RouteStopCount}" Margin="4,0,12,0" Foreground="{DynamicResource BusBuddy.Brush.Text.Secondary}" />
            <TextBlock Text="Selected:" FontWeight="SemiBold" Foreground="{DynamicResource BusBuddy.Brush.Text.Primary}" />
            <TextBlock Text="{Binding SelectedRouteStop.StopName}" Margin="4,0,0,0" Foreground="{DynamicResource BusBuddy.Brush.Text.Secondary}" />
        </StackPanel>
    </Grid>
</UserControl>
