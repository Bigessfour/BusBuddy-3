<UserControl x:Class="BusBuddy.WPF.Views.Route.RouteAssignmentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
             xmlns:views="clr-namespace:BusBuddy.WPF.Views.Route"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:models="clr-namespace:BusBuddy.Core.Models;assembly=BusBuddy.Core"
             mc:Ignorable="d"
             d:DesignHeight="800"
             d:DesignWidth="1200"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BusBuddy.WPF;component/Resources/SyncfusionV30_Validated_ResourceDictionary.xaml" />
                <ResourceDictionary Source="/BusBuddy.WPF;component/Resources/ButtonAdvTextOnly.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <ObjectDataProvider x:Key="RouteTimeSlotValues"
                                MethodName="GetValues"
                                ObjectType="{x:Type sys:Enum}">
                <ObjectDataProvider.MethodParameters>
                    <x:Type TypeName="models:RouteTimeSlot" />
                </ObjectDataProvider.MethodParameters>
            </ObjectDataProvider>
            <Style x:Key="PrimaryButtonAdv"
                   TargetType="syncfusion:ButtonAdv">
                <Setter Property="Padding" Value="12,6" />
                <Setter Property="Margin" Value="0,0,8,6" />
                <Setter Property="MinHeight" Value="36" />
                <Setter Property="SizeMode" Value="Normal" />
                <Setter Property="IconWidth" Value="0" />
                <Setter Property="IconHeight" Value="0" />
                <Setter Property="SmallIcon" Value="{x:Null}" />
            </Style>
            <Style x:Key="SuccessButtonAdv"
                   TargetType="syncfusion:ButtonAdv"
                   BasedOn="{StaticResource PrimaryButtonAdv}">
                <Setter Property="Background" Value="{DynamicResource BusBuddy.Brush.Semantic.Success}" />
                <Setter Property="Foreground" Value="{DynamicResource BusBuddy.Brush.Text.OnPrimary}" />
            </Style>
            <Style x:Key="WarningButtonAdv"
                   TargetType="syncfusion:ButtonAdv"
                   BasedOn="{StaticResource PrimaryButtonAdv}">
                <Setter Property="Background" Value="{DynamicResource BusBuddy.Brush.Semantic.Warning}" />
                <Setter Property="Foreground" Value="{DynamicResource PrimaryBackgroundBrush}" />
            </Style>
            <Style x:Key="DangerButtonAdv"
                   TargetType="syncfusion:ButtonAdv"
                   BasedOn="{StaticResource PrimaryButtonAdv}">
                <Setter Property="Background" Value="{DynamicResource BusBuddy.Brush.Semantic.Danger}" />
                <Setter Property="Foreground" Value="{DynamicResource BusBuddy.Brush.Text.OnPrimary}" />
            </Style>
            <Style x:Key="InfoButtonAdv"
                   TargetType="syncfusion:ButtonAdv"
                   BasedOn="{StaticResource PrimaryButtonAdv}"/>
            <Style x:Key="RouteToolbarCaption"
                   TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource BusBuddy.Brush.Text.Secondary}" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="0,0,10,0" />
                <Setter Property="MinWidth" Value="52" />
            </Style>
            <Style x:Key="RoutePickerStack"
                   TargetType="StackPanel">
                <Setter Property="Margin" Value="0,0,10,0" />
                <Setter Property="VerticalAlignment" Value="Bottom" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Margin="12"
          ToolTipService.ShowOnDisabled="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border x:Name="ServiceErrorBanner"
                Grid.Row="0"
                Visibility="Collapsed"
                Background="{DynamicResource BusBuddy.Brush.Semantic.Error}"
                CornerRadius="6"
                Padding="12"
                Margin="0,0,0,8">
            <TextBlock x:Name="ServiceErrorText"
                       Text="Route service unavailable — route assignment is disabled."
                       Foreground="{DynamicResource BusBuddy.Brush.Text.OnPrimary}"
                       FontWeight="Bold"
                       TextWrapping="Wrap"
                       AutomationProperties.Name="Route Assignment Service Error" />
        </Border>
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid MinHeight="680">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" MinHeight="220" />
                    <RowDefinition Height="Auto" MinHeight="200" />
                </Grid.RowDefinitions>
        <Border Grid.Row="0"
                Background="{DynamicResource BusBuddy.Brush.Primary}"
                CornerRadius="6"
                Padding="10,8"
                Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="&#xE90F;"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="20"
                           Margin="0,0,8,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource BusBuddy.Brush.Text.OnPrimary}" />
                <TextBlock Text="Route Assignment"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="{DynamicResource BusBuddy.Brush.Text.OnPrimary}"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Border>
        <Border x:Name="RouteConfigurationBar"
                Grid.Row="2"
                Background="{DynamicResource BusBuddy.Brush.Surface.Medium}"
                CornerRadius="6"
                Padding="10,8"
                Margin="0,0,0,8">
            <StackPanel>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" MinWidth="200" />
                        <ColumnDefinition Width="*" MinWidth="112" />
                        <ColumnDefinition Width="Auto" MinWidth="96" />
                        <ColumnDefinition Width="*" MinWidth="88" />
                        <ColumnDefinition Width="*" MinWidth="120" />
                        <ColumnDefinition Width="Auto" MinWidth="88" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Style="{StaticResource RoutePickerStack}">
                        <TextBlock Text="Route" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <syncfusion:ComboBoxAdv x:Name="RoutePicker"
                                                MinWidth="200"
                                                HorizontalAlignment="Stretch"
                                                ItemsSource="{Binding AvailableRoutes}"
                                                DisplayMemberPath="RouteName"
                                                SelectedItem="{Binding SelectedRoute, Mode=TwoWay}"
                                                IsEditable="False"
                                                MaxDropDownHeight="240"
                                                AutomationProperties.Name="Route Selector"
                                                ToolTip="Select a route to manage" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Style="{StaticResource RoutePickerStack}">
                        <TextBlock Text="Date" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <syncfusion:SfDatePicker x:Name="RouteDatePicker"
                                                 HorizontalAlignment="Stretch"
                                                 Value="{Binding SelectedRoute.Date, Mode=TwoWay}"
                                                 AutomationProperties.Name="Route Date" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Style="{StaticResource RoutePickerStack}">
                        <TextBlock Text="Time Slot" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <syncfusion:ComboBoxAdv x:Name="TimeSlotCombo"
                                                MinWidth="88"
                                                HorizontalAlignment="Stretch"
                                                SelectedItem="{Binding SelectedTimeSlot, Mode=TwoWay}"
                                                ItemsSource="{Binding Source={StaticResource RouteTimeSlotValues}}"
                                                IsEditable="False"
                                                AutomationProperties.Name="Route Time Slot" />
                    </StackPanel>
                    <StackPanel Grid.Column="3" Style="{StaticResource RoutePickerStack}">
                        <TextBlock Text="Bus" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <syncfusion:ComboBoxAdv x:Name="BusCombo"
                                                HorizontalAlignment="Stretch"
                                                ItemsSource="{Binding AvailableBuses}"
                                                DisplayMemberPath="BusNumber"
                                                SelectedItem="{Binding SelectedBus, Mode=TwoWay}"
                                                IsEditable="False"
                                                MaxDropDownHeight="240"
                                                AutomationProperties.Name="Bus Selector"
                                                AutomationProperties.HelpText="Select a bus for the route" />
                    </StackPanel>
                    <StackPanel Grid.Column="4" Style="{StaticResource RoutePickerStack}">
                        <TextBlock Text="Driver" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <syncfusion:ComboBoxAdv x:Name="DriverCombo"
                                                HorizontalAlignment="Stretch"
                                                ItemsSource="{Binding AvailableDrivers}"
                                                DisplayMemberPath="DriverName"
                                                SelectedItem="{Binding SelectedDriver, Mode=TwoWay}"
                                                IsEditable="False"
                                                MaxDropDownHeight="240"
                                                AutomationProperties.Name="Driver Selector"
                                                AutomationProperties.HelpText="Select a driver for the route" />
                    </StackPanel>
                    <StackPanel Grid.Column="5" Orientation="Vertical">
                        <TextBlock Text="Start" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <syncfusion:SfMaskedEdit x:Name="StartTimeInput"
                                                 Width="80"
                                                 HorizontalAlignment="Left"
                                                 Text="{Binding StartTimeString, Mode=TwoWay}"
                                                 AutomationProperties.Name="Route Start Time" />
                    </StackPanel>
                </Grid>
                <DockPanel LastChildFill="True" Margin="0,0,0,2">
                    <TextBlock DockPanel.Dock="Left"
                               Text="Fleet"
                               Style="{StaticResource RouteToolbarCaption}" />
                    <WrapPanel Orientation="Horizontal">
                        <syncfusion:ButtonAdv x:Name="AssignBusButton"
                                              Label="Assign Bus"
                                              Command="{Binding AssignVehicleCommand}"
                                              Style="{StaticResource WarningButtonAdv}"
                                              AutomationProperties.Name="Assign Bus to Route"
                                              ToolTip="Assign the selected bus to the route for the chosen time slot" />
                        <syncfusion:ButtonAdv x:Name="AssignDriverButton"
                                              Label="Assign Driver"
                                              Command="{Binding AssignDriverCommand}"
                                              Style="{StaticResource WarningButtonAdv}"
                                              AutomationProperties.Name="Assign Driver to Route"
                                              ToolTip="Assign the selected driver to the route for the chosen time slot" />
                    </WrapPanel>
                </DockPanel>
                <DockPanel LastChildFill="True" Margin="0,0,0,2">
                    <TextBlock DockPanel.Dock="Left"
                               Text="Route"
                               Style="{StaticResource RouteToolbarCaption}" />
                    <WrapPanel Orientation="Horizontal">
                        <syncfusion:ButtonAdv x:Name="RefreshDataButton"
                                              Label="Refresh"
                                              Command="{Binding RefreshDataCommand}"
                                              Style="{StaticResource InfoButtonAdv}"
                                              AutomationProperties.Name="Refresh Route Data"
                                              ToolTip="Reload routes, buses, drivers, and student assignments" />
                        <syncfusion:ButtonAdv x:Name="SaveButton"
                                              Label="Save"
                                              Command="{Binding SaveRouteCommand}"
                                              Style="{StaticResource PrimaryButtonAdv}"
                                              AutomationProperties.Name="Save Route"
                                              ToolTip="Save route and assignments" />
                        <syncfusion:ButtonAdv x:Name="ActivateButton"
                                              Label="Activate"
                                              Command="{Binding ActivateRouteCommand}"
                                              Style="{StaticResource SuccessButtonAdv}"
                                              AutomationProperties.Name="Activate Route"
                                              ToolTip="Activate selected route" />
                        <syncfusion:ButtonAdv x:Name="DeactivateButton"
                                              Label="Deactivate"
                                              Command="{Binding DeactivateRouteCommand}"
                                              Style="{StaticResource WarningButtonAdv}"
                                              AutomationProperties.Name="Deactivate Route"
                                              ToolTip="Deactivate selected route" />
                        <syncfusion:ButtonAdv x:Name="DeleteButton"
                                              Label="Delete"
                                              Command="{Binding DeleteRouteCommand}"
                                              Style="{StaticResource DangerButtonAdv}"
                                              AutomationProperties.Name="Delete Route"
                                              ToolTip="Delete selected route" />
                        <syncfusion:ButtonAdv x:Name="GenerateRoutesButton"
                                              Label="Generate Routes"
                                              Command="{Binding GenerateRoutesCommand}"
                                              Style="{StaticResource SuccessButtonAdv}"
                                              AutomationProperties.Name="Generate Routes"
                                              ToolTip="Year-start auto route build for school destinations" />
                        <syncfusion:ButtonAdv x:Name="GenerateTransferRoutesButton"
                                              Label="Transfer Routes"
                                              Command="{Binding GenerateTransferRoutesCommand}"
                                              Style="{StaticResource WarningButtonAdv}"
                                              AutomationProperties.Name="Generate Transfer Routes"
                                              ToolTip="Generate separate transfer fleet drafts" />
                        <syncfusion:ButtonAdv x:Name="AutoAssignButton"
                                              Label="Auto-Assign"
                                              Command="{Binding AutoAssignCommand}"
                                              Style="{StaticResource SuccessButtonAdv}"
                                              AutomationProperties.Name="Auto Assign Students"
                                              ToolTip="Assign unassigned students up to route capacity for the selected time slot" />
                    </WrapPanel>
                </DockPanel>
                <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Left"
                               Text="Publish"
                               Style="{StaticResource RouteToolbarCaption}" />
                    <WrapPanel Orientation="Horizontal">
                        <syncfusion:ButtonAdv x:Name="TimeButton"
                                              Label="Time"
                                              Command="{Binding TimeRouteCommand}"
                                              Style="{StaticResource InfoButtonAdv}"
                                              AutomationProperties.Name="Time Route"
                                              ToolTip="{Binding TimeRouteToolTip}" />
                        <syncfusion:ButtonAdv x:Name="ScheduleButton"
                                              Label="Schedule"
                                              Command="{Binding ViewScheduleCommand}"
                                              Style="{StaticResource InfoButtonAdv}"
                                              AutomationProperties.Name="View Schedule"
                                              ToolTip="{Binding ViewScheduleToolTip}" />
                        <syncfusion:ButtonAdv x:Name="PlotButton"
                                              Label="Plot"
                                              Command="{Binding PlotRouteOnMapCommand}"
                                              Style="{StaticResource InfoButtonAdv}"
                                              AutomationProperties.Name="Plot Route on Map"
                                              ToolTip="{Binding PlotRouteToolTip}" />
                        <syncfusion:ButtonAdv x:Name="DrivePathButton"
                                              Label="Drive Path"
                                              Command="{Binding RefreshDrivePathCommand}"
                                              Style="{StaticResource InfoButtonAdv}"
                                              AutomationProperties.Name="Refresh Drive Path"
                                              ToolTip="{Binding DrivePathToolTip}" />
                        <syncfusion:ButtonAdv x:Name="PrintMapButton"
                                              Label="Print Map"
                                              Command="{Binding PrintRouteSheetCommand}"
                                              Style="{StaticResource PrimaryButtonAdv}"
                                              AutomationProperties.Name="Print Route Map"
                                              ToolTip="Export the PdfGrid route sheet with the current map snapshot" />
                        <syncfusion:ButtonAdv x:Name="ReportButton"
                                              Label="Report"
                                              Command="{Binding ExportRouteSheetCommand}"
                                              Style="{StaticResource InfoButtonAdv}"
                                              AutomationProperties.Name="Generate Route Assignment Report"
                                              ToolTip="Export the PdfGrid route sheet (stops + roster)" />
                    </WrapPanel>
                </DockPanel>
            </StackPanel>
        </Border>
        <Grid Grid.Row="2" MinHeight="180">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="160" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="160" />
            </Grid.ColumnDefinitions>
            <GroupBox Grid.Column="0"
                      Header="Unassigned Students"
                      Margin="0,0,8,0"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      Padding="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <syncfusion:SfTextBoxExt x:Name="UnassignedSearchBox"
                                             Grid.Row="0"
                                             Margin="0,0,0,6"
                                             HorizontalAlignment="Stretch"
                                             Watermark="Search unassigned students..."
                                             Text="{Binding StudentSearchText, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="Unassigned Student Search"
                                             ToolTip="Search unassigned students" />
                    <syncfusion:SfDataGrid Grid.Row="1"
                                           x:Name="UnassignedStudentsGrid"
                                           ItemsSource="{Binding UnassignedStudents}"
                                           SelectedItem="{Binding SelectedStudent, Mode=TwoWay}"
                                           AutoGenerateColumns="False"
                                           AllowSorting="True"
                                           AllowFiltering="True"
                                           AllowGrouping="False"
                                           ShowGroupDropArea="False"
                                           AllowResizingColumns="True"
                                           SelectionMode="Single"
                                           GridLinesVisibility="Both"
                                           HeaderLinesVisibility="Both"
                                           ColumnSizer="Star"
                                           HorizontalAlignment="Stretch"
                                           VerticalAlignment="Stretch"
                                           AllowDrop="True"
                                           PreviewMouseLeftButtonDown="UnassignedGrid_PreviewMouseLeftButtonDown"
                                           PreviewMouseMove="Grid_PreviewMouseMove"
                                           DragOver="UnassignedGrid_DragOver"
                                           Drop="UnassignedGrid_Drop"
                                           DragEnter="UnassignedGrid_DragEnter"
                                           DragLeave="UnassignedGrid_DragLeave"
                                           AutomationProperties.Name="Unassigned Students Grid"
                                           AutomationProperties.HelpText="Students not yet assigned to the selected route">
                        <syncfusion:SfDataGrid.Columns>
                            <syncfusion:GridTextColumn HeaderText="Name"
                                                       MappingName="StudentName"
                                                       MinimumWidth="120" />
                            <syncfusion:GridTextColumn HeaderText="Grade"
                                                       MappingName="Grade"
                                                       MinimumWidth="56"
                                                       MaximumWidth="80" />
                            <syncfusion:GridTextColumn HeaderText="Address"
                                                       MappingName="HomeAddress"
                                                       MinimumWidth="140" />
                            <syncfusion:GridTextColumn HeaderText="City"
                                                       MappingName="City"
                                                       MinimumWidth="80" />
                        </syncfusion:SfDataGrid.Columns>
                    </syncfusion:SfDataGrid>
                    <TextBlock Grid.Row="2"
                               Margin="0,4,0,0"
                               Text="{Binding UnassignedStudentCount, StringFormat=Unassigned: {0}}" />
                </Grid>
            </GroupBox>
            <StackPanel Grid.Column="1"
                        VerticalAlignment="Center"
                        MinWidth="132"
                        Margin="0,0,8,0">
                <syncfusion:ButtonAdv x:Name="AssignButton"
                                      Label="Assign"
                                      Command="{Binding AssignStudentCommand}"
                                      Style="{StaticResource PrimaryButtonAdv}"
                                      Margin="0,0,0,8"
                                      HorizontalAlignment="Stretch"
                                      AutomationProperties.Name="Assign Student"
                                      ToolTip="{Binding AssignStudentToolTip}" />
                <syncfusion:ButtonAdv x:Name="RemoveButton"
                                      Label="Remove"
                                      Command="{Binding RemoveStudentCommand}"
                                      Style="{StaticResource PrimaryButtonAdv}"
                                      Margin="0,0,0,8"
                                      HorizontalAlignment="Stretch"
                                      AutomationProperties.Name="Remove Student"
                                      ToolTip="{Binding RemoveStudentToolTip}" />
                <syncfusion:ButtonAdv x:Name="NotRidingTodayButton"
                                      Label="Not riding today"
                                      Command="{Binding MarkNotRidingTodayCommand}"
                                      Style="{StaticResource PrimaryButtonAdv}"
                                      Margin="0"
                                      HorizontalAlignment="Stretch"
                                      AutomationProperties.Name="Not riding today"
                                      ToolTip="{Binding NotRidingTodayToolTip}" />
            </StackPanel>
            <GroupBox Grid.Column="2"
                      Header="Assigned to Route"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      Padding="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <syncfusion:SfDataGrid Grid.Row="0"
                                           x:Name="AssignedStudentsGrid"
                                           ItemsSource="{Binding AssignedStudentsForSelectedRoute}"
                                           SelectedItem="{Binding SelectedAssignedStudent, Mode=TwoWay}"
                                           AutoGenerateColumns="False"
                                           AllowSorting="True"
                                           AllowFiltering="True"
                                           AllowGrouping="False"
                                           ShowGroupDropArea="False"
                                           AllowResizingColumns="True"
                                           SelectionMode="Single"
                                           GridLinesVisibility="Both"
                                           HeaderLinesVisibility="Both"
                                           ColumnSizer="Star"
                                           HorizontalAlignment="Stretch"
                                           VerticalAlignment="Stretch"
                                           AllowDrop="True"
                                           PreviewMouseLeftButtonDown="AssignedGrid_PreviewMouseLeftButtonDown"
                                           PreviewMouseMove="Grid_PreviewMouseMove"
                                           DragOver="AssignedGrid_DragOver"
                                           Drop="AssignedGrid_Drop"
                                           DragEnter="AssignedGrid_DragEnter"
                                           DragLeave="AssignedGrid_DragLeave"
                                           AutomationProperties.Name="Assigned Students Grid"
                                           AutomationProperties.HelpText="Students assigned to the selected route">
                        <syncfusion:SfDataGrid.Columns>
                            <syncfusion:GridTextColumn HeaderText="Name"
                                                       MappingName="StudentName"
                                                       MinimumWidth="120" />
                            <syncfusion:GridTextColumn HeaderText="Grade"
                                                       MappingName="Grade"
                                                       MinimumWidth="56"
                                                       MaximumWidth="80" />
                            <syncfusion:GridTextColumn HeaderText="Address"
                                                       MappingName="HomeAddress"
                                                       MinimumWidth="140" />
                            <syncfusion:GridTextColumn HeaderText="City"
                                                       MappingName="City"
                                                       MinimumWidth="80" />
                        </syncfusion:SfDataGrid.Columns>
                    </syncfusion:SfDataGrid>
                    <TextBlock Grid.Row="1"
                               Margin="0,4,0,0"
                               Text="{Binding AssignedStudentCount, StringFormat=Assigned: {0}}" />
                </Grid>
            </GroupBox>
        </Grid>
        <GroupBox Grid.Row="3"
                  Header="Route Stops"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  Padding="6"
                  MinHeight="200">
            <views:RouteStopsEditor HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    MinHeight="180" />
        </GroupBox>
            </Grid>
        </ScrollViewer>
        <Border Grid.Row="2"
                Margin="0,8,0,0"
                Background="{DynamicResource BusBuddy.Brush.Surface.Medium}"
                CornerRadius="6"
                Padding="10,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusMessage}"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource BusBuddy.Brush.Text.Secondary}"/>
                    <TextBlock Text="Loading..."
                               Margin="12,0,0,0"
                               FontStyle="Italic"
                               Foreground="{DynamicResource BusBuddy.Brush.Primary}"
                               Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Assigned bus: " Foreground="{DynamicResource BusBuddy.Brush.Text.Secondary}"/>
                    <TextBlock Text="{Binding SelectedRouteBusDisplay}" FontWeight="SemiBold"
                               Foreground="{DynamicResource BusBuddy.Brush.Text.Primary}" Margin="0,0,16,0"/>
                    <TextBlock Text="Driver: " Foreground="{DynamicResource BusBuddy.Brush.Text.Secondary}"/>
                    <TextBlock Text="{Binding SelectedRouteDriverDisplay}" FontWeight="SemiBold"
                               Foreground="{DynamicResource BusBuddy.Brush.Text.Primary}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
