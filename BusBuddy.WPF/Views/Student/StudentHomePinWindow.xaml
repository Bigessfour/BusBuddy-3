<syncfusion:ChromelessWindow x:Class="BusBuddy.WPF.Views.Student.StudentHomePinWindow"
                             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                             xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
                             xmlns:utils="clr-namespace:BusBuddy.WPF.Utilities"
                             Title="Adjust home pickup pin"
                             Height="640"
                             Width="820"
                             MinHeight="480"
                             MinWidth="640"
                             WindowStartupLocation="CenterOwner"
                             ResizeMode="CanResize"
                             UseNativeChrome="False"
                             AutomationProperties.Name="Adjust home pickup pin">
    <syncfusion:ChromelessWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BusBuddy.WPF;component/Resources/SyncfusionV30_Validated_ResourceDictionary.xaml"/>
                <ResourceDictionary Source="/BusBuddy.WPF;component/Resources/ButtonAdvTextOnly.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </syncfusion:ChromelessWindow.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   TextWrapping="Wrap"
                   Margin="0,0,0,10"
                   Text="Gold is Google's validated street address. Blue is the actual pickup (driveway or gate). Click the map to move the blue pin. The street address on the student form does not change."/>

        <Border Grid.Row="1"
                BorderBrush="{DynamicResource BusBuddy.Brush.Surface.Border}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="4">
            <Grid>
                <utils:DistrictSfMap x:Name="HomePickMap"
                            ZoomLevel="{Binding MapZoomLevel}"
                            EnableZoom="True"
                            EnablePan="True"
                            MouseLeftButtonUp="HomePickMap_MouseLeftButtonUp"
                            AutomationProperties.Name="Home pickup location map">
                    <utils:DistrictSfMap.Layers>
                        <utils:GoogleMapTilesImageryLayer x:Name="HomePickLayer"
                                           LayerType="Bing"
                                           Center="{Binding MapCenter}"/>
                    </utils:DistrictSfMap.Layers>
                </utils:DistrictSfMap>
                <Border x:Name="HomePickAttribution"
                        Background="{DynamicResource BusBuddy.Brush.Panel.Header}"
                        Opacity="0.92"
                        CornerRadius="4"
                        Padding="8,4"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Margin="0,0,8,8"
                        Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image x:Name="HomePickGoogleLogo"
                               Source="/BusBuddy.WPF;component/Assets/Maps/google_maps_on_non_white.png"
                               Height="16"
                               Stretch="Uniform"
                               Margin="0,0,8,0"
                               Visibility="Collapsed"
                               SnapsToDevicePixels="True"
                               AutomationProperties.Name="Google Maps"/>
                        <TextBlock x:Name="HomePickAttributionText"
                                   Text="Map tiles unavailable"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource BusBuddy.Brush.Text.Secondary}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <TextBlock Grid.Row="2"
                   Text="{Binding MapHint}"
                   TextWrapping="Wrap"
                   Margin="0,10,0,8"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <syncfusion:ButtonAdv Label="Cancel"
                                  Command="{Binding CancelCommand}"
                                  SizeMode="Normal" IconWidth="0" IconHeight="0" SmallIcon="{x:Null}"
                                  Margin="0,0,10,0"
                                  AutomationProperties.Name="Cancel home pin"/>
            <syncfusion:ButtonAdv Label="Use this pin"
                                  Command="{Binding ConfirmCommand}"
                                  SizeMode="Normal" IconWidth="0" IconHeight="0" SmallIcon="{x:Null}"
                                  IsDefault="True"
                                  Background="{DynamicResource BusBuddy.Brush.Primary}"
                                  Foreground="{DynamicResource BusBuddy.Brush.Text.OnPrimary}"
                                  AutomationProperties.Name="Use this home pin"/>
        </StackPanel>
    </Grid>
</syncfusion:ChromelessWindow>
