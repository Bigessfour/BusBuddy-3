<syncfusion:ChromelessWindow x:Class="BusBuddy.WPF.Views.Student.PickupStopForm"
                             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                             xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
                             xmlns:maps="clr-namespace:Syncfusion.UI.Xaml.Maps;assembly=Syncfusion.SfMaps.WPF"
                             Title="{Binding Title}"
                             Height="680"
                             Width="900"
                             MinHeight="520"
                             MinWidth="700"
                             WindowStartupLocation="CenterOwner"
                             ResizeMode="CanResize"
                             UseNativeChrome="False"
                             PreviewKeyDown="PickupStopForm_PreviewKeyDown">
    <syncfusion:ChromelessWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BusBuddy.WPF;component/Resources/SyncfusionV30_Validated_ResourceDictionary.xaml"/>
                <ResourceDictionary Source="/BusBuddy.WPF;component/Resources/ButtonAdvTextOnly.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </syncfusion:ChromelessWindow.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource BusBuddy.Brush.Primary}"
                CornerRadius="5"
                Padding="12,10"
                Margin="0,0,0,12">
            <TextBlock Text="Add pickup stop — shared corner or block stop for multiple students"
                       FontSize="16"
                       FontWeight="Bold"
                       Foreground="{DynamicResource BusBuddy.Brush.Text.OnPrimary}"
                       TextWrapping="Wrap"/>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" MinWidth="280"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*" MinWidth="300"/>
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Focusable="False">
                <StackPanel>
                    <TextBlock Text="Stop name *" Margin="0,0,0,4"/>
                    <syncfusion:SfTextBoxExt x:Name="StopNameBox"
                                             AutoCompleteMode="None"
                                             ShowClearButton="True"
                                             Watermark="Oak &amp; 4th"
                                             Height="40" Margin="0,0,0,10"
                                             AutomationProperties.Name="Pickup stop name"/>

                    <TextBlock Text="Street / landmark (optional)" Margin="0,0,0,4"/>
                    <syncfusion:SfTextBoxExt x:Name="StopAddressBox"
                                             AutoCompleteMode="None"
                                             ShowClearButton="True"
                                             Watermark="NE corner Oak &amp; 4th"
                                             Height="40" Margin="0,0,0,10"
                                             AutomationProperties.Name="Pickup stop address"/>

                    <TextBlock Text="Stop type" Margin="0,0,0,4"/>
                    <syncfusion:ComboBoxAdv x:Name="StopTypeCombo"
                                          ItemsSource="{Binding StopTypeOptions}"
                                          SelectedItem="{Binding SelectedStopType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          IsEditable="False"
                                          Height="40" Margin="0,0,0,10"
                                          AutomationProperties.Name="Pickup stop type"/>

                    <TextBlock Text="Notes (optional)" Margin="0,0,0,4"/>
                    <syncfusion:SfTextBoxExt x:Name="StopNotesBox"
                                             AutoCompleteMode="None"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             Height="60" Margin="0,0,0,10"
                                             AutomationProperties.Name="Pickup stop notes"/>

                    <TextBlock Text="Latitude / longitude *" Margin="0,4,0,4" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding MapHint}" TextWrapping="Wrap" Margin="0,0,0,6"
                               Foreground="{DynamicResource BusBuddy.Brush.Text.Secondary}"/>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <syncfusion:DoubleTextBox x:Name="StopLatBox"
                                                  Grid.Column="0"
                                                  NumberDecimalDigits="6"
                                                  MinValue="-90"
                                                  MaxValue="90"
                                                  Height="40"
                                                  AutomationProperties.Name="Pickup stop latitude"/>
                        <syncfusion:DoubleTextBox x:Name="StopLonBox"
                                                  Grid.Column="2"
                                                  NumberDecimalDigits="6"
                                                  MinValue="-180"
                                                  MaxValue="180"
                                                  Height="40"
                                                  AutomationProperties.Name="Pickup stop longitude"/>
                    </Grid>
                    <syncfusion:ButtonAdv Label="Clear map pin"
                                          Command="{Binding ClearMapPickCommand}"
                                          SizeMode="Normal" IconWidth="0" IconHeight="0" SmallIcon="{x:Null}"
                                          HorizontalAlignment="Left"
                                          AutomationProperties.Name="Clear pickup stop map pin"/>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Column="2"
                    BorderBrush="{DynamicResource BusBuddy.Brush.Surface.Border}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Margin="4,2,4,6" TextWrapping="Wrap"
                               Text="Click map to place the shared stop. Students near this pin can be assigned here."/>
                    <maps:SfMap x:Name="StopPickMap"
                                Grid.Row="1"
                                ZoomLevel="{Binding MapZoomLevel}"
                                EnableZoom="True"
                                EnablePan="True"
                                MouseLeftButtonUp="StopPickMap_MouseLeftButtonUp"
                                AutomationProperties.Name="Pickup stop location map">
                        <maps:SfMap.Layers>
                            <maps:ImageryLayer x:Name="StopPickLayer"
                                               LayerType="OSM"
                                               Center="{Binding MapCenter}"
                                               Markers="{Binding MapMarkers}"/>
                        </maps:SfMap.Layers>
                    </maps:SfMap>
                </Grid>
            </Border>
        </Grid>

        <TextBlock Grid.Row="2" Text="{Binding ValidationMessage}"
                   Foreground="{DynamicResource BusBuddy.Brush.Semantic.Danger}"
                   TextWrapping="Wrap" Margin="0,10,0,8" MinHeight="20"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <syncfusion:ButtonAdv Label="Cancel" Command="{Binding CancelCommand}"
                                  SizeMode="Normal" IconWidth="0" IconHeight="0" SmallIcon="{x:Null}"
                                  Margin="0,0,10,0"/>
            <syncfusion:ButtonAdv x:Name="SaveStopButton"
                                  Label="Save pickup stop"
                                  Click="SaveStopButton_Click"
                                  SizeMode="Normal" IconWidth="0" IconHeight="0" SmallIcon="{x:Null}"
                                  IsDefault="True"
                                  Background="{DynamicResource BusBuddy.Brush.Primary}"
                                  Foreground="{DynamicResource BusBuddy.Brush.Text.OnPrimary}"/>
        </StackPanel>
    </Grid>
</syncfusion:ChromelessWindow>
