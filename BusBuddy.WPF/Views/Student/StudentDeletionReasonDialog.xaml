<syncfusion:ChromelessWindow x:Class="BusBuddy.WPF.Views.Student.StudentDeletionReasonDialog"
                             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                             xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
                             Title="Delete student"
                             Height="360"
                             Width="480"
                             WindowStartupLocation="CenterOwner"
                             ResizeMode="NoResize">
    <syncfusion:ChromelessWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BusBuddy.WPF;component/Resources/SyncfusionV30_Validated_ResourceDictionary.xaml"/>
                <ResourceDictionary Source="/BusBuddy.WPF;component/Resources/ButtonAdvTextOnly.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </syncfusion:ChromelessWindow.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource BusBuddy.Brush.Primary}"
                CornerRadius="5"
                Padding="15"
                Margin="0,0,0,15">
            <TextBlock Text="Delete student"
                       FontSize="16"
                       FontWeight="Bold"
                       Foreground="{DynamicResource BusBuddy.Brush.Text.OnPrimary}"/>
        </Border>

        <StackPanel Grid.Row="1">
            <TextBlock Text="{Binding Prompt}" TextWrapping="Wrap" Margin="0,0,0,10"/>
            <TextBlock Text="{Binding Warning}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,12"
                       Foreground="{DynamicResource BusBuddy.Brush.Semantic.Warning}"/>

            <TextBlock Text="Reason *" Margin="0,0,0,4"/>
            <syncfusion:ComboBoxAdv ItemsSource="{Binding Reasons}"
                                    SelectedItem="{Binding SelectedReason, Mode=TwoWay}"
                                    DisplayMemberPath="Label"
                                    IsEditable="False"
                                    Height="40"
                                    Margin="0,0,0,12"
                                    AutomationProperties.Name="Deletion reason"
                                    AutomationProperties.HelpText="Mistake, Moved, or Not attending"/>

            <TextBlock Text="Brief note (optional)" Margin="0,0,0,4"/>
            <syncfusion:SfTextBoxExt Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                                     Watermark="Optional extra detail"
                                     Height="40"
                                     AutomationProperties.Name="Deletion note"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <syncfusion:ButtonAdv Label="Cancel"
                                  Command="{Binding CancelCommand}"
                                  Margin="0,0,10,0"
                                  AutomationProperties.Name="Cancel delete student"/>
            <syncfusion:ButtonAdv Label="Delete"
                                  Command="{Binding ConfirmCommand}"
                                  Background="{DynamicResource BusBuddy.Brush.Semantic.Danger}"
                                  Foreground="{DynamicResource BusBuddy.Brush.Text.OnPrimary}"
                                  AutomationProperties.Name="Confirm delete student"/>
        </StackPanel>
    </Grid>
</syncfusion:ChromelessWindow>
