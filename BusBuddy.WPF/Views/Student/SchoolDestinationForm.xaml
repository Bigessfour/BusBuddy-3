<syncfusion:ChromelessWindow x:Class="BusBuddy.WPF.Views.Student.SchoolDestinationForm"
                             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                             xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
                             Title="{Binding Title}"
                             Height="640"
                             Width="520"
                             WindowStartupLocation="CenterOwner"
                             ResizeMode="CanResize">
    <syncfusion:ChromelessWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BusBuddy.WPF;component/Resources/SyncfusionV30_Validated_ResourceDictionary.xaml"/>
                <ResourceDictionary Source="/BusBuddy.WPF;component/Resources/ButtonAdvTextOnly.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </syncfusion:ChromelessWindow.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource BusBuddy.Brush.Primary}"
                CornerRadius="5"
                Padding="15"
                Margin="0,0,0,15">
            <TextBlock Text="Add school (required before Generate Routes)"
                       FontSize="16"
                       FontWeight="Bold"
                       Foreground="{DynamicResource BusBuddy.Brush.Text.OnPrimary}"
                       TextWrapping="Wrap"/>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="School name *" Margin="0,0,0,4"/>
                <syncfusion:SfTextBoxExt Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Height="32" Margin="0,0,0,12"
                                         AutomationProperties.Name="School name"/>

                <TextBlock Text="Street address *" Margin="0,0,0,4"/>
                <syncfusion:SfTextBoxExt Text="{Binding Address, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Height="32" Margin="0,0,0,12"
                                         AutomationProperties.Name="School street address"/>

                <TextBlock Text="City *" Margin="0,0,0,4"/>
                <syncfusion:SfTextBoxExt Text="{Binding City, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Height="32" Margin="0,0,0,12"
                                         AutomationProperties.Name="School city"/>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="State *" Margin="0,0,0,4"/>
                        <syncfusion:SfTextBoxExt Text="{Binding State, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 Height="32"
                                                 AutomationProperties.Name="School state"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="ZIP *" Margin="0,0,0,4"/>
                        <syncfusion:SfTextBoxExt Text="{Binding ZipCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 Height="32"
                                                 AutomationProperties.Name="School ZIP"/>
                    </StackPanel>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Start (HH:mm) *" Margin="0,0,0,4"/>
                        <syncfusion:SfMaskedEdit Text="{Binding StartTimeText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 Height="32"
                                                 AutomationProperties.Name="School start time"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Dismissal (HH:mm) *" Margin="0,0,0,4"/>
                        <syncfusion:SfMaskedEdit Text="{Binding DismissalTimeText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 Height="32"
                                                 AutomationProperties.Name="School dismissal time"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Latitude / longitude (optional if Address Validation can geocode)"
                           Margin="0,12,0,4" TextWrapping="Wrap"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <syncfusion:SfTextBoxExt Grid.Column="0"
                                             Text="{Binding LatitudeText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Height="32"
                                             Watermark="Latitude"
                                             AutomationProperties.Name="School latitude"/>
                    <syncfusion:SfTextBoxExt Grid.Column="2"
                                             Text="{Binding LongitudeText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Height="32"
                                             Watermark="Longitude"
                                             AutomationProperties.Name="School longitude"/>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <TextBlock Grid.Row="2" Text="{Binding ValidationMessage}"
                   Foreground="{DynamicResource BusBuddy.Brush.Semantic.Danger}"
                   TextWrapping="Wrap" Margin="0,12,0,8"
                   AutomationProperties.Name="School form validation"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <syncfusion:ButtonAdv Label="Cancel" Command="{Binding CancelCommand}"
                                  SizeMode="Normal" IconWidth="0" IconHeight="0" SmallIcon="{x:Null}"
                                  Margin="0,0,10,0"
                                  AutomationProperties.Name="Cancel add school"/>
            <syncfusion:ButtonAdv Label="Save school" Command="{Binding SaveCommand}"
                                  SizeMode="Normal" IconWidth="0" IconHeight="0" SmallIcon="{x:Null}"
                                  Background="{DynamicResource BusBuddy.Brush.Primary}"
                                  Foreground="{DynamicResource BusBuddy.Brush.Text.OnPrimary}"
                                  AutomationProperties.Name="Save school"/>
        </StackPanel>
    </Grid>
</syncfusion:ChromelessWindow>
