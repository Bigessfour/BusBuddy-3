<syncfusion:ChromelessWindow x:Class="BusBuddy.WPF.Views.Student.SchoolDestinationForm"
                             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                             xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
                             xmlns:maps="clr-namespace:Syncfusion.UI.Xaml.Maps;assembly=Syncfusion.SfMaps.WPF"
                             Title="{Binding Title}"
                             Height="720"
                             Width="920"
                             MinHeight="560"
                             MinWidth="720"
                             WindowStartupLocation="CenterOwner"
                             ResizeMode="CanResize"
                             UseNativeChrome="False"
                             PreviewKeyDown="SchoolForm_PreviewKeyDown">
    <!--
      Input reliability (clerk form):
      - No masked-edit control here — Simple masks reject NumPad keys and often fail to push Text to the VM.
      - SfTextBoxExt AutoCompleteMode=None for all text; DoubleTextBox for lat/lon (map pick works).
      - Save clicks PushFieldsToViewModel() then SaveCommand (bindings alone were leaving VM empty).
    -->
    <syncfusion:ChromelessWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BusBuddy.WPF;component/Resources/SyncfusionV30_Validated_ResourceDictionary.xaml"/>
                <ResourceDictionary Source="/BusBuddy.WPF;component/Resources/ButtonAdvTextOnly.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </syncfusion:ChromelessWindow.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource BusBuddy.Brush.Primary}"
                CornerRadius="5"
                Padding="12,10"
                Margin="0,0,0,12">
            <TextBlock Text="Add school (required before Generate Routes)"
                       FontSize="16"
                       FontWeight="Bold"
                       Foreground="{DynamicResource BusBuddy.Brush.Text.OnPrimary}"
                       TextWrapping="Wrap"/>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" MinWidth="300"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*" MinWidth="320"/>
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Focusable="False">
                <StackPanel>
                    <TextBlock Text="School name *" Margin="0,0,0,4"/>
                    <syncfusion:SfTextBoxExt x:Name="SchoolNameBox"
                                             AutoCompleteMode="None"
                                             ShowClearButton="True"
                                             Height="40" Margin="0,0,0,10"
                                             AutomationProperties.Name="School name"/>

                    <TextBlock Text="Street address *" Margin="0,0,0,4"/>
                    <Grid Margin="0,0,0,10">
                        <syncfusion:SfTextBoxExt x:Name="SchoolAddressBox"
                                                 AutoCompleteMode="None"
                                                 ShowClearButton="True"
                                                 Watermark="1105 Parkview Ave"
                                                 Height="40"
                                                 TextChanged="SchoolAddressBox_TextChanged"
                                                 AutomationProperties.Name="School street address"/>
                        <Popup x:Name="SchoolAddressSuggestionsPopup"
                               PlacementTarget="{Binding ElementName=SchoolAddressBox}"
                               Placement="Bottom"
                               AllowsTransparency="True"
                               StaysOpen="False"
                               IsOpen="{Binding IsAddressSuggestionPopupOpen}">
                            <Border MinWidth="{Binding ActualWidth, ElementName=SchoolAddressBox}"
                                    Background="{DynamicResource BusBuddy.Brush.Surface.Medium}"
                                    BorderBrush="{DynamicResource BusBuddy.Brush.Surface.Border}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="2">
                                <ListBox x:Name="SchoolAddressSuggestionsList"
                                         ItemsSource="{Binding AddressSuggestions}"
                                         DisplayMemberPath="DisplayText"
                                         MaxHeight="180"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         SelectionChanged="SchoolAddressSuggestionsList_SelectionChanged"
                                         AutomationProperties.Name="School address suggestions"/>
                            </Border>
                        </Popup>
                    </Grid>

                    <TextBlock Text="City *" Margin="0,0,0,4"/>
                    <syncfusion:SfTextBoxExt x:Name="SchoolCityBox"
                                             AutoCompleteMode="None"
                                             ShowClearButton="True"
                                             Height="40" Margin="0,0,0,10"
                                             AutomationProperties.Name="School city"/>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="State * (2-letter)" Margin="0,0,0,4"/>
                            <syncfusion:SfTextBoxExt x:Name="SchoolStateBox"
                                                     AutoCompleteMode="None"
                                                     Height="40"
                                                     AutomationProperties.Name="School state"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="ZIP *" Margin="0,0,0,4"/>
                            <syncfusion:SfTextBoxExt x:Name="SchoolZipBox"
                                                     AutoCompleteMode="None"
                                                     Height="40"
                                                     AutomationProperties.Name="School ZIP"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Start (HH:mm) *" Margin="0,0,0,4"/>
                            <syncfusion:SfTextBoxExt x:Name="SchoolStartBox"
                                                     AutoCompleteMode="None"
                                                     Watermark="08:00"
                                                     Height="40"
                                                     AutomationProperties.Name="School start time"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Dismissal (HH:mm) *" Margin="0,0,0,4"/>
                            <syncfusion:SfTextBoxExt x:Name="SchoolDismissalBox"
                                                     AutoCompleteMode="None"
                                                     Watermark="15:30"
                                                     Height="40"
                                                     AutomationProperties.Name="School dismissal time"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Latitude / longitude" Margin="0,4,0,4" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding MapHint}" TextWrapping="Wrap" Margin="0,0,0,6"
                               Foreground="{DynamicResource BusBuddy.Brush.Text.Secondary}"
                               AutomationProperties.Name="School map hint"/>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <syncfusion:DoubleTextBox x:Name="SchoolLatBox"
                                                  Grid.Column="0"
                                                  NumberDecimalDigits="6"
                                                  MinValue="-90"
                                                  MaxValue="90"
                                                  Height="40"
                                                  AutomationProperties.Name="School latitude"/>
                        <syncfusion:DoubleTextBox x:Name="SchoolLonBox"
                                                  Grid.Column="2"
                                                  NumberDecimalDigits="6"
                                                  MinValue="-180"
                                                  MaxValue="180"
                                                  Height="40"
                                                  AutomationProperties.Name="School longitude"/>
                    </Grid>
                    <syncfusion:ButtonAdv Label="Clear map pin"
                                          Command="{Binding ClearMapPickCommand}"
                                          SizeMode="Normal" IconWidth="0" IconHeight="0" SmallIcon="{x:Null}"
                                          HorizontalAlignment="Left"
                                          AutomationProperties.Name="Clear school map pin"/>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Column="2"
                    BorderBrush="{DynamicResource BusBuddy.Brush.Surface.Border}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Margin="4,2,4,6" TextWrapping="Wrap"
                               Text="Click map to pin school location (Lamar area). Scroll wheel zooms; drag pans."/>
                    <maps:SfMap x:Name="SchoolPickMap"
                                Grid.Row="1"
                                ZoomLevel="{Binding MapZoomLevel}"
                                EnableZoom="True"
                                EnablePan="True"
                                MouseLeftButtonUp="SchoolPickMap_MouseLeftButtonUp"
                                AutomationProperties.Name="School location map">
                        <maps:SfMap.Layers>
                            <maps:ImageryLayer x:Name="SchoolPickLayer"
                                               LayerType="OSM"
                                               Center="{Binding MapCenter}"
                                               Markers="{Binding MapMarkers}"/>
                        </maps:SfMap.Layers>
                    </maps:SfMap>
                </Grid>
            </Border>
        </Grid>

        <TextBlock Grid.Row="2" Text="{Binding ValidationMessage}"
                   Foreground="{DynamicResource BusBuddy.Brush.Semantic.Danger}"
                   TextWrapping="Wrap" Margin="0,10,0,8" MinHeight="20"
                   AutomationProperties.Name="School form validation"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <syncfusion:ButtonAdv Label="Cancel" Command="{Binding CancelCommand}"
                                  SizeMode="Normal" IconWidth="0" IconHeight="0" SmallIcon="{x:Null}"
                                  Margin="0,0,10,0"
                                  AutomationProperties.Name="Cancel add school"/>
            <syncfusion:ButtonAdv x:Name="SaveSchoolButton"
                                  Label="Save school"
                                  Click="SaveSchoolButton_Click"
                                  SizeMode="Normal" IconWidth="0" IconHeight="0" SmallIcon="{x:Null}"
                                  IsDefault="True"
                                  Background="{DynamicResource BusBuddy.Brush.Primary}"
                                  Foreground="{DynamicResource BusBuddy.Brush.Text.OnPrimary}"
                                  AutomationProperties.Name="Save school"/>
        </StackPanel>
    </Grid>
</syncfusion:ChromelessWindow>
