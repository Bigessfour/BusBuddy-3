<syncfusion:ChromelessWindow x:Class="BusBuddy.WPF.Views.Student.StudentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800"
             Title="Student Management"
             Height="720" Width="1100"
             WindowStartupLocation="CenterOwner">

    <syncfusion:ChromelessWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BusBuddy.WPF;component/Resources/SyncfusionV30_Validated_ResourceDictionary.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
            <!-- Text-only ButtonAdv: Fluent templates show a default glyph when SmallIcon is unset (the blue "A"). -->
            <Style x:Key="StudentsToolbarButton"
                   TargetType="syncfusion:ButtonAdv">
                <Setter Property="SizeMode" Value="Normal"/>
                <Setter Property="IconWidth" Value="0"/>
                <Setter Property="IconHeight" Value="0"/>
                <Setter Property="SmallIcon" Value="{x:Null}"/>
                <Setter Property="Padding" Value="12,8"/>
                <Setter Property="Margin" Value="0,0,8,0"/>
                <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundBrush}"/>
            </Style>
            <Style x:Key="StudentsPrimaryButton"
                   TargetType="syncfusion:ButtonAdv"
                   BasedOn="{StaticResource StudentsToolbarButton}">
                <Setter Property="Background" Value="{DynamicResource BusBuddy.Brush.Primary}"/>
                <Setter Property="Foreground" Value="{DynamicResource BusBuddy.Brush.Text.OnPrimary}"/>
            </Style>
            <Style x:Key="StudentsSuccessButton"
                   TargetType="syncfusion:ButtonAdv"
                   BasedOn="{StaticResource StudentsToolbarButton}">
                <Setter Property="Background" Value="{DynamicResource BusBuddy.Brush.Semantic.Success}"/>
                <Setter Property="Foreground" Value="{DynamicResource BusBuddy.Brush.Text.OnPrimary}"/>
            </Style>
        </ResourceDictionary>
    </syncfusion:ChromelessWindow.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource BusBuddy.Brush.Primary}"
                CornerRadius="5" Padding="15" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets"
                          FontSize="24" Foreground="{DynamicResource BusBuddy.Brush.Text.OnPrimary}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Text="Student Management" FontSize="20" FontWeight="Bold"
                          Foreground="{DynamicResource BusBuddy.Brush.Text.OnPrimary}" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Background="{DynamicResource BusBuddy.Brush.Surface.Light}"
                CornerRadius="3" Padding="10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <WrapPanel Grid.Column="0" Orientation="Horizontal">
                    <syncfusion:ButtonAdv Name="AddStudentButton" Label="Add Student"
                            Command="{Binding AddStudentCommand}"
                            Style="{StaticResource StudentsPrimaryButton}"
                            AutomationProperties.Name="Add Student"
                            AutomationProperties.HelpText="Opens form to add a new student to the system"
                            ToolTip="Add a new student"/>
                    <syncfusion:ButtonAdv Name="AddSchoolButton" Label="Add School"
                            Command="{Binding AddSchoolCommand}"
                            Style="{StaticResource StudentsToolbarButton}"
                            AutomationProperties.Name="Add School"
                            AutomationProperties.HelpText="Catalog a school campus with bell times before generating routes"
                            ToolTip="Add a school destination (required before Generate Routes)"/>
                    <syncfusion:ButtonAdv Name="AddPickupStopButton" Label="Add Pickup Stop"
                            Command="{Binding AddPickupStopCommand}"
                            Style="{StaticResource StudentsToolbarButton}"
                            AutomationProperties.Name="Add Pickup Stop"
                            AutomationProperties.HelpText="Place a shared corner or block stop on the map for multiple students"
                            ToolTip="Add a district pickup stop (pin on map)"/>
                    <syncfusion:ButtonAdv Name="EditStudentButton" Label="Edit Student"
                            Command="{Binding EditStudentCommand}"
                            IsEnabled="{Binding HasSelectedStudent}"
                            Style="{StaticResource StudentsToolbarButton}"
                            AutomationProperties.Name="Edit Student"
                            AutomationProperties.HelpText="Opens form to edit the currently selected student"
                            ToolTip="Edit selected student"/>
                    <syncfusion:ButtonAdv Name="DeleteStudentButton" Label="Delete Student"
                            Command="{Binding DeleteStudentCommand}"
                            IsEnabled="{Binding HasSelectedStudent}"
                            Style="{StaticResource StudentsToolbarButton}"
                            AutomationProperties.Name="Delete Student"
                            AutomationProperties.HelpText="Removes the currently selected student from the system"
                            ToolTip="Delete selected student"/>
                    <syncfusion:ButtonAdv Name="SchoolTransferButton" Label="School Transfer"
                            Command="{Binding SchoolTransferCommand}"
                            IsEnabled="{Binding HasSelectedStudent}"
                            Style="{StaticResource StudentsToolbarButton}"
                            AutomationProperties.Name="School Transfer"
                            AutomationProperties.HelpText="Assign school-to-school transfer with required pickup/dropoff locations and times"
                            ToolTip="School transfer for selected student"/>
                    <Separator Margin="4,0,10,0"/>

                    <syncfusion:ButtonAdv Name="ImportStudentsButton" Label="Import CSV"
                            Command="{Binding ImportStudentsCommand}"
                            Style="{StaticResource StudentsSuccessButton}"
                            AutomationProperties.Name="Import Students from CSV"
                            AutomationProperties.HelpText="Import student records from a CSV file"
                            ToolTip="Import students from student CSV"/>
                    <syncfusion:ButtonAdv Name="BulkAssignRouteButton" Label="Bulk Assign Route"
                            Command="{Binding BulkAssignRouteCommand}"
                            IsEnabled="{Binding HasSelectedStudents}"
                            Style="{StaticResource StudentsToolbarButton}"
                            AutomationProperties.Name="Bulk Assign Route"
                            AutomationProperties.HelpText="Assign routes to multiple selected students at once"
                            ToolTip="Bulk assign route"/>
                    <Separator Margin="4,0,10,0"/>

                    <syncfusion:ButtonAdv Name="OptimizeRoutesButton" Label="AI Optimize"
                            Command="{Binding OptimizeRoutesCommand}"
                            Style="{StaticResource StudentsToolbarButton}"
                            AutomationProperties.Name="AI Optimize Routes"
                            AutomationProperties.HelpText="Run AI-assisted route optimization for selected students"
                            ToolTip="AI-assisted route optimization"/>
                    <syncfusion:ButtonAdv Name="ViewMapButton" Label="View Map"
                            Command="{Binding ViewMapCommand}"
                            Style="{StaticResource StudentsToolbarButton}"
                            AutomationProperties.Name="View Map"
                            AutomationProperties.HelpText="Display student locations on interactive map"
                            ToolTip="Plot students on map"/>
                </WrapPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <syncfusion:ButtonAdv Name="RefreshButton" Label="Refresh"
                            Command="{Binding RefreshCommand}"
                            Style="{StaticResource StudentsToolbarButton}"
                            AutomationProperties.Name="Refresh Student List"
                            AutomationProperties.HelpText="Reload student data from the database"
                            ToolTip="Refresh list"/>
                    <syncfusion:ButtonAdv Name="ExportButton" Label="Export"
                            Command="{Binding ExportCommand}"
                            Style="{StaticResource StudentsToolbarButton}"
                            AutomationProperties.Name="Export Students"
                            AutomationProperties.HelpText="Export student data to CSV file"
                            ToolTip="Export students"/>

                    <syncfusion:SfTextBoxExt Name="QuickSearchBox" Width="180" Margin="10,0,0,0"
                                              Text="{Binding QuickSearchText, UpdateSourceTrigger=PropertyChanged}"
                                              Watermark="Quick search..."
                                              AutomationProperties.Name="Quick Search"
                                              AutomationProperties.HelpText="Type to search students by name, ID, or route"/>
                </StackPanel>
            </Grid>
        </Border>

        <syncfusion:SfDataGrid Grid.Row="2"
                               Name="StudentsDataGrid"
                   ItemsSource="{Binding StudentsView}"
                               SelectedItem="{Binding SelectedStudent, Mode=TwoWay}"
                               AutoGenerateColumns="False"
                               AllowEditing="True"
                               EditTrigger="OnTap"
                               AllowSorting="True"
                               AllowFiltering="True"
                               AllowGrouping="True"
                               ShowGroupDropArea="True"
                               ShowRowHeader="True"
                               SelectionMode="Single"
                               SelectionUnit="Row"
                               GridLinesVisibility="Both"
                               HeaderLinesVisibility="Both"
                               ColumnSizer="Star"
                               AutomationProperties.Name="Students Data Grid"
                               AutomationProperties.HelpText="Grid displaying all students with their route assignments and contact information"
                               AddNewRowPosition="Top"
                               ShowBusyIndicator="True"
                               NavigationMode="Cell"
                               AllowResizingColumns="True">

            <syncfusion:SfDataGrid.TableSummaryRows>
                <syncfusion:GridTableSummaryRow ShowSummaryInRow="False">
                    <syncfusion:GridTableSummaryRow.SummaryColumns>
                        <syncfusion:GridSummaryColumn Name="TotalStudents"
                                                    MappingName="StudentNumber"
                                                    SummaryType="CountAggregate"
                                                    Format="'Total: {Count:0}'" />
                        <syncfusion:GridSummaryColumn Name="ActiveCount"
                                                    MappingName="Active"
                                                    SummaryType="CountAggregate"
                                                    Format="'Active: {Count:0}'" />
                    </syncfusion:GridTableSummaryRow.SummaryColumns>
                </syncfusion:GridTableSummaryRow>
            </syncfusion:SfDataGrid.TableSummaryRows>

            <syncfusion:SfDataGrid.GroupSummaryRows>
                <syncfusion:GridSummaryRow ShowSummaryInRow="True">
                    <syncfusion:GridSummaryRow.SummaryColumns>
                        <syncfusion:GridSummaryColumn Name="GroupCount"
                                                    MappingName="StudentNumber"
                                                    SummaryType="CountAggregate"
                                                    Format="'{Count} students in this group'" />
                    </syncfusion:GridSummaryRow.SummaryColumns>
                </syncfusion:GridSummaryRow>
            </syncfusion:SfDataGrid.GroupSummaryRows>

            <syncfusion:SfDataGrid.Columns>
                <syncfusion:GridTextColumn HeaderText="Student ID"
                                         MappingName="StudentNumber"
                                         Width="100"
                                         AllowEditing="True"/>
                <syncfusion:GridTextColumn HeaderText="Name"
                                         MappingName="StudentName"
                                         Width="180"
                                         AllowEditing="True"/>
                <syncfusion:GridDateTimeColumn HeaderText="Enrolled"
                                             MappingName="EnrollmentDate"
                                             Width="110"
                                             Pattern="ShortDate"/>
                <syncfusion:GridComboBoxColumn HeaderText="Grade"
                                             MappingName="Grade"
                                             Width="80"
                                             ItemsSource="{Binding AvailableGrades}"
                                             AllowEditing="True"/>
                <syncfusion:GridComboBoxColumn HeaderText="School"
                                             MappingName="School"
                                             Width="150"
                                             DisplayMemberPath="Name"
                                             SelectedValuePath="Name"
                                             ItemsSource="{Binding AvailableSchools}"
                                             AllowEditing="True"/>
                <syncfusion:GridTextColumn HeaderText="School ID"
                                         MappingName="DestinationId"
                                         Width="80"
                                         AllowEditing="False"/>
                <syncfusion:GridTextColumn HeaderText="Address"
                                         MappingName="HomeAddress"
                                         Width="200"
                                         AllowEditing="True"/>
                <syncfusion:GridTextColumn HeaderText="City"
                                         MappingName="City"
                                         Width="120"
                                         AllowEditing="True"/>
                <syncfusion:GridTextColumn HeaderText="Latitude"
                                         MappingName="Latitude"
                                         Width="90"
                                         AllowEditing="False"/>
                <syncfusion:GridTextColumn HeaderText="Longitude"
                                         MappingName="Longitude"
                                         Width="90"
                                         AllowEditing="False"/>
                <syncfusion:GridMaskColumn HeaderText="Phone"
                                           MappingName="HomePhone"
                                           Width="120"
                                           AllowEditing="True"
                                           Mask="(###) ###-####"
                                           PromptChar="_" />
                <syncfusion:GridTextColumn HeaderText="Parent/Guardian"
                                         MappingName="ParentGuardian"
                                         Width="150"
                                         AllowEditing="True"/>
                <syncfusion:GridComboBoxColumn HeaderText="AM Route"
                                             MappingName="AMRoute"
                                             Width="120"
                                             ItemsSource="{Binding AvailableRoutes}"
                                             AllowEditing="True"/>
                <syncfusion:GridComboBoxColumn HeaderText="PM Route"
                                             MappingName="PMRoute"
                                             Width="120"
                                             ItemsSource="{Binding AvailableRoutes}"
                                             AllowEditing="True"/>
                <syncfusion:GridCheckBoxColumn HeaderText="Active"
                                             MappingName="Active"
                                             Width="80"/>
                <syncfusion:GridTemplateColumn HeaderText="Actions" Width="120" AllowFiltering="False" AllowSorting="False">
                    <syncfusion:GridTemplateColumn.CellTemplate>
                        <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <syncfusion:ButtonAdv Label="Map"
                                                          ToolTip="View on Map"
                                                          Command="{Binding DataContext.ViewOnMapCommand, RelativeSource={RelativeSource AncestorType=syncfusion:ChromelessWindow}}"
                                                          CommandParameter="{Binding}"
                                                          Style="{StaticResource StudentsToolbarButton}"
                                                          MinWidth="56" Height="28" Margin="2,0"
                                                          AutomationProperties.Name="View Student On Map"/>
                                    <syncfusion:ButtonAdv Label="Suggest"
                                                          ToolTip="AI Route Suggest"
                                                          Command="{Binding DataContext.SuggestRouteCommand, RelativeSource={RelativeSource AncestorType=syncfusion:ChromelessWindow}}"
                                                          CommandParameter="{Binding}"
                                                          Style="{StaticResource StudentsToolbarButton}"
                                                          MinWidth="72" Height="28" Margin="2,0"
                                                          AutomationProperties.Name="Suggest Route For Student"/>
                                </StackPanel>
                        </DataTemplate>
                    </syncfusion:GridTemplateColumn.CellTemplate>
                </syncfusion:GridTemplateColumn>
            </syncfusion:SfDataGrid.Columns>
        </syncfusion:SfDataGrid>

        <Border Grid.Row="3" Background="{DynamicResource BusBuddy.Brush.Surface.Light}"
                CornerRadius="3" Padding="10" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Students: " FontWeight="SemiBold" Foreground="{DynamicResource BusBuddy.Brush.Text.Primary}"/>
                    <TextBlock Text="{Binding TotalStudents}" FontWeight="Bold" Margin="0,0,15,0" Foreground="{DynamicResource BusBuddy.Brush.Text.Primary}"/>
                    <TextBlock Text="Active: " FontWeight="SemiBold" Foreground="{DynamicResource BusBuddy.Brush.Text.Primary}"/>
                    <TextBlock Text="{Binding ActiveStudents}" FontWeight="Bold" Margin="0,0,15,0" Foreground="{DynamicResource BusBuddy.Brush.Text.Primary}"/>
                    <TextBlock Text="With Routes: " FontWeight="SemiBold" Foreground="{DynamicResource BusBuddy.Brush.Text.Primary}"/>
                    <TextBlock Text="{Binding StudentsWithRoutes}" FontWeight="Bold" Margin="0,0,15,0" Foreground="{DynamicResource BusBuddy.Brush.Text.Primary}"/>
                    <TextBlock Text="Unassigned: " FontWeight="SemiBold" Foreground="{DynamicResource BusBuddy.Brush.Text.Primary}"/>
                    <TextBlock Text="{Binding UnassignedStudents}" FontWeight="Bold" Margin="0,0,15,0" Foreground="{DynamicResource BusBuddy.Brush.Text.Primary}"/>
                    <TextBlock Text="Selected: " FontWeight="SemiBold" Foreground="{DynamicResource BusBuddy.Brush.Text.Primary}"/>
                    <TextBlock Text="{Binding SelectedStudent.StudentName, FallbackValue='None'}" FontWeight="Bold" Foreground="{DynamicResource BusBuddy.Brush.Text.Primary}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Status: " FontStyle="Italic" Foreground="{DynamicResource BusBuddy.Brush.Text.Secondary}"/>
                    <TextBlock Text="{Binding StatusMessage}" Margin="4,0,10,0" Foreground="{DynamicResource BusBuddy.Brush.Text.Secondary}"/>
                    <TextBlock Text="{Binding FilterStatusText}" FontStyle="Italic" Margin="0,0,10,0" Foreground="{DynamicResource BusBuddy.Brush.Text.Secondary}"/>
                    <syncfusion:ButtonAdv Label="Save"
                            Command="{Binding SaveGridEditsCommand}"
                            Style="{StaticResource StudentsToolbarButton}"
                            ToolTip="Save inline edits (including phone/route changes)"
                            AutomationProperties.Name="Save Grid Edits"/>
                    <syncfusion:ButtonAdv Label="Summary"
                            Command="{Binding ShowSummaryCommand}"
                            Style="{StaticResource StudentsToolbarButton}"
                            ToolTip="Show route assignment summary"
                            AutomationProperties.Name="Show Summary"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</syncfusion:ChromelessWindow>
