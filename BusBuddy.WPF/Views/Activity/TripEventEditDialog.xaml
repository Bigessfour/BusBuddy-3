<Window x:Class="BusBuddy.WPF.Views.Activity.TripEventEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
        xmlns:controls="clr-namespace:BusBuddy.WPF.Controls"
        Title="{Binding DialogTitle}"
        Height="780"
        Width="1100"
        MinHeight="640"
        MinWidth="980"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BusBuddy.WPF;component/Resources/SyncfusionV30_Validated_ResourceDictionary.xaml"/>
                <ResourceDictionary Source="/BusBuddy.WPF;component/Resources/ButtonAdvTextOnly.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
            <Style x:Key="SectionTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Margin" Value="0,0,0,12"/>
            </Style>
            <Style x:Key="FieldLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Margin" Value="0,2,0,4"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="24,20,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,16" LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Margin="16,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding StatusDisplay, Mode=OneWay}"
                           FontSize="14"
                           HorizontalAlignment="Right"/>
                <TextBlock Text="{Binding PriorPlanDisplay, Mode=OneWay}"
                           FontSize="12"
                           Opacity="0.85"
                           TextWrapping="Wrap"
                           MaxWidth="360"
                           HorizontalAlignment="Right"
                           Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="{Binding DialogTitle}"
                           FontSize="22"
                           FontWeight="Bold"/>
                <TextBlock Text="{Binding Subject}"
                           Margin="0,4,0,0"
                           FontSize="14"
                           Opacity="0.85"/>
            </StackPanel>
        </DockPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="420"/>
                    <ColumnDefinition Width="32"/>
                    <ColumnDefinition Width="*" MinWidth="420"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Request" Style="{StaticResource SectionTitle}"/>

                    <TextBlock Text="Ticket #" Style="{StaticResource FieldLabel}"/>
                    <syncfusion:SfTextBoxExt Text="{Binding ExternalTicketNo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="Trip ticket number"/>

                    <TextBlock Text="Purpose" Style="{StaticResource FieldLabel}"/>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <syncfusion:ComboBoxAdv ItemsSource="{Binding PurposeOptions}"
                                                SelectedItem="{Binding Purpose, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                Text="{Binding Purpose, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                IsEditable="True"
                                                Margin="0"
                                                AutomationProperties.Name="Trip purpose"
                                                AutomationProperties.HelpText="Type a new purpose, then Add to list, so it is available on later trips."/>
                        <syncfusion:ButtonAdv Grid.Column="1" Label="Add"
                                              Command="{Binding RememberPurposeCommand}"
                                              SizeMode="Normal" Height="42" MinWidth="72" Margin="8,0,0,0"
                                              AutomationProperties.Name="Add trip purpose to list"/>
                        <syncfusion:ButtonAdv Grid.Column="2" Label="Remove"
                                              Command="{Binding RemovePurposeCommand}"
                                              SizeMode="Normal" Height="42" MinWidth="88" Margin="8,0,0,0"
                                              AutomationProperties.Name="Remove trip purpose from list"/>
                    </Grid>

                    <TextBlock Text="Sport or trip reason" Style="{StaticResource FieldLabel}"
                               Visibility="{Binding IsSports, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <Grid Margin="0,0,0,10"
                          Visibility="{Binding IsSports, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <syncfusion:ComboBoxAdv ItemsSource="{Binding SportKinds}"
                                                SelectedItem="{Binding SportKind, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                Text="{Binding SportKind, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                IsEditable="True"
                                                Margin="0"
                                                AutomationProperties.Name="Sport"
                                                AutomationProperties.HelpText="Type a sport or reason, then Add to list. Remove drops it from later trips."/>
                        <syncfusion:ButtonAdv Grid.Column="1" Label="Add"
                                              Command="{Binding RememberSportCommand}"
                                              SizeMode="Normal" Height="42" MinWidth="72" Margin="8,0,0,0"
                                              AutomationProperties.Name="Add sport to list"/>
                        <syncfusion:ButtonAdv Grid.Column="2" Label="Remove"
                                              Command="{Binding RemoveSportCommand}"
                                              SizeMode="Normal" Height="42" MinWidth="88" Margin="8,0,0,0"
                                              AutomationProperties.Name="Remove sport from list"/>
                    </Grid>

                    <TextBlock Text="Requesting school" Style="{StaticResource FieldLabel}"/>
                    <syncfusion:ComboBoxAdv ItemsSource="{Binding RequestingSchools}"
                                            SelectedItem="{Binding RequestingSchool, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            Text="{Binding RequestingSchool, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            IsEditable="True"
                                            AutomationProperties.Name="Requesting school"/>

                    <TextBlock Text="Group traveling" Style="{StaticResource FieldLabel}"/>
                    <syncfusion:SfTextBoxExt Text="{Binding GroupOrActivity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Watermark="Varsity, Junior Varsity, High School..."
                                             AutomationProperties.Name="Group traveling"/>

                    <TextBlock Text="Point of contact" Style="{StaticResource FieldLabel}"/>
                    <syncfusion:SfTextBoxExt Text="{Binding PocName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="Trip point of contact"/>

                    <TextBlock Text="Notes" Style="{StaticResource FieldLabel}"/>
                    <syncfusion:SfTextBoxExt Text="{Binding Notes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Height="96"
                                             TextWrapping="Wrap"
                                             AcceptsReturn="True"
                                             VerticalContentAlignment="Top"
                                             AutomationProperties.Name="Trip notes"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Assignment" Style="{StaticResource SectionTitle}"/>

                    <TextBlock Text="Driver" Style="{StaticResource FieldLabel}"/>
                    <syncfusion:ComboBoxAdv ItemsSource="{Binding AvailableDrivers}"
                                            SelectedItem="{Binding SelectedDriver, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            DisplayMemberPath="DriverName"
                                            IsEditable="False"
                                            DefaultText="Select a driver"
                                            AutomationProperties.Name="Driver"/>
                    <TextBlock Text="No active drivers are on file."
                               Margin="0,-4,0,10"
                               Opacity="0.8"
                               Visibility="{Binding ShowNoDriverHint, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                    <TextBlock Text="Bus" Style="{StaticResource FieldLabel}"/>
                    <syncfusion:ComboBoxAdv ItemsSource="{Binding AvailableVehicles}"
                                            SelectedItem="{Binding SelectedVehicle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            DisplayMemberPath="BusNumber"
                                            IsEditable="False"
                                            DefaultText="Select a bus"
                                            AutomationProperties.Name="Bus"/>
                    <TextBlock Text="No active buses are on file."
                               Margin="0,-4,0,10"
                               Opacity="0.8"
                               Visibility="{Binding ShowNoVehicleHint, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                    <TextBlock Text="Place and time" Style="{StaticResource SectionTitle}" Margin="0,8,0,12"/>

                    <TextBlock Text="Origin" Style="{StaticResource FieldLabel}"
                               Visibility="{Binding HasOrigins, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <syncfusion:ComboBoxAdv ItemsSource="{Binding Origins}"
                                            SelectedItem="{Binding SelectedOrigin, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            DisplayMemberPath="Name"
                                            IsEditable="False"
                                            DefaultText="Select a school or depot"
                                            Visibility="{Binding HasOrigins, Converter={StaticResource BooleanToVisibilityConverter}}"
                                            AutomationProperties.Name="Trip origin"/>

                    <TextBlock Text="Pickup point" Style="{StaticResource FieldLabel}"/>
                    <syncfusion:SfTextBoxExt Text="{Binding PickupPoint, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="Pickup point"/>

                    <TextBlock Text="Destination" Style="{StaticResource FieldLabel}"/>
                    <controls:PlacesAddressBox AddressText="{Binding DestinationName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                               UseFormattedAddress="True"
                                               FieldAutomationName="Destination"
                                               AddressApplied="Destination_Applied"
                                               Margin="0,0,0,10"/>

                    <Grid Margin="0,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.4*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Date" Style="{StaticResource FieldLabel}"/>
                            <syncfusion:SfDatePicker Value="{Binding TripDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     FontSize="14"
                                                     AutomationProperties.Name="Trip date"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Leave" Style="{StaticResource FieldLabel}"/>
                            <syncfusion:SfMaskedEdit Value="{Binding LeaveTimeText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Mask="99:99"
                                                     AutomationProperties.Name="Leave time"/>
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Return" Style="{StaticResource FieldLabel}"/>
                            <syncfusion:SfMaskedEdit Value="{Binding ReturnTimeText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Mask="99:99"
                                                     AutomationProperties.Name="Return time"/>
                        </StackPanel>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Estimated travelers" Style="{StaticResource FieldLabel}"/>
                            <syncfusion:IntegerTextBox Value="{Binding PlannedHeadcount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      Height="42"
                                                      AutomationProperties.Name="Estimated travelers"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Rode" Style="{StaticResource FieldLabel}"/>
                            <syncfusion:IntegerTextBox Value="{Binding ActualHeadcount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      Height="42"
                                                      AutomationProperties.Name="Actual riders"/>
                        </StackPanel>
                    </Grid>

                    <CheckBox Content="Overnight pending"
                              IsChecked="{Binding IsOvernightPending, Mode=TwoWay}"
                              Margin="0,8,0,8"
                              Foreground="{DynamicResource PrimaryTextBrush}"
                              AutomationProperties.Name="Overnight pending"/>

                    <TextBlock Text="{Binding PathMilesDisplay, Mode=OneWay}" Margin="0,4,0,2"/>
                    <TextBlock Text="{Binding DriverHoursDisplay, Mode=OneWay}"/>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Margin="0,12,0,8">
            <TextBlock Text="{Binding ValidationMessage}"
                       Foreground="{DynamicResource BusBuddy.Brush.Semantic.Danger}"
                       TextWrapping="Wrap"
                       Visibility="{Binding HasValidationErrors, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <TextBlock Text="{Binding AssignmentWarning}"
                       Foreground="{DynamicResource BusBuddy.Brush.Semantic.Warning}"
                       TextWrapping="Wrap"
                       Margin="0,4,0,0"
                       Visibility="{Binding HasAssignmentWarning, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <syncfusion:ButtonAdv x:Name="SaveButton"
                    Label="{Binding SaveButtonText}"
                    MinWidth="160"
                    Height="40"
                    Margin="0,0,10,0"
                    IsEnabled="{Binding ListsReady}"
                    Command="{Binding SaveCommand}"
                    AutomationProperties.Name="Save trip"/>
            <syncfusion:ButtonAdv x:Name="CancelButton"
                    Label="Cancel"
                    MinWidth="100"
                    Height="40"
                    Click="CancelButton_Click"
                    AutomationProperties.Name="Cancel trip"/>
        </StackPanel>
    </Grid>
</Window>
