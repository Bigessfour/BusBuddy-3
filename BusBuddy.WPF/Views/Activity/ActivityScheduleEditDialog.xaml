<Window x:Class="BusBuddy.WPF.Views.Activity.ActivityScheduleEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
        Title="{Binding DialogTitle}"
        Height="640"
        Width="560"
        MinHeight="600"
        MinWidth="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BusBuddy.WPF;component/Resources/SyncfusionV30_Validated_ResourceDictionary.xaml"/>
                <ResourceDictionary Source="/BusBuddy.WPF;component/Resources/ButtonAdvTextOnly.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{Binding DialogTitle}"
                   FontSize="18"
                   FontWeight="Bold"
                   Margin="0,0,0,16"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Subject (from trip type and destination)" Margin="0,0,0,4"/>
                <TextBlock Text="{Binding Subject}" FontWeight="SemiBold" Margin="0,0,0,10"/>

                <TextBlock Text="Trip type" Margin="0,0,0,4"/>
                <syncfusion:ComboBoxAdv ItemsSource="{Binding TripTypes}" SelectedItem="{Binding TripType, Mode=TwoWay}" Height="32" Margin="0,0,0,10"
                                        AutomationProperties.Name="Trip type"/>

                <TextBlock Text="Destination" Margin="0,0,0,4"/>
                <syncfusion:SfMaskedEdit Text="{Binding ScheduledDestination, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="32" Margin="0,0,0,10"
                                         AutomationProperties.Name="Destination"/>

                <TextBlock Text="Date" Margin="0,0,0,4"/>
                <syncfusion:SfDatePicker Value="{Binding ScheduledDate, Mode=TwoWay}" Margin="0,0,0,10"
                                         AutomationProperties.Name="Scheduled date"/>

                <TextBlock Text="Leave time (hh:mm)" Margin="0,0,0,4"/>
                <syncfusion:SfMaskedEdit Text="{Binding LeaveTimeText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Height="32" Margin="0,0,0,10"
                                         Mask="99:99" AutomationProperties.Name="Leave time"/>

                <TextBlock Text="Event time (hh:mm)" Margin="0,0,0,4"/>
                <syncfusion:SfMaskedEdit Text="{Binding EventTimeText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Height="32" Margin="0,0,0,10"
                                         Mask="99:99" AutomationProperties.Name="Event time"/>

                <TextBlock Text="Riders" Margin="0,0,0,4"/>
                <syncfusion:SfMaskedEdit Text="{Binding ScheduledRiders, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="32" Margin="0,0,0,10"
                                         AutomationProperties.Name="Riders"/>

                <TextBlock Text="Driver" Margin="0,0,0,4"/>
                <syncfusion:ComboBoxAdv ItemsSource="{Binding AvailableDrivers}"
                          SelectedItem="{Binding SelectedDriver, Mode=TwoWay}"
                          DisplayMemberPath="DriverName"
                          Height="32" Margin="0,0,0,10"
                          AutomationProperties.Name="Driver"/>

                <TextBlock Text="Vehicle" Margin="0,0,0,4"/>
                <syncfusion:ComboBoxAdv ItemsSource="{Binding AvailableVehicles}"
                          SelectedItem="{Binding SelectedVehicle, Mode=TwoWay}"
                          DisplayMemberPath="BusNumber"
                          Height="32" Margin="0,0,0,10"
                          AutomationProperties.Name="Vehicle"/>

                <TextBlock Text="Status" Margin="0,0,0,4"/>
                <syncfusion:ComboBoxAdv ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding Status, Mode=TwoWay}" Height="32" Margin="0,0,0,10"
                                        AutomationProperties.Name="Status"/>

                <TextBlock Text="Requested by" Margin="0,0,0,4"/>
                <syncfusion:SfMaskedEdit Text="{Binding RequestedBy, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="32" Margin="0,0,0,10"
                                         AutomationProperties.Name="Requested by"/>

                <TextBlock Text="Notes" Margin="0,0,0,4"/>
                <syncfusion:SfMaskedEdit Text="{Binding Notes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="60" TextWrapping="Wrap" AcceptsReturn="True"
                                         AutomationProperties.Name="Notes"/>
            </StackPanel>
        </ScrollViewer>

        <TextBlock Grid.Row="2"
                   Text="{Binding ValidationMessage}"
                   Foreground="{DynamicResource BusBuddy.Brush.Semantic.Danger}"
                   TextWrapping="Wrap"
                   Margin="0,8,0,8"
                   Visibility="{Binding HasValidationErrors, Converter={StaticResource BooleanToVisibilityConverter}}"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <syncfusion:ButtonAdv x:Name="SaveButton"
                    Label="{Binding SaveButtonText}"
                    MinWidth="140"
                    Height="35"
                    Margin="0,0,10,0"
                    IsEnabled="{Binding ListsReady}"
                    Click="SaveButton_Click"
                    AutomationProperties.Name="Save activity schedule"/>
            <syncfusion:ButtonAdv x:Name="CancelButton"
                    Label="Cancel"
                    MinWidth="80"
                    Height="35"
                    Click="CancelButton_Click"
                    AutomationProperties.Name="Cancel activity schedule"/>
        </StackPanel>
    </Grid>
</Window>
