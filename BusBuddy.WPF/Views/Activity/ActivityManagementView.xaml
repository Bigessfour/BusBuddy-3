<UserControl x:Class="BusBuddy.WPF.Views.Activity.ActivityManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BusBuddy.WPF;component/Resources/SyncfusionV30_Validated_ResourceDictionary.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Trip Board"
                   FontSize="24"
                   FontWeight="Bold"
                   Margin="20,10,20,0"
                   Foreground="{DynamicResource PrimaryTextBrush}"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="20,8">
            <syncfusion:ButtonAdv Label="Import CSV"
                                  Command="{Binding ImportCsvCommand}"
                                  SizeMode="Normal"
                                  Margin="0,0,8,0"
                                  AutomationProperties.Name="Import trip board CSV"/>
            <syncfusion:ButtonAdv Label="Refresh"
                                  Command="{Binding RefreshCommand}"
                                  SizeMode="Normal"
                                  Margin="0,0,8,0"
                                  AutomationProperties.Name="Refresh trip board"/>
            <syncfusion:ButtonAdv Label="Optimize Day"
                                  Command="{Binding OptimizeDayCommand}"
                                  SizeMode="Normal"
                                  Margin="0,0,12,0"
                                  AutomationProperties.Name="Optimize today's trips"
                                  AutomationProperties.HelpText="Suggest bus assignments for the selected date via Google Route Optimization. Does not change pickup times. Route is not a trip."/>
            <TextBlock Text="{Binding StatusMessage}"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource PrimaryTextBrush}"/>
        </StackPanel>

        <syncfusion:SfDataGrid Grid.Row="2"
                               ItemsSource="{Binding Trips}"
                               SelectedItem="{Binding SelectedTrip, Mode=TwoWay}"
                               AutoGenerateColumns="False"
                               AllowEditing="False"
                               AllowSorting="True"
                               AllowFiltering="True"
                               Margin="20"
                               Background="{DynamicResource BusBuddy.Brush.DataGrid.Background}">
            <syncfusion:SfDataGrid.Columns>
                <syncfusion:GridDateTimeColumn HeaderText="Date" MappingName="TripDate" Width="110" Pattern="ShortDate"/>
                <syncfusion:GridTextColumn HeaderText="School" MappingName="RequestingSchool" Width="70"/>
                <syncfusion:GridTextColumn HeaderText="Team / School" MappingName="GroupOrActivity" Width="200"/>
                <syncfusion:GridTextColumn HeaderText="Location" MappingName="DestinationName" Width="160"/>
                <syncfusion:GridTextColumn HeaderText="Ticket #" MappingName="ExternalTicketNo" Width="110"/>
                <syncfusion:GridTextColumn HeaderText="Status" MappingName="Status" Width="110"/>
                <syncfusion:GridTextColumn HeaderText="PAX" MappingName="PlannedHeadcount" Width="60"/>
                <syncfusion:GridTextColumn HeaderText="Rode" MappingName="ActualHeadcount" Width="60"/>
                <syncfusion:GridTextColumn HeaderText="Driver" MappingName="Driver.DriverName" Width="140"/>
                <syncfusion:GridTextColumn HeaderText="Bus #" MappingName="AssignedBusNumber" Width="80"/>
                <syncfusion:GridTextColumn HeaderText="Notes" MappingName="TripNotes" Width="200"/>
            </syncfusion:SfDataGrid.Columns>
        </syncfusion:SfDataGrid>
    </Grid>
</UserControl>
