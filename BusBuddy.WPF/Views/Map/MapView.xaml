<!--
    District Map View
    Syncfusion WPF 34.x via SfSkinManager (FluentDark primary, FluentLight fallback).
    Prefer BusBuddy.Brush.* tokens; ButtonAdv must use Label (Content is ignored).
    Docs: ButtonAdv Label, ComboBoxAdv, SfBusyIndicator, SfDataGrid, SfSkinManager / SfMaps.
-->
<UserControl x:Class="BusBuddy.WPF.Views.Map.MapView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
             xmlns:maps="clr-namespace:Syncfusion.UI.Xaml.Maps;assembly=Syncfusion.SfMaps.WPF"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:BusBuddy.WPF.Views.Map"
             xmlns:viewModels="clr-namespace:BusBuddy.WPF.ViewModels.Map"
             xmlns:utils="clr-namespace:BusBuddy.WPF.Utilities"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1200"
             d:DataContext="{d:DesignInstance viewModels:MapViewModel}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BusBuddy.WPF;component/Resources/SyncfusionV30_Validated_ResourceDictionary.xaml"/>
                <ResourceDictionary Source="/BusBuddy.WPF;component/Resources/ButtonAdvTextOnly.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style TargetType="syncfusion:ButtonAdv" BasedOn="{StaticResource {x:Type syncfusion:ButtonAdv}}">
                <Setter Property="SizeMode" Value="Normal"/>
                <Setter Property="IconWidth" Value="0"/>
                <Setter Property="IconHeight" Value="0"/>
                <Setter Property="SmallIcon" Value="{x:Null}"/>
                <Setter Property="Padding" Value="10,8"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="Margin" Value="0,4"/>
                <!-- Do not set Background/Foreground here — FluentDark paints chrome via SfSkinManager.
                     Local Background overrides break pressed/hover and can hide Label on the map. -->
            </Style>
            <!--
                Overlay buttons sit on imagery. They own their ControlTemplate so the Fluent theme's
                focused / pressed visual states cannot repaint them after a click (Zoom In used to vanish
                once it took keyboard focus — the theme chrome went transparent over the tiles).
                ButtonAdv Label is rendered by TemplateBinding; Content is still ignored per Syncfusion docs.
            -->
            <Style x:Key="MapOverlayButtonStyle" TargetType="syncfusion:ButtonAdv" BasedOn="{StaticResource {x:Type syncfusion:ButtonAdv}}">
                <Setter Property="SizeMode" Value="Normal"/>
                <Setter Property="IconWidth" Value="0"/>
                <Setter Property="IconHeight" Value="0"/>
                <Setter Property="SmallIcon" Value="{x:Null}"/>
                <Setter Property="Height" Value="40"/>
                <Setter Property="MinWidth" Value="88"/>
                <Setter Property="Padding" Value="12,8"/>
                <Setter Property="Margin" Value="4,0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Background" Value="#0F6CBD"/>
                <Setter Property="Foreground" Value="#FFFFFF"/>
                <Setter Property="BorderBrush" Value="#0B5A9E"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="syncfusion:ButtonAdv">
                            <Border x:Name="OverlayChrome"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4"
                                    Padding="{TemplateBinding Padding}"
                                    SnapsToDevicePixels="True">
                                <TextBlock Text="{TemplateBinding Label}"
                                           Foreground="{TemplateBinding Foreground}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#1177BB"/>
                        <Setter Property="BorderBrush" Value="#1177BB"/>
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter Property="Background" Value="#0A4F7A"/>
                        <Setter Property="BorderBrush" Value="#0A4F7A"/>
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Opacity" Value="0.55"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{DynamicResource PrimaryBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

    <!-- Header — Title, status, and layer selector (same tokens as MainWindow / Route Management) -->
    <Border Grid.Row="0"
        Background="{DynamicResource BusBuddy.Brush.Header.Background}"
                Padding="24,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Border Background="{DynamicResource BusBuddy.Brush.Primary}"
                            Width="48" Height="48"
                            CornerRadius="24"
                            Margin="0,0,16,0">
                        <TextBlock Text="&#xE909;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="24"
                                   Foreground="{DynamicResource BusBuddy.Brush.Text.OnPrimary}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="District Map"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource BusBuddy.Brush.Text.Primary}"/>
                        <TextBlock Text="Advanced Geospatial Mapping and Route Visualization"
                                   FontSize="14"
                                   Foreground="{DynamicResource BusBuddy.Brush.Text.Secondary}"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Background="{DynamicResource BusBuddy.Brush.Surface.Medium}"
                            CornerRadius="16"
                            Padding="12,6"
                            Margin="8,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="10" Height="10"
                                                                         Fill="{DynamicResource BusBuddy.Brush.Semantic.Success}"
                                     VerticalAlignment="Center"
                                     Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding StatusMessage}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       MaxWidth="280"
                                       TextTrimming="CharacterEllipsis"
                                                                             Foreground="{DynamicResource BusBuddy.Brush.Text.Primary}"/>
                        </StackPanel>
                    </Border>

                    <!-- Base map provider shown via MapAttribution (Google Map Tiles only) -->
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Control Panel — Commands bind to MapViewModel (CenterOnFleet, ShowRoutes, ShowSchools) -->
    <Border Grid.Column="0"
            Background="{DynamicResource PrimaryBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Padding="16">
                    <StackPanel>
                        <!-- Map Controls — Syncfusion ButtonAdv used per documented API: https://help.syncfusion.com/cr/wpf/Syncfusion.Windows.Tools.Controls.ButtonAdv.html -->
            <Border Background="{DynamicResource PrimaryBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16"
                                Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Map Controls"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                       Foreground="{DynamicResource PrimaryTextBrush}"
                                           Margin="0,0,0,12"/>

                <syncfusion:ButtonAdv Label="Center on Stops"
                              AutomationProperties.Name="Center on plotted stops"
                              ToolTip="Center on plotted schools, stops, and route markers (live fleet GPS is deferred)"
                              Command="{Binding CenterOnFleetCommand}"/>

                <TextBlock Text="Live fleet GPS tracking is deferred — not enabled in this build"
                           FontSize="12"
                           Foreground="{DynamicResource BusBuddy.Brush.Text.Secondary}"
                           TextWrapping="Wrap"
                           Margin="0,8,0,4"
                           AutomationProperties.Name="Fleet GPS status"/>

                <TextBlock Text="Map Layers &amp; Overlays" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource BusBuddy.Brush.Text.Primary}" Margin="0,12,0,4"/>

                <TextBlock Text="Route"
                           FontSize="12"
                           Foreground="{DynamicResource BusBuddy.Brush.Text.Secondary}"
                           Margin="0,0,0,4"/>
                <syncfusion:ComboBoxAdv ItemsSource="{Binding Routes}"
                                        DisplayMemberPath="RouteName"
                                        SelectedItem="{Binding SelectedRoute, Mode=TwoWay}"
                                        IsEditable="False"
                                        MaxDropDownHeight="240"
                                        Margin="0,0,0,8"
                                        ToolTip="Select a route to display on the map"
                                        AutomationProperties.Name="Route selector"/>

                <syncfusion:ButtonAdv Label="Show Routes"
                              AutomationProperties.Name="Show Routes"
                              ToolTip="Show the first route with waypoints; refreshes the drive path via Google Routes when a key is configured"
                              Command="{Binding ShowRoutesCommand}"/>

                <syncfusion:ButtonAdv Label="Export Route"
                              AutomationProperties.Name="Export Route"
                              ToolTip="Save the selected route's stop coordinates as a GeoJSON file (no student names)"
                              Command="{Binding ExportRouteDataCommand}"/>

                <syncfusion:ButtonAdv Label="Show Schools"
                              AutomationProperties.Name="Show Schools"
                              ToolTip="Schools only — hides every other pin. Refresh brings the full district back"
                              Command="{Binding ShowSchoolsCommand}"/>

                <syncfusion:ButtonAdv Label="Plot Pickup Stops"
                              AutomationProperties.Name="Plot Pickup Stops"
                              ToolTip="Catalog pickup stops plus the stops on every published route (gold ring = a bus stops here)"
                              Command="{Binding PlotPickupStopsCommand}"/>

                <TextBlock Text="Students" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,12,0,4"/>
                    <syncfusion:ButtonAdv Label="Plot Students"
                                          ToolTip="Plot catalog pickup stops when assigned, otherwise validated home coordinates already on the student"
                                          Command="{Binding BulkPlotEligibleStudentsCommand}"
                                          AutomationProperties.Name="Plot Students"/>

                <syncfusion:ButtonAdv Label="Move to selected route"
                                      AutomationProperties.Name="Move to selected route"
                                      ToolTip="Move the selected student pin onto the route in the list (clerk override; seating may be exceeded)"
                                      Command="{Binding ApplyClerkOverrideCommand}"/>
                            </StackPanel>
                        </Border>

                        <!-- Pin legend — colours come from MapMarkerLabels.Legend (same source as the marker templates) -->
            <Border Background="{DynamicResource PrimaryBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16">
                            <StackPanel>
                                <TextBlock Text="Pin Legend"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                       Foreground="{DynamicResource PrimaryTextBrush}"
                                           Margin="0,0,0,8"/>
                                <ItemsControl ItemsSource="{Binding MarkerLegend}"
                                              AutomationProperties.Name="Map pin legend">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="0,3">
                                                <Ellipse Width="12" Height="12"
                                                         Fill="{Binding FillHex}"
                                                         Stroke="{DynamicResource BusBuddy.Brush.Text.Secondary}"
                                                         StrokeThickness="1"
                                                         VerticalAlignment="Center"
                                                         Margin="0,0,10,0"/>
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="13"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource BusBuddy.Brush.Text.Primary}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="Gold ring = the selected route stops at this pin"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Margin="0,8,0,0"
                                           Foreground="{DynamicResource BusBuddy.Brush.Text.Secondary}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Map Display Area -->
    <Border Grid.Column="1"
            Background="{DynamicResource PrimaryBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    Margin="0"
                    MinHeight="400">
                <Grid>
                    <!-- Map Container — Main SfMap host with zoom/pan enabled per docs: https://help.syncfusion.com/wpf/maps/getting-started -->
            <Border x:Name="MapContainer"
                Background="{DynamicResource ContentBackgroundBrush}"
                            CornerRadius="8"
                            Margin="16"
                            MinHeight="400"
                            ClipToBounds="True">
                        <Grid>
                            <Grid.Resources>
                                <!--
                                    Syncfusion MarkerTemplate DataContext is CustomDataSymbol (not MapMarker).
                                    Bound marker is CustomDataSymbol.Data — use Data.DisplayCaption / Data.MarkerSize / …
                                    Docs: help.syncfusion.com MarkerTemplateSelector note on CustomDataSymbol.
                                    Pin colour is per kind (MapMarkerLabels.FillHex → MapMarker.FillBrush): school black,
                                    pickup orange, route stop gold, bus barn purple, student green, home blue. Stroke turns
                                    gold when the selected route stops at that pin. Captions are opaque so a neighbour's
                                    text cannot bleed through — the "Lamar Stop 7 chool" overprint came from two pins on one spot.
                                -->
                                <DataTemplate x:Key="SchoolMarkerTemplate">
                                    <StackPanel Orientation="Vertical"
                                                HorizontalAlignment="Center"
                                                Margin="0,-18,0,0">
                                        <Ellipse Width="{Binding Data.MarkerSize}"
                                                 Height="{Binding Data.MarkerSize}"
                                                 HorizontalAlignment="Center"
                                                 Fill="{Binding Data.FillBrush}"
                                                 Stroke="{Binding Data.StrokeBrush}"
                                                 StrokeThickness="2"/>
                                        <Border HorizontalAlignment="Center"
                                                Margin="0,2,0,0"
                                                CornerRadius="2"
                                                Background="#F2FFFFFF"
                                                BorderBrush="#000000"
                                                BorderThickness="1"
                                                Padding="4,1"
                                                Visibility="{Binding Data.ShowCaption, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <!-- Always-dark on white chip over tiles. theme-compliance:allow HardcodedHexForeground -->
                                            <TextBlock Foreground="#000000"
                                                       Text="{Binding Data.DisplayCaption}"
                                                       FontSize="{Binding Data.LabelFontSize}"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxWidth="160"/>
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                                <DataTemplate x:Key="StopMarkerTemplate">
                                    <StackPanel Orientation="Vertical"
                                                HorizontalAlignment="Center"
                                                Margin="0,-14,0,0">
                                        <Ellipse Width="{Binding Data.MarkerSize}"
                                                 Height="{Binding Data.MarkerSize}"
                                                 HorizontalAlignment="Center"
                                                 Fill="{Binding Data.FillBrush}"
                                                 Stroke="{Binding Data.StrokeBrush}"
                                                 StrokeThickness="1.5"/>
                                        <Border HorizontalAlignment="Center"
                                                Margin="0,1,0,0"
                                                CornerRadius="2"
                                                Background="#F2FFFFFF"
                                                BorderBrush="{Binding Data.FillBrush}"
                                                BorderThickness="1"
                                                Padding="3,0"
                                                Visibility="{Binding Data.ShowCaption, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <!-- Always-dark on white chip over tiles. theme-compliance:allow HardcodedHexForeground -->
                                            <TextBlock Foreground="#1F1F1F"
                                                       Text="{Binding Data.DisplayCaption}"
                                                       FontSize="{Binding Data.LabelFontSize}"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxWidth="140"/>
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                                <DataTemplate x:Key="HomeMarkerTemplate">
                                    <StackPanel Orientation="Vertical"
                                                HorizontalAlignment="Center"
                                                Margin="0,-10,0,0">
                                        <Ellipse Width="{Binding Data.MarkerSize}"
                                                 Height="{Binding Data.MarkerSize}"
                                                 HorizontalAlignment="Center"
                                                 Fill="{Binding Data.FillBrush}"
                                                 Stroke="{Binding Data.StrokeBrush}"
                                                 StrokeThickness="1.5"/>
                                        <Border HorizontalAlignment="Center"
                                                Margin="0,1,0,0"
                                                CornerRadius="2"
                                                Background="#F2FFFFFF"
                                                BorderBrush="{Binding Data.FillBrush}"
                                                BorderThickness="1"
                                                Padding="2,0"
                                                Visibility="{Binding Data.ShowCaption, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <!-- Always-dark on white chip over tiles. theme-compliance:allow HardcodedHexForeground -->
                                            <TextBlock Foreground="#1F1F1F"
                                                       Text="{Binding Data.DisplayCaption}"
                                                       FontSize="{Binding Data.LabelFontSize}"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxWidth="120"/>
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                                <utils:MapMarkerTemplateSelector x:Key="DistrictMarkerTemplateSelector"
                                                                 SchoolTemplate="{StaticResource SchoolMarkerTemplate}"
                                                                 HomeTemplate="{StaticResource HomeMarkerTemplate}"
                                                                 StopTemplate="{StaticResource StopMarkerTemplate}"/>
                            </Grid.Resources>
                            <!--
                                SfMap — Google Map Tiles via ImageryLayer.UrlTemplate only (no OSM).
                                LayerType=Bing with empty key is a no-op until UrlTemplate is set (avoids Syncfusion HTTP OSM).
                                Camera is Center + ZoomLevel only. Do not bind ImageryLayer.Radius: it doubles the
                                bounds before solving zoom and re-fits on every SizeChanged, overriding user zoom.
                                Markers, MarkerTemplateSelector, and ImageryLayer.Center are assigned in
                                code-behind after CanHostMarkers + TransformToVisual succeed. Binding
                                Center here calls CalculateGeoCoordinates during first Measure
                                (1139 TransformToVisual errors, VM 2026-09-17).
                            -->
                            <utils:DistrictSfMap x:Name="GeoMap"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        IsHitTestVisible="True"
                                        EnableZoom="True"
                                        EnablePan="True"
                                        IsManipulationEnabled="True"
                                        MinZoom="1"
                                        MaxZoom="19"
                                        ZoomLevel="{Binding MapZoomLevel, Mode=TwoWay}"
                                        SizeChanged="GeoMap_SizeChanged">
                                <utils:DistrictSfMap.Layers>
                                    <utils:GoogleMapTilesImageryLayer x:Name="DistrictImageryLayer"
                                                       LayerType="Bing">
                                        <maps:ImageryLayer.SubShapeFileLayers>
                                            <maps:SubShapeFileLayer x:Name="RouteTrailLayer">
                                                <maps:SubShapeFileLayer.MapElements>
                                                    <maps:MapPolyline x:Name="RouteTrail"
                                                                      Stroke="Gold"
                                                                      StrokeThickness="3"/>
                                                </maps:SubShapeFileLayer.MapElements>
                                            </maps:SubShapeFileLayer>
                                        </maps:ImageryLayer.SubShapeFileLayers>
                                    </utils:GoogleMapTilesImageryLayer>
                                </utils:DistrictSfMap.Layers>
                            </utils:DistrictSfMap>

                            <!-- Map Loading — SfBusyIndicator pattern per docs: https://help.syncfusion.com/wpf/busy-indicator/getting-started -->
                            <Border x:Name="MapLoadingIndicator"
                                    Background="{DynamicResource BusBuddy.Brush.Panel.Background}"
                                    Opacity="0.95"
                                    Visibility="{Binding IsMapLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <syncfusion:SfBusyIndicator Grid.Row="0"
                                                               Width="80" Height="80"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               AnimationType="Flight"/>
                                    <TextBlock Grid.Row="1"
                                               Text="Loading Map..."
                                               Margin="0,12,0,0"
                                               FontSize="16"
                                               Foreground="{DynamicResource BusBuddy.Brush.Text.Primary}"
                                               HorizontalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Map Overlay Controls — Syncfusion ButtonAdv (Label, not Content) with an owned template; ZIndex keeps
                         the toolbar above the tile canvas while SfMap re-renders a zoom step. -->
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Panel.ZIndex="10"
                                Margin="32,32,32,0">
                        <syncfusion:ButtonAdv Label="Zoom In"
                                              Style="{StaticResource MapOverlayButtonStyle}"
                                              ToolTip="Zoom in"
                                              AutomationProperties.Name="Zoom In"
                                              Command="{Binding ZoomInCommand}"/>
                        <syncfusion:ButtonAdv Label="Zoom Out"
                                              Style="{StaticResource MapOverlayButtonStyle}"
                                              ToolTip="Zoom out"
                                              AutomationProperties.Name="Zoom Out"
                                              Command="{Binding ZoomOutCommand}"/>
                        <syncfusion:ButtonAdv Label="Home"
                                              Style="{StaticResource MapOverlayButtonStyle}"
                                              ToolTip="Reset map view"
                                              AutomationProperties.Name="Reset Map View"
                                              Command="{Binding ResetViewCommand}"/>
                        <syncfusion:ButtonAdv Label="Refresh"
                                              Style="{StaticResource MapOverlayButtonStyle}"
                                              ToolTip="Refresh map; recompute selected route drive path via Google Routes"
                                              AutomationProperties.Name="Refresh Map"
                                              Command="{Binding RefreshMapCommand}"
                                              Margin="8,0,0,0"/>
                        <syncfusion:ButtonAdv Label="Print"
                                              Style="{StaticResource MapOverlayButtonStyle}"
                                              ToolTip="Print Route Map"
                                              AutomationProperties.Name="Print Route Map"
                                              Command="{Binding PrintRouteMapsCommand}"
                                              Margin="8,0,0,0"/>
                    </StackPanel>

                    <!-- Map attribution — Google logo + copyright when Google tiles are active (Map Tiles API policies) -->
                    <Border x:Name="MapAttribution"
                            Background="{DynamicResource BusBuddy.Brush.Panel.Header}"
                            Opacity="0.92"
                            CornerRadius="4"
                            Padding="10,6,10,6"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Margin="0,0,24,16"
                            Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Image x:Name="GoogleMapsLogo"
                                   Source="/BusBuddy.WPF;component/Assets/Maps/google_maps_on_non_white.png"
                                   Height="18"
                                   Stretch="Uniform"
                                   Margin="0,0,10,0"
                                   Visibility="Collapsed"
                                   SnapsToDevicePixels="True"
                                   AutomationProperties.Name="Google Maps"/>
                            <TextBlock x:Name="MapAttributionText"
                                       Text="Map tiles unavailable"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource BusBuddy.Brush.Text.Secondary}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
