<!--
    District Map View
    Syncfusion WPF 34.x via SfSkinManager (FluentDark primary, FluentLight fallback).
    Prefer BusBuddy.Brush.* tokens; ButtonAdv must use Label (Content is ignored).
    Docs: ButtonAdv Label, ComboBoxAdv, SfBusyIndicator, SfDataGrid, SfSkinManager / SfMaps.
-->
<UserControl x:Class="BusBuddy.WPF.Views.Map.MapView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
             xmlns:maps="clr-namespace:Syncfusion.UI.Xaml.Maps;assembly=Syncfusion.SfMaps.WPF"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:BusBuddy.WPF.Views.Map"
             xmlns:viewModels="clr-namespace:BusBuddy.WPF.ViewModels.Map"
             xmlns:utils="clr-namespace:BusBuddy.WPF.Utilities"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1200"
             d:DataContext="{d:DesignInstance viewModels:MapViewModel}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BusBuddy.WPF;component/Resources/SyncfusionV30_Validated_ResourceDictionary.xaml"/>
                <ResourceDictionary Source="/BusBuddy.WPF;component/Resources/ButtonAdvTextOnly.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style TargetType="syncfusion:ButtonAdv" BasedOn="{StaticResource {x:Type syncfusion:ButtonAdv}}">
                <Setter Property="SizeMode" Value="Normal"/>
                <Setter Property="IconWidth" Value="0"/>
                <Setter Property="IconHeight" Value="0"/>
                <Setter Property="SmallIcon" Value="{x:Null}"/>
                <Setter Property="Padding" Value="10,8"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
            </Style>
            <Style x:Key="MapOverlayWpfButtonStyle" TargetType="Button">
                <Setter Property="Height" Value="40"/>
                <Setter Property="MinWidth" Value="88"/>
                <Setter Property="Padding" Value="12,8"/>
                <Setter Property="Margin" Value="4,0"/>
                <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundBrush}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
            </Style>
            <Style x:Key="MapOverlayButtonStyle" TargetType="syncfusion:ButtonAdv" BasedOn="{StaticResource {x:Type syncfusion:ButtonAdv}}">
                <Setter Property="Height" Value="40"/>
                <Setter Property="Padding" Value="12,8"/>
                <Setter Property="MinWidth" Value="88"/>
                <Setter Property="Margin" Value="4,0"/>
            </Style>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{DynamicResource PrimaryBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

    <!-- Header — Title, status, and layer selector (same tokens as MainWindow / Route Management) -->
    <Border Grid.Row="0"
        Background="{DynamicResource BusBuddy.Brush.Header.Background}"
                Padding="24,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Border Background="{DynamicResource BusBuddy.Brush.Primary}"
                            Width="48" Height="48"
                            CornerRadius="24"
                            Margin="0,0,16,0">
                        <TextBlock Text="&#xE909;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="24"
                                   Foreground="{DynamicResource BusBuddy.Brush.Text.OnPrimary}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="District Map"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource BusBuddy.Brush.Text.Primary}"/>
                        <TextBlock Text="Advanced Geospatial Mapping and Route Visualization"
                                   FontSize="14"
                                   Foreground="{DynamicResource BusBuddy.Brush.Text.Secondary}"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Background="{DynamicResource BusBuddy.Brush.Surface.Medium}"
                            CornerRadius="16"
                            Padding="12,6"
                            Margin="8,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="10" Height="10"
                                                                         Fill="{DynamicResource BusBuddy.Brush.Semantic.Success}"
                                     VerticalAlignment="Center"
                                     Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding StatusMessage}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       MaxWidth="280"
                                       TextTrimming="CharacterEllipsis"
                                                                             Foreground="{DynamicResource BusBuddy.Brush.Text.Primary}"/>
                        </StackPanel>
                    </Border>

                    <!-- Base map provider shown via MapAttribution (Google Maps or OSM) -->
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Control Panel — Commands bind to MapViewModel (CenterOnFleet, ShowRoutes, ShowSchools) -->
    <Border Grid.Column="0"
            Background="{DynamicResource PrimaryBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Padding="16">
                    <StackPanel>
                        <!-- Map Controls — Syncfusion ButtonAdv used per documented API: https://help.syncfusion.com/cr/wpf/Syncfusion.Windows.Tools.Controls.ButtonAdv.html -->
            <Border Background="{DynamicResource PrimaryBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16"
                                Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Map Controls"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                       Foreground="{DynamicResource PrimaryTextBrush}"
                                           Margin="0,0,0,12"/>

                <syncfusion:ButtonAdv Label="Center on Stops"
                              AutomationProperties.Name="Center on plotted stops"
                              ToolTip="Center on plotted schools, stops, and route markers (live fleet GPS is deferred)"
                              Command="{Binding CenterOnFleetCommand}"
                              Background="{DynamicResource ButtonBackgroundBrush}"
                              Foreground="{DynamicResource ButtonForegroundBrush}"
                              Padding="10,8"
                              Margin="0,4"
                              HorizontalAlignment="Stretch"/>

                <TextBlock Text="Live fleet GPS tracking is deferred — not enabled in this build"
                           FontSize="12"
                           Foreground="{DynamicResource BusBuddy.Brush.Text.Secondary}"
                           TextWrapping="Wrap"
                           Margin="0,8,0,4"
                           AutomationProperties.Name="Fleet GPS status"/>

                <TextBlock Text="Map Layers &amp; Overlays" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource BusBuddy.Brush.Text.Primary}" Margin="0,12,0,4"/>

                <TextBlock Text="Route"
                           FontSize="12"
                           Foreground="{DynamicResource BusBuddy.Brush.Text.Secondary}"
                           Margin="0,0,0,4"/>
                <syncfusion:ComboBoxAdv ItemsSource="{Binding Routes}"
                                        DisplayMemberPath="RouteName"
                                        SelectedItem="{Binding SelectedRoute, Mode=TwoWay}"
                                        IsEditable="False"
                                        MaxDropDownHeight="240"
                                        Margin="0,0,0,8"
                                        ToolTip="Select a route to display on the map"
                                        AutomationProperties.Name="Route selector"/>

                <syncfusion:ButtonAdv Label="Show Routes"
                              AutomationProperties.Name="Show Routes"
                              ToolTip="Show the first route that has stored waypoints"
                              Command="{Binding ShowRoutesCommand}"
                              Background="{DynamicResource ButtonBackgroundBrush}"
                              Foreground="{DynamicResource ButtonForegroundBrush}"
                              Padding="10,8"
                              Margin="0,4"
                              HorizontalAlignment="Stretch"/>

                <syncfusion:ButtonAdv Label="Export Route"
                              AutomationProperties.Name="Export Route"
                              ToolTip="Save the selected route waypoints as GeoJSON. Enable in Settings."
                              Command="{Binding ExportRouteDataCommand}"
                              Background="{DynamicResource ButtonBackgroundBrush}"
                              Foreground="{DynamicResource ButtonForegroundBrush}"
                              Padding="10,8"
                              Margin="0,4"
                              HorizontalAlignment="Stretch"/>

                <syncfusion:ButtonAdv Label="Show Schools"
                              AutomationProperties.Name="Show Schools"
                              ToolTip="Show school destinations"
                              Command="{Binding ShowSchoolsCommand}"
                              Background="{DynamicResource ButtonBackgroundBrush}"
                              Foreground="{DynamicResource ButtonForegroundBrush}"
                              Padding="10,8"
                              Margin="0,4"
                              HorizontalAlignment="Stretch"/>

                <syncfusion:ButtonAdv Label="Plot Pickup Stops"
                              AutomationProperties.Name="Plot Pickup Stops"
                              ToolTip="Show catalog pickup stops (corners and shared boarding points)"
                              Command="{Binding PlotPickupStopsCommand}"
                              Background="{DynamicResource ButtonBackgroundBrush}"
                              Foreground="{DynamicResource ButtonForegroundBrush}"
                              Padding="10,8"
                              Margin="0,4"
                              HorizontalAlignment="Stretch"/>

                <TextBlock Text="Students" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,12,0,4"/>
                    <!-- Plot students already in the system (auto geocode missing coordinates) -->
                    <syncfusion:ButtonAdv Label="Plot Students"
                                          ToolTip="Plot catalog pickup stops when assigned, otherwise home; geocode missing homes"
                                          Command="{Binding BulkPlotEligibleStudentsCommand}"
                                          AutomationProperties.Name="Plot Students"
                                          Background="{DynamicResource ButtonBackgroundBrush}"
                                          Foreground="{DynamicResource ButtonForegroundBrush}"
                                          Padding="10,8"
                                          Margin="0,4,0,0"
                                          HorizontalAlignment="Stretch"/>

                <!-- Generate Eligibility Route PDF (auto-build pseudo route) -->
                <syncfusion:ButtonAdv Label="Generate Eligibility PDF"
                              AutomationProperties.Name="Generate Eligibility PDF"
                              ToolTip="Generate eligibility route PDF"
                              Command="{Binding GenerateEligibilityRoutePdfCommand}"
                              Background="{DynamicResource ButtonBackgroundBrush}"
                              Foreground="{DynamicResource ButtonForegroundBrush}"
                              Padding="10,8"
                              Margin="0,4,0,0"
                              HorizontalAlignment="Stretch"/>
                            </StackPanel>
                        </Border>

                        <!-- Bus List — SfDataGrid usage follows Getting Started: https://help.syncfusion.com/wpf/datagrid/getting-started -->
            <Border Background="{DynamicResource PrimaryBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16">
                            <StackPanel>
                                <TextBlock Text="Active Buses"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                       Foreground="{DynamicResource PrimaryTextBrush}"
                                           Margin="0,0,0,12"/>

                                <syncfusion:SfDataGrid x:Name="BusListGrid"
                                                       ItemsSource="{Binding ActiveBuses}"
                                                       SelectedItem="{Binding SelectedBus}"
                                                       Height="200"
                                                       AutoGenerateColumns="False"
                                                       AllowEditing="False"
                                                       AllowSorting="True"
                                                       AllowFiltering="False"
                                                       SelectionMode="Single"
                                                       GridLinesVisibility="Both"
                                                          HeaderLinesVisibility="Both">
                                    <syncfusion:SfDataGrid.Columns>
                                        <syncfusion:GridTextColumn HeaderText="Bus #"
                                                                   MappingName="BusNumber"
                                                                   Width="60"/>
                                        <syncfusion:GridTextColumn HeaderText="Route"
                                                                   MappingName="RouteNumber"
                                                                   Width="60"/>
                                        <syncfusion:GridTextColumn HeaderText="Status"
                                                                   MappingName="Status"
                                                                   Width="80"/>
                                    </syncfusion:SfDataGrid.Columns>
                                </syncfusion:SfDataGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Map Display Area -->
    <Border Grid.Column="1"
            Background="{DynamicResource PrimaryBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    Margin="0"
                    MinHeight="400">
                <Grid>
                    <!-- Map Container — Main SfMap host with zoom/pan enabled per docs: https://help.syncfusion.com/wpf/maps/getting-started -->
            <Border x:Name="MapContainer"
                Background="{DynamicResource ContentBackgroundBrush}"
                            CornerRadius="8"
                            Margin="16"
                            MinHeight="400">
                        <Grid>
                            <Grid.Resources>
                                <!--
                                    Syncfusion MarkerTemplateSelector: school vs home vs stop (docs MapLayer.MarkerTemplateSelector).
                                    Template DataContext is the MapMarker. Home/stop captions collapse below
                                    MapDefaults.DetailLabelZoomLevel via MapViewModel.ShowDetailLabels so a
                                    county-wide plot reads as dots; school captions always show.
                                -->
                                <DataTemplate x:Key="SchoolMarkerTemplate">
                                    <StackPanel Orientation="Vertical" Margin="-10,-28,0,0">
                                        <Ellipse Width="16" Height="16"
                                                 Fill="{DynamicResource BusBuddy.Brush.Primary}"
                                                 Stroke="{DynamicResource BusBuddy.Brush.Text.OnPrimary}"
                                                 StrokeThickness="2"/>
                                        <TextBlock Text="{Binding Label}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource BusBuddy.Brush.Text.Primary}"
                                                   Background="{DynamicResource BusBuddy.Brush.Surface.Medium}"
                                                   Padding="4,1"
                                                   Margin="-16,2,0,0"/>
                                    </StackPanel>
                                </DataTemplate>
                                <DataTemplate x:Key="StopMarkerTemplate">
                                    <StackPanel Orientation="Vertical" Margin="-8,-24,0,0" ToolTip="{Binding Label}">
                                        <Ellipse Width="12" Height="12"
                                                 Fill="{DynamicResource BusBuddy.Brush.Semantic.Error}"
                                                 Stroke="{DynamicResource BusBuddy.Brush.Text.Primary}"
                                                 StrokeThickness="1"/>
                                        <TextBlock Text="{Binding Label}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource BusBuddy.Brush.Text.Primary}"
                                                   Background="{DynamicResource BusBuddy.Brush.Surface.Medium}"
                                                   Padding="4,1"
                                                   Margin="-12,2,0,0"
                                                   Visibility="{Binding DataContext.ShowDetailLabels, RelativeSource={RelativeSource AncestorType={x:Type local:MapView}}, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    </StackPanel>
                                </DataTemplate>
                                <DataTemplate x:Key="HomeMarkerTemplate">
                                    <StackPanel Orientation="Vertical" Margin="-6,-18,0,0" ToolTip="{Binding Label}">
                                        <Ellipse Width="8" Height="8"
                                                 Fill="{DynamicResource BusBuddy.Brush.Semantic.Error}"
                                                 Stroke="{DynamicResource BusBuddy.Brush.Text.Primary}"
                                                 StrokeThickness="1"/>
                                        <TextBlock Text="{Binding Label}"
                                                   FontSize="9"
                                                   Foreground="{DynamicResource BusBuddy.Brush.Text.Primary}"
                                                   Background="{DynamicResource BusBuddy.Brush.Surface.Medium}"
                                                   Padding="3,1"
                                                   Margin="-10,2,0,0"
                                                   Visibility="{Binding DataContext.ShowDetailLabels, RelativeSource={RelativeSource AncestorType={x:Type local:MapView}}, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    </StackPanel>
                                </DataTemplate>
                                <utils:MapMarkerTemplateSelector x:Key="DistrictMarkerTemplateSelector"
                                                                 SchoolTemplate="{StaticResource SchoolMarkerTemplate}"
                                                                 HomeTemplate="{StaticResource HomeMarkerTemplate}"
                                                                 StopTemplate="{StaticResource StopMarkerTemplate}"/>
                            </Grid.Resources>
                            <!--
                                SfMap — Map Tiles API (Google) when session ready; OSM fail-open via GetUri.
                                Camera is Center + ZoomLevel only. Do not bind ImageryLayer.Radius: it doubles the
                                bounds before solving zoom and re-fits on every SizeChanged, overriding user zoom.
                            -->
                            <maps:SfMap x:Name="GeoMap"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        IsHitTestVisible="True"
                                        EnableZoom="True"
                                        EnablePan="True"
                                        IsManipulationEnabled="True"
                                        MinZoom="1"
                                        MaxZoom="19"
                                        ZoomLevel="{Binding MapZoomLevel, Mode=TwoWay}"
                                        SizeChanged="GeoMap_SizeChanged">
                                <maps:SfMap.Layers>
                                    <utils:GoogleMapTilesImageryLayer x:Name="DistrictImageryLayer"
                                                       LayerType="OSM"
                                                       Center="{Binding MapCenter, Mode=TwoWay}"
                                                       Markers="{Binding MapMarkers}"
                                                       MarkerTemplateSelector="{StaticResource DistrictMarkerTemplateSelector}">
                                        <maps:ImageryLayer.SubShapeFileLayers>
                                            <maps:SubShapeFileLayer x:Name="RouteTrailLayer">
                                                <maps:SubShapeFileLayer.MapElements>
                                                    <maps:MapPolyline x:Name="RouteTrail"
                                                                      Stroke="Gold"
                                                                      StrokeThickness="3"/>
                                                </maps:SubShapeFileLayer.MapElements>
                                            </maps:SubShapeFileLayer>
                                        </maps:ImageryLayer.SubShapeFileLayers>
                                    </utils:GoogleMapTilesImageryLayer>
                                </maps:SfMap.Layers>
                            </maps:SfMap>

                            <!-- Map Loading — SfBusyIndicator pattern per docs: https://help.syncfusion.com/wpf/busy-indicator/getting-started -->
                            <Border x:Name="MapLoadingIndicator"
                                    Background="{DynamicResource BusBuddy.Brush.Panel.Background}"
                                    Opacity="0.95"
                                    Visibility="{Binding IsMapLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <syncfusion:SfBusyIndicator Grid.Row="0"
                                                               Width="80" Height="80"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               AnimationType="Flight"/>
                                    <TextBlock Grid.Row="1"
                                               Text="Loading Map..."
                                               Margin="0,12,0,0"
                                               FontSize="16"
                                               Foreground="{DynamicResource BusBuddy.Brush.Text.Primary}"
                                               HorizontalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Map Overlay Controls — ButtonAdv Label captions (Content is ignored by Syncfusion) -->
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Margin="32,32,32,0">
                        <Button Content="Zoom In"
                                Style="{StaticResource MapOverlayWpfButtonStyle}"
                                ToolTip="Zoom in"
                                AutomationProperties.Name="Zoom In"
                                Command="{Binding ZoomInCommand}"/>
                        <Button Content="Zoom Out"
                                Style="{StaticResource MapOverlayWpfButtonStyle}"
                                ToolTip="Zoom out"
                                AutomationProperties.Name="Zoom Out"
                                Command="{Binding ZoomOutCommand}"/>
                        <syncfusion:ButtonAdv Label="Home"
                                              Style="{StaticResource MapOverlayButtonStyle}"
                                              ToolTip="Reset map view"
                                              AutomationProperties.Name="Reset Map View"
                                              Command="{Binding ResetViewCommand}"
                                              Background="{DynamicResource ButtonBackgroundBrush}"
                                              Foreground="{DynamicResource ButtonForegroundBrush}"/>
                        <syncfusion:ButtonAdv Label="Refresh"
                                              Style="{StaticResource MapOverlayButtonStyle}"
                                              ToolTip="Refresh Map"
                                              AutomationProperties.Name="Refresh Map"
                                              Command="{Binding RefreshMapCommand}"
                                              Background="{DynamicResource ButtonBackgroundBrush}"
                                              Foreground="{DynamicResource ButtonForegroundBrush}"
                                              Margin="8,0,0,0"/>
                        <syncfusion:ButtonAdv Label="Print"
                                              Style="{StaticResource MapOverlayButtonStyle}"
                                              ToolTip="Print Route Map"
                                              AutomationProperties.Name="Print Route Map"
                                              Command="{Binding PrintRouteMapsCommand}"
                                              Background="{DynamicResource ButtonBackgroundBrush}"
                                              Foreground="{DynamicResource ButtonForegroundBrush}"
                                              Margin="8,0,0,0"/>
                    </StackPanel>

                    <!-- Map attribution — Google Maps required when Google tiles / content are shown -->
                    <Border x:Name="MapAttribution"
                            Background="{DynamicResource BusBuddy.Brush.Panel.Header}"
                            Opacity="0.85"
                            CornerRadius="4"
                            Padding="6,2"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Margin="0,0,24,16"
                            Visibility="Collapsed">
                        <TextBlock x:Name="MapAttributionText"
                                   Text="© OpenStreetMap contributors"
                                   FontSize="12"
                                   Foreground="{DynamicResource BusBuddy.Brush.Text.Secondary}"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
