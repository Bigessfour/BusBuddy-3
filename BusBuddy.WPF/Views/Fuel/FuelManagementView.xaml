<UserControl x:Class="BusBuddy.WPF.Views.Fuel.FuelManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
             xmlns:converters="clr-namespace:BusBuddy.WPF.Converters"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="1000"
             Background="{DynamicResource ContentBackgroundBrush}"
             PreviewKeyDown="FuelManagementView_PreviewKeyDown">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BusBuddy.WPF;component/Resources/SyncfusionV30_Validated_ResourceDictionary.xaml"/>
                <ResourceDictionary Source="/BusBuddy.WPF;component/Resources/ButtonAdvTextOnly.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
            <converters:BooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" IsInverted="True"/>
            <Style x:Key="FuelToolbarButton" TargetType="syncfusion:ButtonAdv">
                <Setter Property="SizeMode" Value="Normal"/>
                <Setter Property="IconWidth" Value="0"/>
                <Setter Property="IconHeight" Value="0"/>
                <Setter Property="SmallIcon" Value="{x:Null}"/>
                <Setter Property="Padding" Value="14,8"/>
                <Setter Property="Margin" Value="0,4,16,4"/>
                <Setter Property="MinHeight" Value="36"/>
                <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundBrush}"/>
            </Style>
            <Style x:Key="FuelPrimaryButton" TargetType="syncfusion:ButtonAdv" BasedOn="{StaticResource FuelToolbarButton}">
                <Setter Property="Background" Value="{DynamicResource BusBuddy.Brush.Primary}"/>
                <Setter Property="Foreground" Value="{DynamicResource BusBuddy.Brush.Text.OnPrimary}"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource BusBuddy.Brush.Primary}"
                CornerRadius="6" Padding="16" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE945;" FontFamily="Segoe MDL2 Assets" FontSize="24"
                           Foreground="{DynamicResource BusBuddy.Brush.Text.OnPrimary}"
                           VerticalAlignment="Center" Margin="0,0,12,0"/>
                <TextBlock Text="Fuel Management" FontSize="22" FontWeight="Bold"
                           Foreground="{DynamicResource BusBuddy.Brush.Text.OnPrimary}"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Background="{DynamicResource BusBuddy.Brush.Panel.Header}"
                CornerRadius="4" Padding="12" Margin="0,0,0,12">
            <WrapPanel Orientation="Horizontal">
                <syncfusion:ButtonAdv Label="Add Record" Command="{Binding AddCommand}"
                                      Style="{StaticResource FuelPrimaryButton}"
                                      SizeMode="Normal" IconWidth="0" IconHeight="0"
                                      AutomationProperties.Name="Add fuel record"
                                      ToolTip="Add a new fuel fill-up"/>
                <syncfusion:ButtonAdv Label="Edit" Command="{Binding EditCommand}"
                                      Style="{StaticResource FuelToolbarButton}"
                                      SizeMode="Normal" IconWidth="0" IconHeight="0"
                                      AutomationProperties.Name="Edit fuel record"
                                      ToolTip="Edit the selected fuel record"/>
                <syncfusion:ButtonAdv Label="Delete" Command="{Binding DeleteCommand}"
                                      Style="{StaticResource FuelToolbarButton}"
                                      SizeMode="Normal" IconWidth="0" IconHeight="0"
                                      AutomationProperties.Name="Delete fuel record"
                                      ToolTip="Delete the selected fuel record"/>
                <Separator Margin="8,4,16,4"/>
                <syncfusion:ButtonAdv Label="Export CSV" Command="{Binding ExportCommand}"
                                      Style="{StaticResource FuelToolbarButton}"
                                      SizeMode="Normal" IconWidth="0" IconHeight="0"
                                      AutomationProperties.Name="Export fuel CSV"/>
                <syncfusion:ButtonAdv Label="Reports" Command="{Binding ReportCommand}"
                                      Style="{StaticResource FuelToolbarButton}"
                                      SizeMode="Normal" IconWidth="0" IconHeight="0"
                                      AutomationProperties.Name="Open reports"
                                      ToolTip="Open the reports workspace"/>
                <syncfusion:ButtonAdv Label="Reconciliation" Command="{Binding ReconciliationCommand}"
                                      Style="{StaticResource FuelToolbarButton}"
                                      SizeMode="Normal" IconWidth="0" IconHeight="0"
                                      AutomationProperties.Name="Fuel reconciliation"/>
            </WrapPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <syncfusion:SfDataGrid x:Name="FuelDataGrid"
                                   Grid.Column="0" Margin="0,0,12,0"
                                   ItemsSource="{Binding FuelRecords}"
                                   SelectedItem="{Binding SelectedFuelRecord, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                   AutoGenerateColumns="False"
                                   AllowSorting="True"
                                   AllowFiltering="True"
                                   AllowEditing="False"
                                   SelectionMode="Single"
                                   SelectionUnit="Row"
                                   ShowRowHeader="True"
                                   GridLinesVisibility="Both"
                                   HeaderLinesVisibility="Both"
                                   ColumnSizer="Star"
                                   FontSize="15"
                                   RowHeight="40"
                                   HeaderRowHeight="44"
                                   Background="{DynamicResource BusBuddy.Brush.DataGrid.Background}"
                                   AutomationProperties.Name="Fuel records grid">
                <syncfusion:SfDataGrid.Columns>
                    <syncfusion:GridDateTimeColumn MappingName="FuelDate" HeaderText="Date" Width="120" Pattern="ShortDate"/>
                    <syncfusion:GridTextColumn MappingName="FuelLocation" HeaderText="Location" Width="140"/>
                    <syncfusion:GridTextColumn MappingName="Vehicle.BusNumber" HeaderText="Bus" Width="90"/>
                    <syncfusion:GridNumericColumn MappingName="VehicleOdometerReading" HeaderText="Odometer" Width="110"/>
                    <syncfusion:GridTextColumn MappingName="FuelType" HeaderText="Type" Width="100"/>
                    <syncfusion:GridNumericColumn MappingName="Gallons" HeaderText="Gallons" Width="100" NumberDecimalDigits="3"/>
                    <syncfusion:GridNumericColumn MappingName="PricePerGallon" HeaderText="$/Gal" Width="90" NumberDecimalDigits="3"/>
                    <syncfusion:GridNumericColumn MappingName="TotalCost" HeaderText="Total" Width="100" NumberDecimalDigits="2"/>
                    <syncfusion:GridTextColumn MappingName="Notes" HeaderText="Notes" MinimumWidth="160"/>
                </syncfusion:SfDataGrid.Columns>
            </syncfusion:SfDataGrid>

            <Border Grid.Column="1" Padding="16"
                    Background="{DynamicResource PrimaryBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Monthly fuel trend" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,12"
                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                    <Grid Grid.Row="1">
                        <syncfusion:SfChart AreaBorderThickness="0"
                                            Visibility="{Binding HasFuelTrendData, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <syncfusion:SfChart.Legend>
                                <syncfusion:ChartLegend DockPosition="Top" Orientation="Horizontal"
                                                        ToggleSeriesVisibility="True"/>
                            </syncfusion:SfChart.Legend>
                            <syncfusion:SfChart.PrimaryAxis>
                                <syncfusion:DateTimeAxis Header="Month"
                                                         LabelFormat="MMM yy"
                                                         IntervalType="Months"
                                                         Interval="1"
                                                         EdgeLabelsDrawingMode="Fit"/>
                            </syncfusion:SfChart.PrimaryAxis>
                            <syncfusion:SfChart.SecondaryAxis>
                                <syncfusion:NumericalAxis Header="Gallons"
                                                          LabelFormat="0.#"
                                                          RangePadding="Round"/>
                            </syncfusion:SfChart.SecondaryAxis>
                            <syncfusion:ColumnSeries ItemsSource="{Binding FuelTrends}"
                                                     XBindingPath="Period"
                                                     YBindingPath="TotalGallons"
                                                     Label="Gallons"
                                                     EnableAnimation="True"
                                                     ShowTooltip="True"
                                                     ListenPropertyChange="True"
                                                     Spacing="0.2">
                                <syncfusion:ColumnSeries.AdornmentsInfo>
                                    <syncfusion:ChartAdornmentInfo ShowMarker="False"
                                                                   ShowLabel="False"/>
                                </syncfusion:ColumnSeries.AdornmentsInfo>
                            </syncfusion:ColumnSeries>
                            <syncfusion:LineSeries ItemsSource="{Binding FuelTrends}"
                                                   XBindingPath="Period"
                                                   YBindingPath="AvgMPG"
                                                   Label="Avg trip MPG"
                                                   EnableAnimation="True"
                                                   ShowTooltip="True"
                                                   ListenPropertyChange="True"
                                                   ShowEmptyPoints="False"
                                                   StrokeThickness="2.5">
                                <syncfusion:LineSeries.YAxis>
                                    <syncfusion:NumericalAxis Header="Avg MPG"
                                                              OpposedPosition="True"
                                                              LabelFormat="0.0"
                                                              RangePadding="Round"/>
                                </syncfusion:LineSeries.YAxis>
                                <syncfusion:LineSeries.AdornmentsInfo>
                                    <syncfusion:ChartAdornmentInfo ShowMarker="True"
                                                                   Symbol="Ellipse"
                                                                   SymbolHeight="7"
                                                                   SymbolWidth="7"/>
                                </syncfusion:LineSeries.AdornmentsInfo>
                            </syncfusion:LineSeries>
                        </syncfusion:SfChart>
                        <TextBlock Text="{Binding FuelTrendStatus}"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                                   Margin="12"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Visibility="{Binding HasFuelTrendData, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                    </Grid>
                    <StackPanel Grid.Row="2" Orientation="Vertical" Margin="0,12,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Records: " Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <TextBlock Text="{Binding FuelRecords.Count}" FontWeight="Bold"
                                       Foreground="{DynamicResource BusBuddy.Brush.Primary}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding FuelTrendStatus}" Margin="0,4,0,0" FontSize="12"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Visibility="{Binding HasFuelTrendData, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <TextBlock Grid.Row="3" Margin="0,12,0,0" Text="{Binding StatusMessage}"
                   FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}"/>

        <Border Grid.RowSpan="4"
                Background="{DynamicResource BusBuddy.Brush.Overlay.Dim}"
                Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
            <syncfusion:SfBusyIndicator IsBusy="True" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
    </Grid>
</UserControl>
