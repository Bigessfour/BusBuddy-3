<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="BusBuddy.WPF.Views.Fuel.FuelDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
        mc:Ignorable="d"
        Title="{Binding DialogTitle}"
        Height="640"
        Width="720"
        MinHeight="560"
        MinWidth="640"
        WindowStartupLocation="CenterOwner"
        PreviewKeyDown="FuelDialog_PreviewKeyDown">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BusBuddy.WPF;component/Resources/SyncfusionV30_Validated_ResourceDictionary.xaml"/>
                <ResourceDictionary Source="/BusBuddy.WPF;component/Resources/ButtonAdvTextOnly.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="FuelFieldLabel" TargetType="TextBlock">
                <Setter Property="Margin" Value="0,0,16,0"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            </Style>
            <Style x:Key="FuelNumericField" TargetType="syncfusion:DoubleTextBox">
                <Setter Property="Height" Value="40"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Margin" Value="0,0,0,12"/>
                <Setter Property="MinValue" Value="0"/>
            </Style>
            <Style x:Key="FuelIntegerField" TargetType="syncfusion:IntegerTextBox">
                <Setter Property="Height" Value="40"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Margin" Value="0,0,0,12"/>
                <Setter Property="MinValue" Value="0"/>
            </Style>
            <Style x:Key="FuelComboField" TargetType="syncfusion:ComboBoxAdv">
                <Setter Property="Height" Value="40"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Margin" Value="0,0,0,12"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource BusBuddy.Brush.Primary}"
                CornerRadius="6" Padding="16" Margin="0,0,0,20">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE945;" FontFamily="Segoe MDL2 Assets" FontSize="22"
                           Foreground="{DynamicResource BusBuddy.Brush.Text.OnPrimary}"
                           VerticalAlignment="Center" Margin="0,0,12,0"/>
                <TextBlock Text="{Binding DialogTitle}" FontSize="20" FontWeight="Bold"
                           Foreground="{DynamicResource BusBuddy.Brush.Text.OnPrimary}"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <GroupBox Header="Trip &amp; vehicle" Padding="16" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Fuel date" Style="{StaticResource FuelFieldLabel}"/>
                        <syncfusion:SfDatePicker Grid.Row="0" Grid.Column="1" Height="40" FontSize="14" Margin="0,0,0,12"
                                                 Value="{Binding Fuel.FuelDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 AutomationProperties.Name="Fuel date"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Location" Style="{StaticResource FuelFieldLabel}"/>
                        <syncfusion:ComboBoxAdv Grid.Row="1" Grid.Column="1" Style="{StaticResource FuelComboField}"
                                                ItemsSource="{Binding FuelLocations}"
                                                SelectedItem="{Binding Fuel.FuelLocation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                AutomationProperties.Name="Fuel location"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Bus" Style="{StaticResource FuelFieldLabel}"/>
                        <syncfusion:ComboBoxAdv Grid.Row="2" Grid.Column="1" Style="{StaticResource FuelComboField}"
                                                ItemsSource="{Binding AvailableBuses}"
                                                SelectedItem="{Binding SelectedBus, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                DisplayMemberPath="BusNumber"
                                                AutomationProperties.Name="Bus"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Odometer" Style="{StaticResource FuelFieldLabel}"/>
                        <syncfusion:IntegerTextBox Grid.Row="3" Grid.Column="1" Style="{StaticResource FuelIntegerField}"
                                                   Value="{Binding Fuel.VehicleOdometerReading, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                   ValueChanged="NumericField_ValueChanged"
                                                   AutomationProperties.Name="Odometer reading"/>
                    </Grid>
                </GroupBox>

                <GroupBox Header="Fuel amounts" Padding="16" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Fuel type" Style="{StaticResource FuelFieldLabel}"/>
                        <syncfusion:ComboBoxAdv Grid.Row="0" Grid.Column="1" Style="{StaticResource FuelComboField}"
                                                ItemsSource="{Binding FuelTypes}"
                                                SelectedItem="{Binding Fuel.FuelType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                AutomationProperties.Name="Fuel type"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Gallons" Style="{StaticResource FuelFieldLabel}"/>
                        <syncfusion:DoubleTextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource FuelNumericField}"
                                                  Value="{Binding Fuel.Gallons, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  NumberDecimalDigits="3"
                                                  ValueChanged="Gallons_ValueChanged"
                                                  AutomationProperties.Name="Gallons"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Price / gallon ($)" Style="{StaticResource FuelFieldLabel}"/>
                        <syncfusion:DoubleTextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource FuelNumericField}"
                                                  Value="{Binding Fuel.PricePerGallon, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  NumberDecimalDigits="3"
                                                  ValueChanged="PricePerGallon_ValueChanged"
                                                  AutomationProperties.Name="Price per gallon"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Total cost ($)" Style="{StaticResource FuelFieldLabel}"/>
                        <syncfusion:DoubleTextBox Grid.Row="3" Grid.Column="1" Style="{StaticResource FuelNumericField}"
                                                  Value="{Binding Fuel.TotalCost, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  NumberDecimalDigits="2"
                                                  ValueChanged="TotalCost_ValueChanged"
                                                  AutomationProperties.Name="Total cost"/>

                        <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="Estimated MPG:" FontWeight="SemiBold" FontSize="14"
                                       Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <TextBlock Text="{Binding MPG, StringFormat=N2}" Margin="8,0,0,0" FontSize="14" FontWeight="Bold"
                                       Foreground="{DynamicResource BusBuddy.Brush.Primary}"/>
                        </StackPanel>
                    </Grid>
                </GroupBox>

                <GroupBox Header="Notes" Padding="16">
                    <syncfusion:SfTextBoxExt Text="{Binding Fuel.Notes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Height="96" FontSize="14"
                                             TextWrapping="Wrap" AcceptsReturn="True"
                                             VerticalScrollBarVisibility="Auto"
                                             Watermark="Optional notes for this fill-up"
                                             AutomationProperties.Name="Fuel notes"/>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <syncfusion:ButtonAdv Label="Cancel" MinWidth="120" Height="40" Margin="0,0,12,0"
                                  Click="CancelButton_Click"
                                  AutomationProperties.Name="Cancel fuel record"/>
            <syncfusion:ButtonAdv Label="Save" MinWidth="120" Height="40"
                                  Click="SaveButton_Click"
                                  IsEnabled="{Binding IsValid}"
                                  Background="{DynamicResource BusBuddy.Brush.Semantic.Success}"
                                  Foreground="{DynamicResource BusBuddy.Brush.Text.OnPrimary}"
                                  AutomationProperties.Name="Save fuel record"
                                  ToolTip="Save requires bus, location, type, and gallons &gt; 0"/>
        </StackPanel>
    </Grid>
</Window>
