<?xml version="1.0" encoding="utf-8"?>
<syncfusion:ChromelessWindow x:Class="BusBuddy.WPF.Views.Fuel.FuelReconciliationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
        xmlns:syncfusiontools="clr-namespace:Syncfusion.Windows.Tools.Controls;assembly=Syncfusion.Tools.WPF"
        xmlns:converters="clr-namespace:BusBuddy.WPF.Converters"
        mc:Ignorable="d"
        Title="Fuel Reconciliation"
        Height="700"
        Width="920"
        WindowStartupLocation="CenterOwner"
        PreviewKeyDown="FuelReconciliationDialog_PreviewKeyDown">
    <syncfusion:ChromelessWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BusBuddy.WPF;component/Resources/SyncfusionV30_Validated_ResourceDictionary.xaml"/>
                <ResourceDictionary Source="/BusBuddy.WPF;component/Resources/ButtonAdvTextOnly.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
            <converters:BooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" IsInverted="True"/>
        </ResourceDictionary>
    </syncfusion:ChromelessWindow.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource BusBuddy.Brush.Primary}"
                CornerRadius="5"
                Padding="15"
                Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE945;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                           Foreground="{DynamicResource BusBuddy.Brush.Text.OnPrimary}"
                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock FontSize="18" FontWeight="Bold"
                           Foreground="{DynamicResource BusBuddy.Brush.Text.OnPrimary}"
                           VerticalAlignment="Center"
                           Text="{Binding Title, RelativeSource={RelativeSource AncestorType=syncfusion:ChromelessWindow}}"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="Date range:" VerticalAlignment="Center" Margin="0,0,10,0"
                       Foreground="{DynamicResource BusBuddy.Brush.Text.Primary}"/>

            <syncfusion:SfDatePicker Grid.Column="1"
                        Value="{Binding StartDate, Mode=TwoWay}"
                        Width="120"
                        Margin="0,0,5,0"
                        AutomationProperties.Name="Reconciliation start date"/>

            <TextBlock Grid.Column="2" Text="to" VerticalAlignment="Center" Margin="0,0,5,0"/>

            <syncfusion:SfDatePicker Grid.Column="3"
                        Value="{Binding EndDate, Mode=TwoWay}"
                        Width="120"
                        Margin="0,0,10,0"
                        AutomationProperties.Name="Reconciliation end date"/>

            <TextBlock Grid.Column="5" Text="Location:" VerticalAlignment="Center" Margin="0,0,8,0"/>

            <syncfusion:ComboBoxAdv Grid.Column="7"
                      ItemsSource="{Binding FuelLocations}"
                      SelectedItem="{Binding SelectedLocation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      Height="40"
                      Width="180"
                      AutomationProperties.Name="Fuel location"/>
        </Grid>

        <syncfusiontools:TabControlExt Grid.Row="2">
            <syncfusiontools:TabItemExt Header="Reconciliation Summary">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Background="{DynamicResource BusBuddy.Brush.Panel.Header}"
                                BorderBrush="{DynamicResource BusBuddy.Brush.Semantic.Info}"
                                BorderThickness="3,1,1,1"
                                CornerRadius="5"
                                Margin="0,0,5,0"
                                Padding="10">
                            <StackPanel>
                                <TextBlock Text="Bulk station meter" FontWeight="Bold"
                                           Foreground="{DynamicResource BusBuddy.Brush.Text.Primary}"/>
                                <TextBlock Text="Clerk-entered for this period" FontSize="11" Margin="0,2,0,6"
                                           Foreground="{DynamicResource BusBuddy.Brush.Text.Secondary}"/>
                                <syncfusion:SfTextBoxExt Text="{Binding BulkStationGallonsText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         Height="40" FontSize="18"
                                                         AutomationProperties.Name="Bulk station gallons"/>
                                <syncfusion:ButtonAdv Label="Save reading" Command="{Binding RememberBulkCommand}"
                                                      Margin="0,8,0,0" SizeMode="Normal"
                                                      IconWidth="0" IconHeight="0"
                                                      AutomationProperties.Name="Save bulk meter reading"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1"
                                Background="{DynamicResource BusBuddy.Brush.Panel.Content}"
                                BorderBrush="{DynamicResource BusBuddy.Brush.Semantic.Warning}"
                                BorderThickness="3,1,1,1"
                                CornerRadius="5"
                                Margin="5,0"
                                Padding="10">
                            <StackPanel>
                                <TextBlock Text="Vehicle usage" FontWeight="Bold"
                                           Foreground="{DynamicResource BusBuddy.Brush.Text.Primary}"/>
                                <TextBlock Text="{Binding VehicleUsageGallons, StringFormat='{}{0:N2} gallons'}"
                                           FontSize="18"
                                           Margin="0,5,0,0"
                                           Foreground="{DynamicResource BusBuddy.Brush.Text.Primary}"/>
                                <TextBlock Text="From fuel fill-up records" FontSize="11" Margin="0,4,0,0"
                                           Foreground="{DynamicResource BusBuddy.Brush.Text.Secondary}"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2"
                                Background="{Binding DiscrepancyBackground}"
                                BorderBrush="{Binding DiscrepancyBorder}"
                                BorderThickness="3,1,1,1"
                                CornerRadius="5"
                                Margin="5,0,0,0"
                                Padding="10">
                            <StackPanel>
                                <TextBlock Text="Discrepancy" FontWeight="Bold"
                                           Foreground="{DynamicResource BusBuddy.Brush.Text.Primary}"/>
                                <TextBlock Text="{Binding DiscrepancyGallons, StringFormat='{}{0:N2} gallons'}"
                                           FontSize="18"
                                           Margin="0,5,0,0"
                                           Foreground="{Binding DiscrepancyForeground}"
                                           Visibility="{Binding HasBulkReading, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                <TextBlock Text="{Binding DiscrepancyPercentage, StringFormat='{}{0:P2}'}"
                                           FontSize="14"
                                           Foreground="{Binding DiscrepancyForeground}"
                                           Visibility="{Binding HasBulkReading, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                <TextBlock Text="Enter bulk gallons to compare"
                                           FontSize="13" Margin="0,8,0,0" TextWrapping="Wrap"
                                           Foreground="{DynamicResource BusBuddy.Brush.Text.Secondary}"
                                           Visibility="{Binding HasBulkReading, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="1">
                        <syncfusion:SfChart AreaBorderThickness="0"
                                            Visibility="{Binding HasDailyChartData, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <syncfusion:SfChart.Legend>
                                <syncfusion:ChartLegend DockPosition="Top" Orientation="Horizontal"/>
                            </syncfusion:SfChart.Legend>
                            <syncfusion:SfChart.PrimaryAxis>
                                <syncfusion:DateTimeAxis IntervalType="Days" LabelFormat="d" Header="Day"/>
                            </syncfusion:SfChart.PrimaryAxis>
                            <syncfusion:SfChart.SecondaryAxis>
                                <syncfusion:NumericalAxis Header="Gallons" LabelFormat="0.#"/>
                            </syncfusion:SfChart.SecondaryAxis>

                            <syncfusion:ColumnSeries ItemsSource="{Binding DailyReconciliation}"
                                                   XBindingPath="Date"
                                                   YBindingPath="VehicleUsageGallons"
                                                   Label="Vehicle usage"
                                                   EnableAnimation="True"
                                                   ShowTooltip="True"/>
                        </syncfusion:SfChart>
                        <TextBlock Text="No fill-ups in this date range."
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource BusBuddy.Brush.Text.Secondary}"
                                   Visibility="{Binding HasDailyChartData, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                    </Grid>

                    <TextBlock Grid.Row="2"
                               Text="{Binding ReconciliationSummary}"
                               TextWrapping="Wrap"
                               Margin="0,10,0,0"
                               Foreground="{DynamicResource BusBuddy.Brush.Text.Primary}"/>
                </Grid>
            </syncfusiontools:TabItemExt>

            <syncfusiontools:TabItemExt Header="Fill-ups to verify">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Shown when clerk-entered bulk gallons differ from vehicle logs by more than 3%."
                               FontWeight="SemiBold"
                               Margin="0,0,0,10"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource BusBuddy.Brush.Text.Primary}"/>

                    <syncfusion:SfDataGrid Grid.Row="1"
                                           ItemsSource="{Binding DiscrepancyDetails}"
                                           AutoGenerateColumns="False"
                                           AllowEditing="False"
                                           AllowFiltering="True"
                                           AllowSorting="True"
                                           AutomationProperties.Name="Fill-ups to verify">
                        <syncfusion:SfDataGrid.Columns>
                            <syncfusion:GridDateTimeColumn MappingName="Date" HeaderText="Date" Width="110" Pattern="ShortDate"/>
                            <syncfusion:GridTextColumn MappingName="BusNumber" HeaderText="Bus" Width="90"/>
                            <syncfusion:GridNumericColumn MappingName="GallonsReported" HeaderText="Gallons" Width="100" NumberDecimalDigits="2"/>
                            <syncfusion:GridNumericColumn MappingName="OdometerReading" HeaderText="Odometer" Width="100"/>
                            <syncfusion:GridTextColumn MappingName="DiscrepancyType" HeaderText="Type" Width="120"/>
                            <syncfusion:GridTextColumn MappingName="PotentialIssue" HeaderText="Potential issue" MinimumWidth="180"/>
                            <syncfusion:GridTextColumn MappingName="RecommendedAction" HeaderText="Recommended action" MinimumWidth="180"/>
                        </syncfusion:SfDataGrid.Columns>
                    </syncfusion:SfDataGrid>
                </Grid>
            </syncfusiontools:TabItemExt>
        </syncfusiontools:TabControlExt>

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,15,0,0">
            <syncfusion:ButtonAdv Label="Export report"
                    Command="{Binding ExportCommand}"
                    MinWidth="120"
                    Margin="0,0,10,0"
                    SizeMode="Normal" IconWidth="0" IconHeight="0"
                    AutomationProperties.Name="Export fuel report"/>
            <syncfusion:ButtonAdv Label="Close"
                    Command="{Binding CloseCommand}"
                    MinWidth="80"
                    SizeMode="Normal" IconWidth="0" IconHeight="0"
                    AutomationProperties.Name="Close reconciliation"/>
        </StackPanel>

        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Left"
                    Margin="0,15,0,0">
            <TextBlock Foreground="{DynamicResource BusBuddy.Brush.Text.Secondary}">
                <Run Text="Last saved reconciliation: "/>
                <Run Text="{Binding LastReconciliationDate, Mode=OneWay, StringFormat=d, TargetNullValue=Never}"/>
            </TextBlock>
        </StackPanel>
    </Grid>
</syncfusion:ChromelessWindow>
