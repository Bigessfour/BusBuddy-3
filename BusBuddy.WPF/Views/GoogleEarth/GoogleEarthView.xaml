<!--
    Google Earth Integration View
    Syncfusion WPF 34.x via SfSkinManager (FluentDark primary, FluentLight fallback).
    Prefer BusBuddy.Brush.* tokens; ButtonAdv must use Label (Content is ignored).
    Docs: ButtonAdv Label, ComboBoxAdv, SfBusyIndicator, SfDataGrid, SfSkinManager / SfMaps.
-->
<UserControl x:Class="BusBuddy.WPF.Views.GoogleEarth.GoogleEarthView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
             xmlns:maps="clr-namespace:Syncfusion.UI.Xaml.Maps;assembly=Syncfusion.SfMaps.WPF"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:BusBuddy.WPF.Views.GoogleEarth"
             xmlns:viewModels="clr-namespace:BusBuddy.WPF.ViewModels.GoogleEarth"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1200"
             d:DataContext="{d:DesignInstance viewModels:GoogleEarthViewModel}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BusBuddy.WPF;component/Resources/SyncfusionV30_Validated_ResourceDictionary.xaml"/>
                <ResourceDictionary Source="/BusBuddy.WPF;component/Resources/ButtonAdvTextOnly.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style TargetType="syncfusion:ButtonAdv" BasedOn="{StaticResource {x:Type syncfusion:ButtonAdv}}">
                <Setter Property="Padding" Value="10,6"/>
            </Style>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{DynamicResource PrimaryBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

    <!-- Header — Title, status, and layer selector (same tokens as MainWindow / Route Management) -->
    <Border Grid.Row="0"
        Background="{DynamicResource BusBuddy.Brush.Header.Background}"
                Padding="24,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Border Background="{DynamicResource BusBuddy.Brush.Primary}"
                            Width="48" Height="48"
                            CornerRadius="24"
                            Margin="0,0,16,0">
                        <TextBlock Text="&#xE909;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="24"
                                   Foreground="{DynamicResource BusBuddy.Brush.Text.OnPrimary}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Google Earth Integration"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource BusBuddy.Brush.Text.Primary}"/>
                        <TextBlock Text="Advanced Geospatial Mapping and Route Visualization"
                                   FontSize="14"
                                   Foreground="{DynamicResource BusBuddy.Brush.Text.Secondary}"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Background="{DynamicResource BusBuddy.Brush.Surface.Medium}"
                            CornerRadius="16"
                            Padding="12,6"
                            Margin="8,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="10" Height="10"
                                                                         Fill="{DynamicResource BusBuddy.Brush.Semantic.Success}"
                                     VerticalAlignment="Center"
                                     Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding StatusMessage}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       MaxWidth="280"
                                       TextTrimming="CharacterEllipsis"
                                                                             Foreground="{DynamicResource BusBuddy.Brush.Text.Primary}"/>
                        </StackPanel>
                    </Border>

                    <!-- Layer selector — values map to InitializeMapLayer(..) via MapLayerComboBox_SelectionChanged -->
                    <syncfusion:ComboBoxAdv x:Name="MapLayerComboBox"
                                            Width="150"
                                            Height="32"
                                            Margin="16,0"
                                            SelectedIndex="0"
                                            SelectionChanged="MapLayerComboBox_SelectionChanged"
                                            ToolTip="Map tile layer"
                                            AutomationProperties.Name="Map layer">
                        <syncfusion:ComboBoxItemAdv Content="OpenStreetMap"/>
                    </syncfusion:ComboBoxAdv>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Control Panel — Commands bind to GoogleEarthViewModel (CenterOnFleet, ShowAllBuses, ShowRoutes, ShowSchools) -->
    <Border Grid.Column="0"
            Background="{DynamicResource PrimaryBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Padding="16">
                    <StackPanel>
                        <!-- Map Controls — Syncfusion ButtonAdv used per documented API: https://help.syncfusion.com/cr/wpf/Syncfusion.Windows.Tools.Controls.ButtonAdv.html -->
            <Border Background="{DynamicResource PrimaryBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16"
                                Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Map Controls"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                       Foreground="{DynamicResource PrimaryTextBrush}"
                                           Margin="0,0,0,12"/>

                <syncfusion:ButtonAdv Label="Center on Fleet"
                              AutomationProperties.Name="Center on Fleet"
                              ToolTip="Center map on fleet"
                              Command="{Binding CenterOnFleetCommand}"
                              Background="{DynamicResource ButtonBackgroundBrush}"
                              Foreground="{DynamicResource ButtonForegroundBrush}"
                              Padding="10,8"
                              Margin="0,4"
                              HorizontalAlignment="Stretch"/>

                <syncfusion:ButtonAdv Label="Show All Buses"
                              AutomationProperties.Name="Show All Buses"
                              ToolTip="Show all active buses"
                              Command="{Binding ShowAllBusesCommand}"
                              Background="{DynamicResource ButtonBackgroundBrush}"
                              Foreground="{DynamicResource ButtonForegroundBrush}"
                              Padding="10,8"
                              Margin="0,4"
                              HorizontalAlignment="Stretch"/>

                <TextBlock Text="Map Layers &amp; Overlays" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,4"/>
                <syncfusion:ButtonAdv Label="Show Routes"
                              AutomationProperties.Name="Show Routes"
                              ToolTip="Toggle route overlays"
                              Command="{Binding ShowRoutesCommand}"
                              Background="{DynamicResource ButtonBackgroundBrush}"
                              Foreground="{DynamicResource ButtonForegroundBrush}"
                              Padding="10,8"
                              Margin="0,4"
                              HorizontalAlignment="Stretch"/>

                <syncfusion:ButtonAdv Label="Show Schools"
                              AutomationProperties.Name="Show Schools"
                              ToolTip="Show school destinations"
                              Command="{Binding ShowSchoolsCommand}"
                              Background="{DynamicResource ButtonBackgroundBrush}"
                              Foreground="{DynamicResource ButtonForegroundBrush}"
                              Padding="10,8"
                              Margin="0,4"
                              HorizontalAlignment="Stretch"/>

                <!-- MVP demo: Add a stop marker (plots coordinates near Wiley). Uses AddMarkerCommand with "lat,lon,label" string parameter -->
                <TextBlock Text="Markers" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,12,0,4"/>
                <syncfusion:ButtonAdv Label="Add Stop (Demo)"
                              AutomationProperties.Name="Add Demo Stop"
                              ToolTip="Plot a demo stop near Wiley"
                              Command="{Binding AddMarkerCommand}"
                              CommandParameter="38.1530,-102.7200,Demo Stop"
                              Background="{DynamicResource ButtonBackgroundBrush}"
                              Foreground="{DynamicResource ButtonForegroundBrush}"
                              Padding="10,8"
                              Margin="0,4"
                              HorizontalAlignment="Stretch"/>

                <TextBlock Text="Eligibility" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,12,0,4"/>
                <!-- SfDataGrid for eligibility / stops / buses (Finish GoogleEarth UI element; Syncfusion Sf* only + RAG cited components) -->
                <syncfusion:SfDataGrid ItemsSource="{Binding ActiveBuses}" AutoGenerateColumns="False" Height="90" Margin="0,4,0,8"
                                       AllowFiltering="True" ColumnSizer="Star">
                    <syncfusion:SfDataGrid.Columns>
                        <syncfusion:GridTextColumn HeaderText="Bus" MappingName="BusNumber" Width="70"/>
                        <syncfusion:GridTextColumn HeaderText="Status" MappingName="Status"/>
                        <syncfusion:GridTextColumn HeaderText="Location" MappingName="CurrentLocation" Width="90"/>
                    </syncfusion:SfDataGrid.Columns>
                </syncfusion:SfDataGrid>
                <syncfusion:ButtonAdv Label="Check Eligibility (Demo)"
                              AutomationProperties.Name="Check Eligibility Demo"
                              ToolTip="Run eligibility check demo"
                              Command="{Binding CheckEligibilityCommand}"
                              Background="{DynamicResource ButtonBackgroundBrush}"
                              Foreground="{DynamicResource ButtonForegroundBrush}"
                              Padding="10,8"
                              Margin="0,8,0,0"
                              HorizontalAlignment="Stretch"/>

                    <!-- Bulk plot rural eligible students (auto geocode + eligibility filter) -->
                    <syncfusion:ButtonAdv Label="Bulk Plot Eligible Students"
                                          ToolTip="Auto-geocode + plot all rural (non-Lamar, out-of-town) eligible students"
                                          Command="{Binding BulkPlotEligibleStudentsCommand}"
                                          AutomationProperties.Name="Bulk Plot Eligible Students"
                                          Background="{DynamicResource ButtonBackgroundBrush}"
                                          Foreground="{DynamicResource ButtonForegroundBrush}"
                                          Padding="10,8"
                                          Margin="0,4,0,0"
                                          HorizontalAlignment="Stretch"/>

                <!-- Generate Eligibility Route PDF (auto-build pseudo route) -->
                <syncfusion:ButtonAdv Label="Generate Eligibility PDF"
                              AutomationProperties.Name="Generate Eligibility PDF"
                              ToolTip="Generate eligibility route PDF"
                              Command="{Binding GenerateEligibilityRoutePdfCommand}"
                              Background="{DynamicResource ButtonBackgroundBrush}"
                              Foreground="{DynamicResource ButtonForegroundBrush}"
                              Padding="10,8"
                              Margin="0,4,0,0"
                              HorizontalAlignment="Stretch"/>
                            </StackPanel>
                        </Border>

                        <!-- Live Tracking — ButtonAdv toggle documented here: https://help.syncfusion.com/wpf/button/toggle-state -->
            <Border Background="{DynamicResource PrimaryBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16"
                                Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Live Tracking"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                       Foreground="{DynamicResource PrimaryTextBrush}"
                                           Margin="0,0,0,12"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="Real-time Updates"
                                               FontSize="14"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               VerticalAlignment="Center"/>

                                    <!-- Use documented ButtonAdv toggle: https://help.syncfusion.com/wpf/button/toggle-state -->
                                    <syncfusion:ButtonAdv Grid.Column="1"
                                                          MinWidth="80"
                                                          Height="28"
                                                          HorizontalAlignment="Right"
                                                          Background="{DynamicResource ButtonBackgroundBrush}"
                                                          Foreground="{DynamicResource ButtonForegroundBrush}"
                                                          IsCheckable="True"
                                                          IsChecked="{Binding IsLiveTrackingEnabled, Mode=TwoWay}"
                                                          Label="Live"
                                                          ToolTip="Enable real-time bus position updates"
                                                          AutomationProperties.Name="Live tracking"/>
                                </Grid>

                                <!-- Theme standard Separator via SfSkinManager key -->
                                <Separator Margin="0,8" Style="{DynamicResource WPFSeparatorStyle}"/>

                                <TextBlock Text="Update Frequency"
                                           FontSize="12"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           Margin="0,0,0,4"/>

                                <syncfusion:ComboBoxAdv SelectedIndex="{Binding TrackingIntervalIndex, Mode=TwoWay}"
                                                        ToolTip="How often live tracking refreshes"
                                                        AutomationProperties.Name="Tracking update frequency">
                                    <syncfusion:ComboBoxItemAdv Content="5 seconds"/>
                                    <syncfusion:ComboBoxItemAdv Content="10 seconds"/>
                                    <syncfusion:ComboBoxItemAdv Content="30 seconds"/>
                                    <syncfusion:ComboBoxItemAdv Content="1 minute"/>
                                </syncfusion:ComboBoxAdv>
                            </StackPanel>
                        </Border>

                        <!-- District Boundary Overlay Toggle — uses Syncfusion ButtonAdv toggle per docs: https://help.syncfusion.com/wpf/button/toggle-state -->
            <Border Background="{DynamicResource PrimaryBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16"
                                Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="Overlays"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                       Foreground="{DynamicResource PrimaryTextBrush}"
                                           Margin="0,0,0,12"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="School District Boundary"
                                               FontSize="14"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               VerticalAlignment="Center"/>

                                    <syncfusion:ButtonAdv Grid.Column="1"
                                                          MinWidth="80"
                                                          Height="28"
                                                          HorizontalAlignment="Right"
                                                          Background="{DynamicResource ButtonBackgroundBrush}"
                                                          Foreground="{DynamicResource ButtonForegroundBrush}"
                                                          IsCheckable="True"
                                                          IsChecked="{Binding DistrictBoundaryVisible, Mode=TwoWay}"
                                                          Label="Show"
                                                          ToolTip="Toggle school district boundary overlay"
                                                          AutomationProperties.Name="Show district boundary"/>
                                </Grid>

                                <!-- Wiley Town Boundary Toggle — to visualize exclusion zone inside district for eligibility -->
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="Wiley Town Boundary"
                                               FontSize="14"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               VerticalAlignment="Center"/>

                                    <syncfusion:ButtonAdv Grid.Column="1"
                                                          MinWidth="80"
                                                          Height="28"
                                                          HorizontalAlignment="Right"
                                                          Background="{DynamicResource ButtonBackgroundBrush}"
                                                          Foreground="{DynamicResource ButtonForegroundBrush}"
                                                          IsCheckable="True"
                                                          IsChecked="{Binding TownBoundaryVisible, Mode=TwoWay}"
                                                          Label="Show"
                                                          ToolTip="Toggle Wiley town boundary overlay"
                                                          AutomationProperties.Name="Show town boundary"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Bus List — SfDataGrid usage follows Getting Started: https://help.syncfusion.com/wpf/datagrid/getting-started -->
            <Border Background="{DynamicResource PrimaryBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16">
                            <StackPanel>
                                <TextBlock Text="Active Buses"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                       Foreground="{DynamicResource PrimaryTextBrush}"
                                           Margin="0,0,0,12"/>

                                <syncfusion:SfDataGrid x:Name="BusListGrid"
                                                       ItemsSource="{Binding ActiveBuses}"
                                                       SelectedItem="{Binding SelectedBus}"
                                                       Height="200"
                                                       AutoGenerateColumns="False"
                                                       AllowEditing="False"
                                                       AllowSorting="True"
                                                       AllowFiltering="False"
                                                       SelectionMode="Single"
                                                       GridLinesVisibility="Both"
                                                          HeaderLinesVisibility="Both">
                                    <syncfusion:SfDataGrid.Columns>
                                        <syncfusion:GridTextColumn HeaderText="Bus #"
                                                                   MappingName="BusNumber"
                                                                   Width="60"/>
                                        <syncfusion:GridTextColumn HeaderText="Route"
                                                                   MappingName="RouteNumber"
                                                                   Width="60"/>
                                        <syncfusion:GridTextColumn HeaderText="Status"
                                                                   MappingName="Status"
                                                                   Width="80"/>
                                    </syncfusion:SfDataGrid.Columns>
                                </syncfusion:SfDataGrid>

                                <syncfusion:ButtonAdv Label="Track Selected"
                                                      AutomationProperties.Name="Track Selected Bus"
                                                      ToolTip="Track the selected bus on the map"
                                                      Command="{Binding TrackSelectedBusCommand}"
                                                      Background="{DynamicResource ButtonBackgroundBrush}"
                                                      Foreground="{DynamicResource ButtonForegroundBrush}"
                                                      Padding="10,8"
                                                      Margin="0,8,0,0"
                                                      HorizontalAlignment="Stretch"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Map Display Area -->
    <Border Grid.Column="1"
            Background="{DynamicResource PrimaryBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    Margin="0"
                    MinHeight="400">
                <Grid>
                    <!-- Map Container — Main SfMap host with zoom/pan enabled per docs: https://help.syncfusion.com/wpf/maps/getting-started -->
            <Border x:Name="MapContainer"
                Background="{DynamicResource ContentBackgroundBrush}"
                            CornerRadius="8"
                            Margin="16"
                            MinHeight="400">
                        <Grid>
                            <Grid.Resources>
                                <!-- Simple marker template (pin image could be added later) -->
                                <DataTemplate x:Key="StudentMarkerTemplate">
                                    <StackPanel Orientation="Vertical" Margin="-8,-24,0,0">
                                        <Ellipse Width="12" Height="12" Fill="{DynamicResource BusBuddy.Brush.Semantic.Error}" Stroke="{DynamicResource BusBuddy.Brush.Text.Primary}" StrokeThickness="1"/>
                                        <TextBlock Text="{Binding Label}" FontSize="11" Foreground="{DynamicResource BusBuddy.Brush.Text.Primary}" Background="#AA2B2B2B" Padding="4,1" Margin="-12,2,0,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </Grid.Resources>
                            <!-- SfMap — per official docs: https://help.syncfusion.com/wpf/maps/getting-started -->
                            <maps:SfMap x:Name="GeoMap"
                                        EnableZoom="True"
                                        EnablePan="True"
                                        ZoomLevel="13" />

                            <!-- Map Loading — SfBusyIndicator pattern per docs: https://help.syncfusion.com/wpf/busy-indicator/getting-started -->
                            <Border x:Name="MapLoadingIndicator"
                                    Background="{DynamicResource BusBuddy.Brush.Panel.Background}"
                                    Opacity="0.95"
                                    Visibility="{Binding IsMapLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <syncfusion:SfBusyIndicator Grid.Row="0"
                                                               Width="80" Height="80"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               AnimationType="Flight"/>
                                    <TextBlock Grid.Row="1"
                                               Text="Loading Map..."
                                               Margin="0,12,0,0"
                                               FontSize="16"
                                               Foreground="{DynamicResource BusBuddy.Brush.Text.Primary}"
                                               HorizontalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Map Overlay Controls — ButtonAdv Label captions (Content is ignored by Syncfusion) -->
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Margin="32,32,32,0">
                        <syncfusion:ButtonAdv Label="+"
                                              ToolTip="Zoom In"
                                              AutomationProperties.Name="Zoom In"
                                              Command="{Binding ZoomInCommand}"
                                              Background="{DynamicResource ButtonBackgroundBrush}"
                                              Foreground="{DynamicResource ButtonForegroundBrush}"
                                              Width="44" Height="40"
                                              FontSize="18"
                                              FontWeight="Bold"
                                              SizeMode="Normal"
                                              Margin="4,0"/>
                        <syncfusion:ButtonAdv Label="-"
                                              ToolTip="Zoom Out"
                                              AutomationProperties.Name="Zoom Out"
                                              Command="{Binding ZoomOutCommand}"
                                              Background="{DynamicResource ButtonBackgroundBrush}"
                                              Foreground="{DynamicResource ButtonForegroundBrush}"
                                              Width="44" Height="40"
                                              FontSize="18"
                                              FontWeight="Bold"
                                              SizeMode="Normal"
                                              Margin="4,0"/>
                        <syncfusion:ButtonAdv Label="Home"
                                              ToolTip="Reset map view"
                                              AutomationProperties.Name="Reset Map View"
                                              Command="{Binding ResetViewCommand}"
                                              Background="{DynamicResource ButtonBackgroundBrush}"
                                              Foreground="{DynamicResource ButtonForegroundBrush}"
                                              Height="40"
                                              Padding="10,8"
                                              SizeMode="Normal"
                                              Margin="4,0"/>
                        <syncfusion:ButtonAdv Label="Refresh"
                                              ToolTip="Refresh Map"
                                              AutomationProperties.Name="Refresh Map"
                                              Command="{Binding RefreshMapCommand}"
                                              Background="{DynamicResource ButtonBackgroundBrush}"
                                              Foreground="{DynamicResource ButtonForegroundBrush}"
                                              Height="40"
                                              Padding="10,8"
                                              SizeMode="Normal"
                                              Margin="8,0,0,0"/>
                        <syncfusion:ButtonAdv Label="Print"
                                              ToolTip="Print Route Map"
                                              AutomationProperties.Name="Print Route Map"
                                              Command="{Binding PrintRouteMapsCommand}"
                                              Background="{DynamicResource ButtonBackgroundBrush}"
                                              Foreground="{DynamicResource ButtonForegroundBrush}"
                                              Height="40"
                                              Padding="10,8"
                                              SizeMode="Normal"
                                              Margin="8,0,0,0"/>
                    </StackPanel>

                    <!-- OSM Attribution — Visibility toggled from code-behind (ToggleOsmAttribution) when OpenStreetMap is active -->
                    <Border x:Name="OsmAttribution"
                            Background="{DynamicResource BusBuddy.Brush.Panel.Header}"
                            Opacity="0.85"
                            CornerRadius="4"
                            Padding="6,2"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Margin="0,0,24,16"
                            Visibility="Collapsed">
                        <TextBlock Text="© OpenStreetMap contributors"
                                   FontSize="11"
                                   Foreground="{DynamicResource BusBuddy.Brush.Text.Secondary}"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
