<UserControl x:Class="BusBuddy.WPF.Views.Settings.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
             xmlns:controls="clr-namespace:BusBuddy.WPF.Controls"
             Background="{DynamicResource ContentBackgroundBrush}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BusBuddy.WPF;component/Resources/SyncfusionV30_Validated_ResourceDictionary.xaml"/>
                <ResourceDictionary Source="/BusBuddy.WPF;component/Resources/ButtonAdvTextOnly.xaml"/>
                <ResourceDictionary Source="/BusBuddy.WPF;component/Resources/BusBuddyInputStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="SettingsToolbarButton" TargetType="syncfusion:ButtonAdv">
                <Setter Property="SizeMode" Value="Normal"/>
                <Setter Property="IconWidth" Value="0"/>
                <Setter Property="IconHeight" Value="0"/>
                <Setter Property="SmallIcon" Value="{x:Null}"/>
                <Setter Property="Padding" Value="12,8"/>
                <Setter Property="Margin" Value="0,0,8,0"/>
                <Setter Property="FontWeight" Value="Medium"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundBrush}"/>
            </Style>

            <Style x:Key="SettingsPrimaryButton" TargetType="syncfusion:ButtonAdv" BasedOn="{StaticResource SettingsToolbarButton}">
                <Setter Property="Background" Value="{DynamicResource BusBuddy.Brush.Primary}"/>
                <Setter Property="Foreground" Value="{DynamicResource BusBuddy.Brush.Text.OnPrimary}"/>
            </Style>

            <Style x:Key="SettingsSectionHeader" TargetType="TextBlock">
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{DynamicResource BusBuddy.Brush.Text.Primary}"/>
                <Setter Property="Margin" Value="0,0,0,8"/>
            </Style>

            <Style x:Key="SettingsFieldLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{DynamicResource BusBuddy.Brush.Text.Primary}"/>
                <Setter Property="Margin" Value="0,0,0,6"/>
            </Style>

            <Style x:Key="SettingsHelpText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Foreground" Value="{DynamicResource BusBuddy.Brush.Text.Secondary}"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="Margin" Value="0,0,0,12"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource BusBuddy.Brush.Primary}"
                CornerRadius="5" Padding="15" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="24"
                           Foreground="{DynamicResource BusBuddy.Brush.Text.OnPrimary}"
                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Text="Application Settings" FontSize="20" FontWeight="Bold"
                           Foreground="{DynamicResource BusBuddy.Brush.Text.OnPrimary}"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Background="{DynamicResource BusBuddy.Brush.Surface.Light}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="8" Padding="24">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="640" HorizontalAlignment="Left">
                <StackPanel.Resources>
                    <Style x:Key="SettingsFieldInput" TargetType="syncfusion:SfTextBoxExt">
                        <Setter Property="Height" Value="40"/>
                        <Setter Property="Padding" Value="8,5"/>
                        <Setter Property="Margin" Value="0,0,0,10"/>
                        <Setter Property="HorizontalAlignment" Value="Stretch"/>
                    </Style>
                </StackPanel.Resources>
                <TextBlock Text="Appearance" Style="{StaticResource SettingsSectionHeader}"/>
                <TextBlock Text="Choose the Fluent theme applied across BusBuddy windows."
                           Style="{StaticResource SettingsHelpText}"/>
                <TextBlock x:Name="ThemeLabel" Text="Theme" Style="{StaticResource SettingsFieldLabel}"/>
                <syncfusion:ComboBoxAdv ItemsSource="{Binding AvailableThemes}"
                                        SelectedItem="{Binding SelectedTheme, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        IsEditable="False"
                                        HorizontalAlignment="Stretch"
                                        Height="42"
                                        AutomationProperties.Name="Application theme"
                                        AutomationProperties.LabeledBy="{Binding ElementName=ThemeLabel}"/>

                <TextBlock Text="Startup &amp; logging" Style="{StaticResource SettingsSectionHeader}" Margin="0,16,0,8"/>
                <TextBlock Text="Control whether the dashboard opens when the app starts and whether user actions are written to the activity log."
                           Style="{StaticResource SettingsHelpText}"/>

                <CheckBox Content="Enable activity logging"
                          IsChecked="{Binding EnableActivityLogging, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          Margin="0,0,0,10"
                          FontSize="14"
                          Foreground="{DynamicResource BusBuddy.Brush.Text.Primary}"
                          VerticalContentAlignment="Center"
                          AutomationProperties.Name="Enable activity logging"/>
                <CheckBox Content="Show dashboard on startup"
                          IsChecked="{Binding ShowDashboardOnStartup, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          Margin="0,0,0,20"
                          FontSize="14"
                          Foreground="{DynamicResource BusBuddy.Brush.Text.Primary}"
                          VerticalContentAlignment="Center"
                          AutomationProperties.Name="Show dashboard on startup"/>

                <TextBlock Text="This district (map &amp; routing)" Style="{StaticResource SettingsSectionHeader}"/>
                <TextBlock Text="Leave blank to ship this app to another rural district. Maps follow the first school with GPS, then the bus barn, then the bounding box. Unconfigured maps show a US overview until you add a school or pin the barn."
                           Style="{StaticResource SettingsHelpText}"/>

                <TextBlock x:Name="DepotNameLabel" Text="Bus barn name" Style="{StaticResource SettingsFieldLabel}"/>
                <syncfusion:SfTextBoxExt x:Name="DepotNameBox"
                                         Text="{Binding DepotName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Watermark="Transportation Office"
                                         Style="{StaticResource SettingsFieldInput}"
                                         AutomationProperties.Name="Bus barn name"
                                         AutomationProperties.LabeledBy="{Binding ElementName=DepotNameLabel}"/>
                <TextBlock x:Name="DepotAddressLabel" Text="Bus barn address" Style="{StaticResource SettingsFieldLabel}"/>
                <controls:PlacesAddressBox x:Name="DepotAddressBox"
                                           AddressText="{Binding DepotAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                           FieldAutomationName="Bus barn address"
                                           AddressApplied="DepotAddress_Applied"
                                           Margin="0,0,0,10"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="100"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="DepotCityLabel" Grid.Row="0" Grid.Column="0" Text="City" Style="{StaticResource SettingsFieldLabel}"/>
                    <TextBlock x:Name="DepotStateLabel" Grid.Row="0" Grid.Column="1" Text="State" Style="{StaticResource SettingsFieldLabel}" Margin="0,0,8,6"/>
                    <TextBlock x:Name="DepotZipLabel" Grid.Row="0" Grid.Column="2" Text="ZIP" Style="{StaticResource SettingsFieldLabel}"/>
                    <syncfusion:SfTextBoxExt x:Name="DepotCityBox" Grid.Row="1" Grid.Column="0" Margin="0,0,8,10"
                                             Text="{Binding DepotCity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Watermark="City"
                                             Height="40" Padding="8,5"
                                             AutomationProperties.Name="Bus barn city"
                                             AutomationProperties.LabeledBy="{Binding ElementName=DepotCityLabel}"/>
                    <syncfusion:SfTextBoxExt x:Name="DepotStateBox" Grid.Row="1" Grid.Column="1" Margin="0,0,8,10"
                                             Text="{Binding DepotState, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Watermark="ST"
                                             Height="40" Padding="8,5"
                                             AutomationProperties.Name="Bus barn state"
                                             AutomationProperties.LabeledBy="{Binding ElementName=DepotStateLabel}"/>
                    <syncfusion:SfTextBoxExt x:Name="DepotZipBox" Grid.Row="1" Grid.Column="2" Margin="0,0,0,10"
                                             Text="{Binding DepotZipCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Watermark="ZIP"
                                             Height="40" Padding="8,5"
                                             AutomationProperties.Name="Bus barn ZIP"
                                             AutomationProperties.LabeledBy="{Binding ElementName=DepotZipLabel}"/>
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="DepotLatLabel" Grid.Row="0" Grid.Column="0" Text="Latitude" Style="{StaticResource SettingsFieldLabel}"/>
                    <TextBlock x:Name="DepotLonLabel" Grid.Row="0" Grid.Column="1" Text="Longitude" Style="{StaticResource SettingsFieldLabel}"/>
                    <syncfusion:SfTextBoxExt x:Name="DepotLatBox" Grid.Row="1" Grid.Column="0" Margin="0,0,8,10"
                                             Text="{Binding DepotLatitudeText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Watermark="decimal degrees"
                                             Height="40" Padding="8,5"
                                             AutomationProperties.Name="Bus barn latitude"
                                             AutomationProperties.LabeledBy="{Binding ElementName=DepotLatLabel}"/>
                    <syncfusion:SfTextBoxExt x:Name="DepotLonBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,10"
                                             Text="{Binding DepotLongitudeText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Watermark="decimal degrees"
                                             Height="40" Padding="8,5"
                                             AutomationProperties.Name="Bus barn longitude"
                                             AutomationProperties.LabeledBy="{Binding ElementName=DepotLonLabel}"/>
                </Grid>
                <TextBlock Text="District boundary"
                           Style="{StaticResource SettingsSectionHeader}" Margin="0,8,0,8"/>
                <TextBlock Text="South, west, north, and east edges of this district. The map and route density use this rectangle. Leave it blank to ship the app to another district. Import a GeoJSON polygon to fill the edges from that file. The map does not draw the polygon."
                           Style="{StaticResource SettingsHelpText}"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <syncfusion:ButtonAdv Label="Import boundary file"
                                          Command="{Binding ImportBoundaryCommand}"
                                          Style="{StaticResource SettingsToolbarButton}"
                                          AutomationProperties.Name="Import district boundary file"/>
                    <syncfusion:ButtonAdv Label="Clear boundary"
                                          Command="{Binding ClearBoundaryCommand}"
                                          Style="{StaticResource SettingsToolbarButton}"
                                          AutomationProperties.Name="Clear district boundary"/>
                </StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="BBoxSouthLabel" Grid.Row="0" Grid.Column="0" Text="South" Style="{StaticResource SettingsFieldLabel}" Margin="0,0,6,6"/>
                    <TextBlock x:Name="BBoxWestLabel" Grid.Row="0" Grid.Column="1" Text="West" Style="{StaticResource SettingsFieldLabel}" Margin="0,0,6,6"/>
                    <TextBlock x:Name="BBoxNorthLabel" Grid.Row="0" Grid.Column="2" Text="North" Style="{StaticResource SettingsFieldLabel}" Margin="0,0,6,6"/>
                    <TextBlock x:Name="BBoxEastLabel" Grid.Row="0" Grid.Column="3" Text="East" Style="{StaticResource SettingsFieldLabel}"/>
                    <syncfusion:SfTextBoxExt x:Name="BBoxSouthBox" Grid.Row="1" Grid.Column="0" Margin="0,0,6,10"
                                             Text="{Binding BoundingBoxMinLatText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Watermark="South lat"
                                             Height="40" Padding="8,5"
                                             AutomationProperties.Name="District bounding box south latitude"
                                             AutomationProperties.LabeledBy="{Binding ElementName=BBoxSouthLabel}"/>
                    <syncfusion:SfTextBoxExt x:Name="BBoxWestBox" Grid.Row="1" Grid.Column="1" Margin="0,0,6,10"
                                             Text="{Binding BoundingBoxMinLonText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Watermark="West lon"
                                             Height="40" Padding="8,5"
                                             AutomationProperties.Name="District bounding box west longitude"
                                             AutomationProperties.LabeledBy="{Binding ElementName=BBoxWestLabel}"/>
                    <syncfusion:SfTextBoxExt x:Name="BBoxNorthBox" Grid.Row="1" Grid.Column="2" Margin="0,0,6,10"
                                             Text="{Binding BoundingBoxMaxLatText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Watermark="North lat"
                                             Height="40" Padding="8,5"
                                             AutomationProperties.Name="District bounding box north latitude"
                                             AutomationProperties.LabeledBy="{Binding ElementName=BBoxNorthLabel}"/>
                    <syncfusion:SfTextBoxExt x:Name="BBoxEastBox" Grid.Row="1" Grid.Column="3" Margin="0,0,0,10"
                                             Text="{Binding BoundingBoxMaxLonText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Watermark="East lon"
                                             Height="40" Padding="8,5"
                                             AutomationProperties.Name="District bounding box east longitude"
                                             AutomationProperties.LabeledBy="{Binding ElementName=BBoxEastLabel}"/>
                </Grid>

                <TextBlock Text="Google Maps" Style="{StaticResource SettingsSectionHeader}" Margin="0,16,0,8"/>
                <TextBlock Text="The Maps API key is not entered here. On Windows it is a user or machine environment variable; the Mac host loads it from Passwords. Address fields above use Places + Address Validation when the key is present."
                           Style="{StaticResource SettingsHelpText}"/>
                <TextBlock Style="{StaticResource SettingsHelpText}">
                    <Run Text="BusBuddy includes Google Maps features. Use of those features is subject to the"/>
                    <Hyperlink NavigateUri="https://maps.google.com/help/terms_maps/"
                               RequestNavigate="OnMapsLegalLinkNavigate">Google Maps End User Terms</Hyperlink>
                    <Run Text="and the"/>
                    <Hyperlink NavigateUri="https://policies.google.com/privacy"
                               RequestNavigate="OnMapsLegalLinkNavigate">Google Privacy Policy</Hyperlink>
                    <Run Text="."/>
                </TextBlock>

                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <syncfusion:ButtonAdv Label="Save"
                                          Command="{Binding SaveCommand}"
                                          Style="{StaticResource SettingsPrimaryButton}"
                                          AutomationProperties.Name="Save settings"/>
                    <syncfusion:ButtonAdv Label="Reset Defaults"
                                          Command="{Binding ResetCommand}"
                                          Style="{StaticResource SettingsToolbarButton}"
                                          AutomationProperties.Name="Reset settings"/>
                </StackPanel>

                <TextBlock Text="Processing..."
                           Margin="0,16,0,0"
                           Foreground="{DynamicResource BusBuddy.Brush.Text.Secondary}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
            </ScrollViewer>
        </Border>

        <Border Grid.Row="2" Background="{DynamicResource BusBuddy.Brush.Panel.Header}"
                CornerRadius="2" Padding="12,6" Margin="0,12,0,0">
            <TextBlock Text="{Binding StatusMessage}"
                       Foreground="{DynamicResource BusBuddy.Brush.Text.Secondary}"/>
        </Border>
    </Grid>
</UserControl>
