<UserControl x:Class="BusBuddy.WPF.Views.Settings.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
             xmlns:syncfusiontools="clr-namespace:Syncfusion.Windows.Tools.Controls;assembly=Syncfusion.Tools.WPF"
             Background="{DynamicResource ContentBackgroundBrush}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BusBuddy.WPF;component/Resources/SyncfusionV30_Validated_ResourceDictionary.xaml"/>
                <ResourceDictionary Source="/BusBuddy.WPF;component/Resources/ButtonAdvTextOnly.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="SettingsToolbarButton" TargetType="syncfusion:ButtonAdv">
                <Setter Property="SizeMode" Value="Normal"/>
                <Setter Property="IconWidth" Value="0"/>
                <Setter Property="IconHeight" Value="0"/>
                <Setter Property="SmallIcon" Value="{x:Null}"/>
                <Setter Property="Padding" Value="12,8"/>
                <Setter Property="Margin" Value="0,0,8,0"/>
                <Setter Property="FontWeight" Value="Medium"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundBrush}"/>
            </Style>

            <Style x:Key="SettingsPrimaryButton" TargetType="syncfusion:ButtonAdv" BasedOn="{StaticResource SettingsToolbarButton}">
                <Setter Property="Background" Value="{DynamicResource BusBuddy.Brush.Primary}"/>
                <Setter Property="Foreground" Value="{DynamicResource BusBuddy.Brush.Text.OnPrimary}"/>
            </Style>

            <Style x:Key="SettingsSectionHeader" TargetType="TextBlock">
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{DynamicResource BusBuddy.Brush.Text.Primary}"/>
                <Setter Property="Margin" Value="0,0,0,8"/>
            </Style>

            <Style x:Key="SettingsHelpText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Foreground" Value="{DynamicResource BusBuddy.Brush.Text.Secondary}"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="Margin" Value="0,0,0,12"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource BusBuddy.Brush.Primary}"
                CornerRadius="5" Padding="15" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="24"
                           Foreground="{DynamicResource BusBuddy.Brush.Text.OnPrimary}"
                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Text="Application Settings" FontSize="20" FontWeight="Bold"
                           Foreground="{DynamicResource BusBuddy.Brush.Text.OnPrimary}"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Background="{DynamicResource BusBuddy.Brush.Surface.Light}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="8" Padding="24">
            <StackPanel MaxWidth="560" HorizontalAlignment="Left">
                <TextBlock Text="Appearance" Style="{StaticResource SettingsSectionHeader}"/>
                <TextBlock Text="Choose the Fluent theme applied across BusBuddy windows."
                           Style="{StaticResource SettingsHelpText}"/>
                <TextBlock Text="Theme" FontWeight="Medium" Margin="0,0,0,6"
                           Foreground="{DynamicResource BusBuddy.Brush.Text.Primary}"/>
                <syncfusion:ComboBoxAdv ItemsSource="{Binding AvailableThemes}"
                                        SelectedItem="{Binding SelectedTheme, Mode=TwoWay}"
                                        IsEditable="False"
                                        Width="240"
                                        AutomationProperties.Name="Application theme"/>

                <TextBlock Text="Startup &amp; logging" Style="{StaticResource SettingsSectionHeader}" Margin="0,16,0,8"/>
                <TextBlock Text="Control whether the dashboard opens when the app starts and whether user actions are written to the activity log."
                           Style="{StaticResource SettingsHelpText}"/>

                <syncfusiontools:ToggleButtonExt Content="Enable activity logging"
                                                 IsChecked="{Binding EnableActivityLogging, Mode=TwoWay}"
                                                 Margin="0,0,0,10"
                                                 AutomationProperties.Name="Enable activity logging"/>
                <syncfusiontools:ToggleButtonExt Content="Show dashboard on startup"
                                                 IsChecked="{Binding ShowDashboardOnStartup, Mode=TwoWay}"
                                                 Margin="0,0,0,20"
                                                 AutomationProperties.Name="Show dashboard on startup"/>

                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <syncfusion:ButtonAdv Label="Save"
                                          Command="{Binding SaveCommand}"
                                          Style="{StaticResource SettingsPrimaryButton}"
                                          AutomationProperties.Name="Save settings"/>
                    <syncfusion:ButtonAdv Label="Reset Defaults"
                                          Command="{Binding ResetCommand}"
                                          Style="{StaticResource SettingsToolbarButton}"
                                          AutomationProperties.Name="Reset settings"/>
                </StackPanel>

                <TextBlock Text="Processing..."
                           Margin="0,16,0,0"
                           Foreground="{DynamicResource BusBuddy.Brush.Text.Secondary}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Background="{DynamicResource BusBuddy.Brush.Panel.Header}"
                CornerRadius="2" Padding="12,6" Margin="0,12,0,0">
            <TextBlock Text="{Binding StatusMessage}"
                       Foreground="{DynamicResource BusBuddy.Brush.Text.Secondary}"/>
        </Border>
    </Grid>
</UserControl>
